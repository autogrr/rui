package layouts

import (
	"fmt"

	"github.com/autogrr/rui/internal/ui/components/button"
	"github.com/autogrr/rui/internal/ui/components/separator"
	"github.com/autogrr/rui/internal/ui/components/tooltip"
)

// NavItem describes a single sidebar navigation entry.
type NavItem struct {
	ID    string
	Title string
	Href  string
	Icon  string // lucide icon name, rendered via SVG inline
}

// Instance is a minimal view of a qBittorrent instance for the header selector.
type Instance struct {
	ID       int
	Name     string
	IsActive bool
}

// AuthProps are passed to every authenticated page render.
type AuthProps struct {
	BaseURL         string
	Title           string
	CurrentPath     string
	Username        string
	Instances       []Instance
	ActiveInstance  *Instance
	AppVersion      string
}

// defaultNavItems defines the sidebar navigation order and labels.
var defaultNavItems = []NavItem{
	{ID: "dashboard", Title: "Dashboard", Href: "/ui/dashboard", Icon: "house"},
	{ID: "search", Title: "Search", Href: "/ui/search", Icon: "search"},
	{ID: "cross-seed", Title: "Cross-seed", Href: "/ui/cross-seed", Icon: "git-branch"},
	{ID: "dir-scan", Title: "Dir Scan", Href: "/ui/dir-scan", Icon: "folder-search"},
	{ID: "automations", Title: "Automations", Href: "/ui/automations", Icon: "zap"},
	{ID: "backups", Title: "Backups", Href: "/ui/backups", Icon: "archive"},
	{ID: "rss", Title: "RSS", Href: "/ui/rss", Icon: "rss"},
	{ID: "settings", Title: "Settings", Href: "/ui/settings", Icon: "settings"},
}

// Authenticated wraps every protected page with the sidebar + header app shell.
templ Authenticated(p AuthProps) {
	@Base(BaseProps{Title: p.Title, BaseURL: p.BaseURL}) {
		<div
			class="flex h-screen overflow-hidden bg-background"
			x-data="{
				sidebarOpen: localStorage.getItem('qui_sidebar') !== 'false',
				toggleSidebar() {
					this.sidebarOpen = !this.sidebarOpen;
					localStorage.setItem('qui_sidebar', this.sidebarOpen);
				}
			}"
		>
			<!-- =========================================================
			     Sidebar
			     ========================================================= -->
			<aside
				class="hidden md:flex flex-col bg-sidebar border-r border-sidebar-border
				       transition-all duration-200 ease-in-out shrink-0"
				:class="sidebarOpen ? 'w-56' : 'w-14'"
			>
				<!-- Sidebar header: logo + toggle -->
				<div class="flex items-center px-3 py-4 h-14 shrink-0 border-b border-sidebar-border">
					<a href={ templ.SafeURL(p.BaseURL + "/ui/dashboard") } class="flex items-center gap-2.5 min-w-0">
						<!-- App icon / logo (SVG inline) -->
						<svg
							class="shrink-0 h-7 w-7 text-sidebar-primary"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
							<polyline points="7 10 12 15 17 10"/>
							<line x1="12" x2="12" y1="15" y2="3"/>
						</svg>
						<span
							class="font-semibold text-sidebar-foreground text-sm truncate"
							x-show="sidebarOpen"
							x-transition:enter="transition-opacity duration-150"
							x-transition:enter-start="opacity-0"
							x-transition:enter-end="opacity-100"
						>
							qui
						</span>
					</a>
				</div>
				<!-- Nav items -->
				<nav class="flex-1 overflow-y-auto overflow-x-hidden py-3 px-2 space-y-0.5">
					for _, item := range defaultNavItems {
						@sidebarNavItem(item, p.CurrentPath, p.ActiveInstance)
					}
				</nav>
				@separator.Separator(separator.Props{Class: "mx-2"})
				<!-- Bottom: version + collapse toggle -->
				<div class="px-2 py-3 space-y-0.5">
					<!-- Instances nav item (always goes to management page) -->
					@sidebarNavItem(NavItem{
						ID:    "instances",
						Title: "Instances",
						Href:  "/ui/instances",
						Icon:  "server",
					}, p.CurrentPath, p.ActiveInstance)
					<!-- Sidebar collapse toggle button (desktop only) -->
					<div class="mt-1">
						@button.Button(button.Props{
							Variant:    button.VariantGhost,
							Size:       button.SizeIcon,
							Attributes: templ.Attributes{"@click": "toggleSidebar()", "title": "Toggle sidebar"},
							Class:      "w-full flex justify-start text-sidebar-foreground/60 hover:text-sidebar-foreground hover:bg-sidebar-accent",
						}) {
							<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<rect width="18" height="18" x="3" y="3" rx="2"/>
								<path d="M9 3v18"/>
							</svg>
							<span class="ml-2 text-xs truncate" x-show="sidebarOpen">Collapse</span>
						}
					</div>
				</div>
			</aside>
			<!-- =========================================================
			     Main area (header + page content)
			     ========================================================= -->
			<div class="flex flex-col flex-1 min-w-0 overflow-hidden">
				<!-- Header -->
				<header class="h-14 flex items-center gap-2 px-3 border-b border-border bg-background shrink-0">
					<!-- Mobile: hamburger menu -->
					<button
						class="md:hidden p-1.5 rounded-md text-muted-foreground hover:bg-accent hover:text-accent-foreground"
						x-data="{}"
						@click="$dispatch('toggle-mobile-menu')"
						aria-label="Open menu"
					>
						<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<line x1="4" x2="20" y1="6" y2="6"/>
							<line x1="4" x2="20" y1="12" y2="12"/>
							<line x1="4" x2="20" y1="18" y2="18"/>
						</svg>
					</button>
					<!-- Instance selector -->
					<div class="flex-1 min-w-0">
						@instanceSelector(p.Instances, p.ActiveInstance, p.BaseURL)
					</div>
					<!-- Right side: theme toggle + user menu -->
					<div class="flex items-center gap-1 shrink-0">
						@themeToggle()
						@userMenu(p.Username, p.BaseURL)
					</div>
				</header>
				<!-- Page content -->
				<main class="flex-1 overflow-auto">
					{ children... }
				</main>
				<!-- Mobile bottom nav -->
				<nav class="md:hidden shrink-0 border-t border-border bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
					<div class="flex items-center justify-around h-14 px-2">
						for _, item := range []NavItem{
							{ID: "dashboard", Title: "Home", Href: "/ui/dashboard", Icon: "house"},
							{ID: "search", Title: "Search", Href: "/ui/search", Icon: "search"},
							{ID: "instances", Title: "Instances", Href: "/ui/instances", Icon: "server"},
							{ID: "settings", Title: "Settings", Href: "/ui/settings", Icon: "settings"},
						} {
							<a
								href={ templ.SafeURL(p.BaseURL + item.Href) }
								class={
									"flex flex-col items-center gap-0.5 px-3 py-2 text-xs font-medium rounded-md transition-colors",
									templ.KV("text-primary", p.CurrentPath == item.Href),
									templ.KV("text-muted-foreground hover:text-foreground", p.CurrentPath != item.Href),
								}
							>
								@inlineSVGIcon(item.Icon, "h-5 w-5")
								{ item.Title }
							</a>
						}
					</div>
				</nav>
			</div>
		</div>
	}
}

// sidebarNavItem renders a single sidebar navigation link.
templ sidebarNavItem(item NavItem, currentPath string, activeInstance *Instance) {
	{{ isActive := currentPath == item.Href }}
	@tooltip.Tooltip() {
		@tooltip.Trigger(tooltip.TriggerProps{}) {
			<a
				href={ templ.SafeURL(item.Href) }
				class={
					"flex items-center gap-2.5 px-2 py-2 rounded-md text-sm font-medium transition-colors w-full group",
					templ.KV("bg-sidebar-accent text-sidebar-accent-foreground", isActive),
					templ.KV("text-sidebar-foreground hover:bg-sidebar-accent/60 hover:text-sidebar-accent-foreground", !isActive),
				}
			>
				@inlineSVGIcon(item.Icon, "h-4 w-4 shrink-0")
				<span
					class="truncate"
					x-show="sidebarOpen"
					x-transition:enter="transition-opacity duration-150"
					x-transition:enter-start="opacity-0"
					x-transition:enter-end="opacity-100"
					x-cloak
				>
					{ item.Title }
				</span>
			</a>
		}
		@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionRight}) {
			{ item.Title }
		}
	}
}

// instanceSelector renders the instance dropdown in the header.
templ instanceSelector(instances []Instance, active *Instance, baseURL string) {
	if len(instances) == 0 {
		<span class="text-sm text-muted-foreground">No instances</span>
	} else {
		<div class="relative" x-data="{ open: false }" @click.outside="open = false">
			<button
				@click="open = !open"
				class="flex items-center gap-1.5 text-sm font-medium max-w-xs truncate hover:text-primary transition-colors"
			>
				if active != nil {
					<span class="truncate">{ active.Name }</span>
				} else {
					<span class="text-muted-foreground">Select instance</span>
				}
				<svg class="h-3.5 w-3.5 text-muted-foreground shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
					<path d="m6 9 6 6 6-6"/>
				</svg>
			</button>
			<div
				x-show="open"
				x-cloak
				class="absolute top-full left-0 mt-1 w-56 bg-popover border border-border rounded-md shadow-md z-50 py-1"
			>
				<!-- All instances option -->
				<a
					href={ templ.SafeURL(baseURL + "/ui/torrents") }
					class="flex items-center px-3 py-1.5 text-sm text-foreground hover:bg-accent hover:text-accent-foreground"
				>
					All instances
				</a>
				<div class="my-1 h-px bg-border mx-1"></div>
				for _, inst := range instances {
					<a
						href={ templ.SafeURL(baseURL + "/ui/torrents?instance_id=" + itoa(inst.ID)) }
						class={
							"flex items-center gap-2 px-3 py-1.5 text-sm",
							templ.KV("text-primary font-medium", active != nil && active.ID == inst.ID),
							templ.KV("text-foreground hover:bg-accent hover:text-accent-foreground", active == nil || active.ID != inst.ID),
						}
					>
						<span
							class={
								"h-2 w-2 rounded-full shrink-0",
								templ.KV("bg-green-500", inst.IsActive),
								templ.KV("bg-muted-foreground", !inst.IsActive),
							}
						></span>
						<span class="truncate">{ inst.Name }</span>
					</a>
				}
			</div>
		</div>
	}
}

// themeToggle renders a light/dark/system theme switcher button.
templ themeToggle() {
	<button
		x-data="{
			theme: localStorage.getItem('qui_theme') || 'system',
			cycle() {
				const order = ['light', 'dark', 'system'];
				const idx = order.indexOf(this.theme);
				this.theme = order[(idx + 1) % order.length];
				localStorage.setItem('qui_theme', this.theme);
				if (this.theme === 'dark') {
					document.documentElement.classList.add('dark');
				} else if (this.theme === 'light') {
					document.documentElement.classList.remove('dark');
				} else {
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
				}
			}
		}"
		@click="cycle()"
		class="p-1.5 rounded-md text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
		:title="'Theme: ' + theme"
	>
		<!-- Sun icon (light mode) -->
		<svg x-show="theme === 'light'" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
			<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
		</svg>
		<!-- Moon icon (dark mode) -->
		<svg x-show="theme === 'dark'" x-cloak class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
			<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
		</svg>
		<!-- Monitor icon (system) -->
		<svg x-show="theme === 'system'" x-cloak class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
			<rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8M12 17v4"/>
		</svg>
	</button>
}

// userMenu renders the user dropdown (profile, logout).
templ userMenu(username, baseURL string) {
	<div class="relative" x-data="{ open: false }" @click.outside="open = false">
		<button
			@click="open = !open"
			class="flex items-center gap-1.5 p-1.5 rounded-md text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors text-sm"
		>
			<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/>
			</svg>
			<span class="hidden sm:block max-w-24 truncate">{ username }</span>
		</button>
		<div
			x-show="open"
			x-cloak
			class="absolute top-full right-0 mt-1 w-44 bg-popover border border-border rounded-md shadow-md z-50 py-1"
		>
			<div class="px-3 py-2 border-b border-border">
				<p class="text-xs text-muted-foreground">Signed in as</p>
				<p class="text-sm font-medium truncate">{ username }</p>
			</div>
			<form method="POST" action={ templ.SafeURL(baseURL + "/ui/auth/logout") }>
				<button
					type="submit"
					class="w-full flex items-center gap-2 px-3 py-1.5 text-sm text-destructive hover:bg-destructive/10 transition-colors"
				>
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/>
					</svg>
					Log out
				</button>
			</form>
		</div>
	</div>
}

// inlineSVGIcon renders a minimal inline SVG icon by name.
// Only the icons used in navigation are supported; add more as needed.
templ inlineSVGIcon(name string, class string) {
	switch name {
	case "house":
		<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
		</svg>
	case "search":
		<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
		</svg>
	case "git-branch":
		<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<line x1="6" x2="6" y1="3" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>
		</svg>
	case "zap":
		<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>
		</svg>
	case "archive":
		<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/>
		</svg>
	case "rss":
		<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>
		</svg>
	case "settings":
		<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/>
		</svg>
	case "server":
		<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6" y1="6" y2="6"/><line x1="6" x2="6" y1="18" y2="18"/>
		</svg>
	default:
		<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
			<circle cx="12" cy="12" r="5"/>
		</svg>
	}
}

// itoa converts an int to a string (helper for templating).
func itoa(n int) string {
	return fmt.Sprintf("%d", n)
}

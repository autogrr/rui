package pages

import (
	"fmt"
	"strconv"
	"time"

	"github.com/autogrr/rui/internal/ui/components/badge"
	"github.com/autogrr/rui/internal/ui/components/button"
	"github.com/autogrr/rui/internal/ui/components/card"
	"github.com/autogrr/rui/internal/ui/components/dialog"
	"github.com/autogrr/rui/internal/ui/layouts"
)

// InstanceListItem holds the view data for a single instance row.
type InstanceListItem struct {
	ID                       int
	Name                     string
	Host                     string
	Username                 string
	BasicUsername            string // empty when not set
	TLSSkipVerify            bool
	HasLocalFilesystemAccess bool
	IsActive                 bool
	IsConnected              bool
	ConnectionStatus         string // "connected", "disconnected", "disabled", ""
	HasBasicAuth             bool
	CreatedAt                time.Time
	// Hardlink / Reflink mode
	UseHardlinks          bool
	UseReflinks           bool
	HardlinkBaseDir       string
	HardlinkDirPreset     string // "flat", "by-tracker", "by-instance"
	FallbackToRegularMode bool
}

// InstancesPageProps holds data for the instances page.
type InstancesPageProps struct {
	BaseURL   string
	Username  string
	Version   string
	Instances []InstanceListItem
	NavInsts  []layouts.Instance
}

// Instances renders the main instances management page.
templ Instances(p InstancesPageProps) {
	@layouts.Authenticated(layouts.AuthProps{
		BaseURL:     p.BaseURL,
		Title:       "Instances",
		CurrentPath: "/ui/instances",
		Username:    p.Username,
		AppVersion:  p.Version,
		Instances:   p.NavInsts,
	}) {
		<div class="space-y-6">
			<!-- Page header -->
			<div class="flex items-center justify-between gap-4">
				<div>
					<h1 class="text-2xl font-bold tracking-tight">Instances</h1>
					<p class="text-sm text-muted-foreground mt-1">Manage your qBittorrent connections.</p>
				</div>
				<button
					type="button"
					class="inline-flex items-center gap-1.5 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
					onclick="window.tui.dialog.open('instance-dialog')"
					hx-get={ p.BaseURL + "/ui/partials/instances/form" }
					hx-target="#instance-form-slot"
					hx-swap="innerHTML"
					hx-push-url="false"
				>
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
					Add Instance
				</button>
			</div>

			<!-- Dialog: add/edit form (populated via HTMX, opened programmatically) -->
			@dialog.Dialog(dialog.Props{ID: "instance-dialog"}) {
				@dialog.Content(dialog.ContentProps{
					Class:           "sm:max-w-2xl overflow-y-auto max-h-[90vh]",
					HideCloseButton: true,
				}) {
					<div id="instance-form-slot"></div>
				}
			}

			<!-- Instance list -->
			<div id="instance-list">
				@InstanceListPartial(p.Instances, p.BaseURL)
			</div>
		</div>
	}
}

// InstanceListPartial renders just the list of instance cards (for HTMX OOB swaps).
templ InstanceListPartial(instances []InstanceListItem, baseURL string) {
	if len(instances) == 0 {
		<div class="flex flex-col items-center justify-center py-16 text-center gap-4">
			<svg class="h-12 w-12 text-muted-foreground/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
				<rect x="2" y="3" width="20" height="14" rx="2"/>
				<path d="M8 21h8M12 17v4"/>
			</svg>
			<div>
				<p class="font-semibold">No instances yet</p>
				<p class="text-sm text-muted-foreground mt-1">Click "Add Instance" to connect your first qBittorrent server.</p>
			</div>
		</div>
	} else {
		<div class="space-y-3">
			for _, inst := range instances {
				@InstanceRowCard(inst, baseURL)
			}
		</div>
	}
}

// InstanceRowCard renders a single instance row card (used standalone for OOB swaps).
templ InstanceRowCard(inst InstanceListItem, baseURL string) {
	<div id={ "instance-" + strconv.Itoa(inst.ID) } class="instance-row">
		@card.Card(card.Props{Class: "overflow-hidden"}) {
			@card.Content(card.ContentProps{Class: "p-4"}) {
				<div class="flex items-start justify-between gap-4">
					<div class="min-w-0 flex-1">
						<div class="flex items-center gap-2 flex-wrap">
							<span class="font-semibold truncate">{ inst.Name }</span>
							<!-- Status: disabled instances are known immediately; active ones lazy-load -->
							if !inst.IsActive {
								@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) { Disabled }
							} else {
								<div
									id={ "inst-status-" + strconv.Itoa(inst.ID) }
									hx-get={ baseURL + "/ui/partials/instances/" + strconv.Itoa(inst.ID) + "/status" }
									hx-trigger="load"
									hx-swap="outerHTML"
									class="flex items-center gap-1"
								>
									<svg class="h-3 w-3 animate-spin text-muted-foreground/40" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
								</div>
							}
						</div>
						<p class="text-sm text-muted-foreground mt-0.5 truncate">{ inst.Host }</p>
						if inst.Username != "" {
							<p class="text-xs text-muted-foreground/70">User: { inst.Username }</p>
						}
						<div class="flex items-center gap-1.5 mt-1.5 flex-wrap">
							if inst.UseHardlinks {
								@badge.Badge(badge.Props{Variant: badge.VariantOutline}) { Hardlink }
							} else if inst.UseReflinks {
								@badge.Badge(badge.Props{Variant: badge.VariantOutline}) { Reflink }
							}
							if inst.TLSSkipVerify {
								<span class="text-xs text-muted-foreground/50 bg-muted px-1 rounded">TLS skip</span>
							}
							if !inst.CreatedAt.IsZero() {
								<span class="text-xs text-muted-foreground/40">&bull; Added { instanceCreatedAt(inst.CreatedAt) }</span>
							}
						</div>
					</div>
					<!-- Actions -->
					<div class="flex items-center gap-2 shrink-0">
						<!-- Enable/Disable toggle -->
						<button
							class={ "relative inline-flex h-5 w-9 cursor-pointer items-center rounded-full border-2 border-transparent transition-colors",
								templ.KV("bg-primary", inst.IsActive),
								templ.KV("bg-input", !inst.IsActive) }
							hx-post={ baseURL + "/ui/instances/" + strconv.Itoa(inst.ID) + "/toggle" }
							hx-target={ "#instance-" + strconv.Itoa(inst.ID) }
							hx-swap="outerHTML"
							title={ instanceToggleTitle(inst) }
						>
							<span
								class={ "pointer-events-none block h-4 w-4 rounded-full bg-background shadow-sm ring-0 transition-transform",
									templ.KV("translate-x-4", inst.IsActive),
									templ.KV("translate-x-0", !inst.IsActive) }
							></span>
						</button>
						<!-- Edit button -->
						<button
							type="button"
							class="inline-flex items-center gap-1 rounded-md border border-input bg-background px-3 py-1.5 text-xs font-medium hover:bg-accent hover:text-accent-foreground transition-colors"
						onclick="window.tui.dialog.open('instance-dialog')"
						hx-get={ baseURL + "/ui/partials/instances/form/" + strconv.Itoa(inst.ID) }
						hx-target="#instance-form-slot"
						hx-swap="innerHTML"
						hx-push-url="false"
						>
							<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
							Edit
						</button>
						<!-- Test button -->
						<button
							type="button"
							class="inline-flex items-center gap-1 rounded-md border border-input bg-background px-3 py-1.5 text-xs font-medium hover:bg-accent hover:text-accent-foreground transition-colors"
							hx-post={ baseURL + "/ui/instances/" + strconv.Itoa(inst.ID) + "/test" }
							hx-target={ "#instance-test-" + strconv.Itoa(inst.ID) }
							hx-swap="innerHTML"
						>
							<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
							<span>Test</span>
							<svg class="htmx-indicator h-3 w-3 animate-spin" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
						</button>
						<!-- Delete button -->
						<button
							type="button"
							class="inline-flex items-center gap-1 rounded-md border border-input bg-background px-3 py-1.5 text-xs font-medium text-destructive hover:bg-destructive/10 transition-colors"
							hx-delete={ baseURL + "/ui/instances/" + strconv.Itoa(inst.ID) }
							hx-target={ "#instance-" + strconv.Itoa(inst.ID) }
							hx-swap="outerHTML"
							hx-confirm={ "Delete instance \"" + inst.Name + "\"? This cannot be undone." }
						>
							<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
							Delete
						</button>
					</div>
				</div>
				<!-- Test result area for inline test feedback -->
				<div id={ "instance-test-" + strconv.Itoa(inst.ID) } class="mt-2 empty:hidden"></div>
			}
		}
	</div>
}

// InstanceStatusPartial renders the lazy-loaded status badge that swaps into the card.
// It is the response for GET /ui/partials/instances/{id}/status.
templ InstanceStatusPartial(inst InstanceListItem) {
	<div id={ "inst-status-" + strconv.Itoa(inst.ID) } class="flex items-center gap-1.5">
		<div class={ "h-2 w-2 shrink-0 rounded-full", instanceStatusDotClass(inst) }></div>
		if inst.IsConnected {
			@badge.Badge(badge.Props{Variant: badge.VariantDefault}) { Connected }
		} else {
			@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) { Offline }
		}
	</div>
}

// instanceStatusDotClass returns dot color for an instance.
func instanceStatusDotClass(inst InstanceListItem) string {
	if !inst.IsActive {
		return "bg-muted-foreground/40"
	}
	if inst.IsConnected {
		return "bg-green-500"
	}
	return "bg-red-500"
}

// instanceToggleTitle returns the tooltip for the enable/disable toggle.
func instanceToggleTitle(inst InstanceListItem) string {
	if inst.IsActive {
		return "Disable instance"
	}
	return "Enable instance"
}

// InstanceFormNew renders the add-new-instance inline form.
templ InstanceFormNew(baseURL, errMsg string) {
	@instanceFormCard(instanceFormCardData{BaseURL: baseURL, ErrMsg: errMsg})
}

// InstanceFormEdit renders the edit-instance inline form pre-populated with instance data.
templ InstanceFormEdit(inst InstanceListItem, baseURL, errMsg string) {
	@instanceFormCard(instanceFormCardData{
		ID:                    inst.ID,
		Name:                  inst.Name,
		Host:                  inst.Host,
		Username:              inst.Username,
		HasBasicAuth:          inst.HasBasicAuth,
		AuthBypass:            inst.Username == "",
		TLSSkipVerify:         inst.TLSSkipVerify,
		LocalFS:               inst.HasLocalFilesystemAccess,
		UseHardlinks:          inst.UseHardlinks,
		UseReflinks:           inst.UseReflinks,
		HardlinkBaseDir:       inst.HardlinkBaseDir,
		HardlinkDirPreset:     inst.HardlinkDirPreset,
		FallbackToRegularMode: inst.FallbackToRegularMode,
		BaseURL:               baseURL,
		ErrMsg:                errMsg,
	})
}

// instanceFormCardData holds all data for the shared instance form.
type instanceFormCardData struct {
	ID                    int
	Name                  string
	Host                  string
	Username              string
	HasBasicAuth          bool
	AuthBypass            bool
	TLSSkipVerify         bool
	LocalFS               bool
	UseHardlinks          bool
	UseReflinks           bool
	HardlinkBaseDir       string
	HardlinkDirPreset     string
	FallbackToRegularMode bool
	BaseURL               string
	ErrMsg                string
}

// instanceFormCard renders the shared add/edit form card.
templ instanceFormCard(d instanceFormCardData) {
	{{ id := d.ID }}
	{{ name := d.Name }}
	{{ host := d.Host; if host == "" { host = "http://localhost:8080" } }}
	{{ username := d.Username }}
	{{ hasBasicAuth := d.HasBasicAuth }}
	{{ authBypass := d.AuthBypass }}
	{{ tlsSkipVerify := d.TLSSkipVerify }}
	{{ localFS := d.LocalFS }}
	{{ baseURL := d.BaseURL }}
	{{ errMsg := d.ErrMsg }}
	{{ isEdit := id != 0 }}
	{{ formTitle := "Add Instance" }}
	if isEdit {
		{{ formTitle = "Edit Instance" }}
	}
	{{ action := baseURL + "/ui/instances" }}
	if isEdit {
		{{ action = fmt.Sprintf("%s/ui/instances/%d", baseURL, id) }}
	}
	<!-- Dialog-native layout; no card wrapper — the dialog provides the container -->
	<div class="flex flex-col gap-4">
		<!-- Header -->
		<div class="flex items-start justify-between gap-4">
			<div>
				<h2 class="text-lg font-semibold leading-none tracking-tight">{ formTitle }</h2>
				<p class="text-sm text-muted-foreground mt-1">
					if isEdit {
						Update connection details for this qBittorrent instance.
					} else {
						Connect a qBittorrent server to manage torrents.
					}
				</p>
			</div>
			<button
				type="button"
				data-tui-dialog-close="instance-dialog"
				class="rounded-sm opacity-70 hover:opacity-100 transition-opacity mt-0.5 shrink-0"
				aria-label="Close"
			>
				<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
			</button>
		</div>
		if errMsg != "" {
			<div class="rounded-md bg-destructive/10 border border-destructive/20 px-3 py-2.5">
				<p class="text-sm text-destructive">{ errMsg }</p>
			</div>
		}
		<form
			id="instance-form"
			if isEdit {
				hx-put={ action }
			} else {
				hx-post={ action }
			}
			hx-target="#instance-form-slot"
			hx-swap="innerHTML"
			x-data={ instanceFormAlpineData(authBypass, hasBasicAuth, localFS, d.UseHardlinks, d.UseReflinks) }
			class="space-y-4"
		>
			<p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground/60 pb-1">Connection</p>

				<!-- Name -->
				<div class="space-y-1.5">
					<label class="text-sm font-medium" for="inst-name">Instance Name</label>
					<input
						id="inst-name"
						name="name"
						type="text"
						required
						value={ name }
						placeholder="e.g., Home Server"
						autocomplete="off"
						class="flex h-9 w-full rounded-md border border-input bg-background px-3 py-1 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
					/>
				</div>

				<!-- Host -->
				<div class="space-y-1.5">
					<label class="text-sm font-medium" for="inst-host">URL</label>
					<input
						id="inst-host"
						name="host"
						type="url"
						required
						value={ host }
						placeholder="http://localhost:8080"
						autocomplete="off"
						class="flex h-9 w-full rounded-md border border-input bg-background px-3 py-1 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
					/>
				</div>

				<!-- TLS Skip Verify toggle -->
				<div class="flex items-start justify-between gap-4 rounded-lg border bg-muted/40 p-4">
					<div class="space-y-1">
						<label class="text-sm font-medium">Skip TLS Certificate Verification</label>
						<p class="text-xs text-muted-foreground">Allow connections to instances with self-signed certificates.</p>
					</div>
					<label class="inline-flex cursor-pointer items-center gap-2">
						<input
							type="checkbox"
							name="tls_skip_verify"
							value="on"
							checked?={ tlsSkipVerify }
							class="peer hidden"
							role="switch"
						/>
						<div class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer items-center rounded-full border-2 border-transparent transition-colors bg-input peer-checked:bg-primary">
							<span class="pointer-events-none block h-4 w-4 translate-x-0 rounded-full bg-background shadow-sm ring-0 transition-transform peer-checked:translate-x-4"></span>
						</div>
					</label>
				</div>

				<!-- ── Authentication ────────────────────────────── -->
				<div class="flex items-center gap-3 pt-2">
					<div class="flex-1 border-t border-border"></div>
					<p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground/60">Authentication</p>
					<div class="flex-1 border-t border-border"></div>
				</div>

				<!-- Auth Bypass toggle -->
				<div class="flex items-start justify-between gap-4 rounded-lg border bg-muted/40 p-4">
					<div class="space-y-1">
						<label class="text-sm font-medium">Authentication Bypass</label>
						<p class="text-xs text-muted-foreground">Enable when qBittorrent bypasses authentication for localhost or whitelisted IPs.</p>
					</div>
					<label class="inline-flex cursor-pointer items-center gap-2">
						<input
							type="checkbox"
							name="auth_bypass"
							value="on"
							checked?={ authBypass }
							x-model="authBypass"
							class="peer hidden"
							role="switch"
						/>
						<div
							class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer items-center rounded-full border-2 border-transparent transition-colors"
							:class="authBypass ? 'bg-primary' : 'bg-input'"
						>
							<span
								class="pointer-events-none block h-4 w-4 rounded-full bg-background shadow-sm ring-0 transition-transform"
								:class="authBypass ? 'translate-x-4' : 'translate-x-0'"
							></span>
						</div>
					</label>
				</div>

				<!-- Username + Password (hidden when auth bypass) -->
				<div x-show="!authBypass" x-transition class="space-y-4">
					<div class="space-y-1.5">
						<label class="text-sm font-medium" for="inst-username">Username</label>
						<input
							id="inst-username"
							name="username"
							type="text"
							value={ username }
							placeholder="qBittorrent username (usually admin)"
							autocomplete="off"
							data-1p-ignore
							class="flex h-9 w-full rounded-md border border-input bg-background px-3 py-1 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
						/>
					</div>
					<div class="space-y-1.5">
						<label class="text-sm font-medium" for="inst-password">Password</label>
						<input
							id="inst-password"
							name="password"
							type="password"
							placeholder={ instancePasswordPlaceholder(id != 0) }
							autocomplete="new-password"
							data-1p-ignore
							class="flex h-9 w-full rounded-md border border-input bg-background px-3 py-1 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
						/>
					</div>
				</div>

				<!-- Basic Auth toggle -->
				<div class="flex items-start justify-between gap-4 rounded-lg border bg-muted/40 p-4">
					<div class="space-y-1">
						<label class="text-sm font-medium">HTTP Basic Authentication</label>
						<p class="text-xs text-muted-foreground">Enable if your qBittorrent is behind a reverse proxy with Basic Auth.</p>
					</div>
					<label class="inline-flex cursor-pointer items-center gap-2">
						<input
							type="checkbox"
							name="show_basic_auth"
							value="on"
							checked?={ hasBasicAuth }
							x-model="showBasicAuth"
							class="peer hidden"
							role="switch"
						/>
						<div
							class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer items-center rounded-full border-2 border-transparent transition-colors"
							:class="showBasicAuth ? 'bg-primary' : 'bg-input'"
						>
							<span
								class="pointer-events-none block h-4 w-4 rounded-full bg-background shadow-sm ring-0 transition-transform"
								:class="showBasicAuth ? 'translate-x-4' : 'translate-x-0'"
							></span>
						</div>
					</label>
				</div>

				<!-- Basic Auth fields (shown when basic auth enabled) -->
				<div x-show="showBasicAuth" x-transition class="space-y-4 pl-4 border-l-2 border-muted">
					<div class="space-y-1.5">
						<label class="text-sm font-medium" for="inst-basic-user">Basic Auth Username</label>
						<input
							id="inst-basic-user"
							name="basic_username"
							type="text"
							placeholder="Basic auth username"
							autocomplete="off"
							data-1p-ignore
							class="flex h-9 w-full rounded-md border border-input bg-background px-3 py-1 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
						/>
					</div>
					<div class="space-y-1.5">
						<label class="text-sm font-medium" for="inst-basic-pass">Basic Auth Password</label>
						<input
							id="inst-basic-pass"
							name="basic_password"
							type="password"
							placeholder="Basic auth password"
							autocomplete="new-password"
							data-1p-ignore
							class="flex h-9 w-full rounded-md border border-input bg-background px-3 py-1 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
						/>
					</div>
				</div>

				<!-- ── File System ────────────────────────────────── -->
				<div class="flex items-center gap-3 pt-2">
					<div class="flex-1 border-t border-border"></div>
					<p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground/60">File System</p>
					<div class="flex-1 border-t border-border"></div>
				</div>

				<!-- Local Filesystem Access toggle -->
				<div class="flex items-start justify-between gap-4 rounded-lg border bg-muted/40 p-4">
					<div class="space-y-1">
						<label class="text-sm font-medium">Local Filesystem Access</label>
						<p class="text-xs text-muted-foreground">Enable if rui can access this instance's download paths (required for hardlink detection in automations).</p>
					</div>
					<label class="inline-flex cursor-pointer items-center gap-2">
						<input
							type="checkbox"
							name="has_local_filesystem_access"
							value="on"
							checked?={ localFS }
							x-model="localFS"
							class="peer hidden"
							role="switch"
						/>
						<div
							class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer items-center rounded-full border-2 border-transparent transition-colors"
							:class="localFS ? 'bg-primary' : 'bg-input'"
						>
							<span
								class="pointer-events-none block h-4 w-4 rounded-full bg-background shadow-sm ring-0 transition-transform"
								:class="localFS ? 'translate-x-4' : 'translate-x-0'"
							></span>
						</div>
					</label>
				</div>

				<!-- Hardlink / Reflink Mode (shown when local filesystem access is enabled) -->
				<div x-show="localFS" x-transition class="space-y-3 pl-4 border-l-2 border-muted">
					<div class="space-y-0.5">
						<p class="text-sm font-medium">Cross-seed File Mode</p>
						<p class="text-xs text-muted-foreground">Configure how cross-seeded files are created. Hardlink and reflink modes require the base directory to be on the same filesystem as the instance's download paths.</p>
					</div>
					<!-- Mode radio group -->
					<div class="space-y-2">
						<label class="flex items-center gap-3 cursor-pointer">
							<input
								type="radio"
								name="hardlink_mode"
								value="regular"
								checked?={ !d.UseHardlinks && !d.UseReflinks }
								x-model="hardlinkMode"
								class="h-4 w-4 text-primary border-input"
							/>
							<span class="text-sm">Regular — download files normally</span>
						</label>
						<label class="flex items-center gap-3 cursor-pointer">
							<input
								type="radio"
								name="hardlink_mode"
								value="hardlink"
								checked?={ d.UseHardlinks }
								x-model="hardlinkMode"
								class="h-4 w-4 text-primary border-input"
							/>
							<span class="text-sm">Hardlink — create hardlinked file tree</span>
						</label>
						<label class="flex items-center gap-3 cursor-pointer">
							<input
								type="radio"
								name="hardlink_mode"
								value="reflink"
								checked?={ d.UseReflinks }
								x-model="hardlinkMode"
								class="h-4 w-4 text-primary border-input"
							/>
							<span class="text-sm">Reflink (copy-on-write) — for cross-seeds with extra/missing files</span>
						</label>
					</div>
					<!-- Base directory + preset (shown when hardlink or reflink mode) -->
					<div x-show="hardlinkMode !== 'regular'" x-transition class="space-y-3">
						<div class="space-y-1.5">
							<label class="text-sm font-medium" for="inst-hardlink-base">Base Directory</label>
							<input
								id="inst-hardlink-base"
								name="hardlink_base_dir"
								type="text"
								value={ d.HardlinkBaseDir }
								placeholder="/data/torrents"
								autocomplete="off"
								class="flex h-9 w-full rounded-md border border-input bg-background px-3 py-1 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
							/>
							<p class="text-xs text-muted-foreground">Must be on the same filesystem as the download paths.</p>
						</div>
						<div class="space-y-1.5">
							<label class="text-sm font-medium" for="inst-hardlink-preset">Directory Structure</label>
							<select
								id="inst-hardlink-preset"
								name="hardlink_dir_preset"
								class="flex h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
							>
								<option value="flat" selected?={ d.HardlinkDirPreset == "flat" || d.HardlinkDirPreset == "" }>Flat — all files in base dir</option>
								<option value="by-tracker" selected?={ d.HardlinkDirPreset == "by-tracker" }>By tracker</option>
								<option value="by-instance" selected?={ d.HardlinkDirPreset == "by-instance" }>By instance</option>
							</select>
						</div>
						<!-- Fallback toggle -->
						<div class="flex items-start justify-between gap-4 rounded-lg border bg-muted/40 p-3">
							<div class="space-y-0.5">
								<label class="text-sm font-medium">Fallback to Regular Mode</label>
								<p class="text-xs text-muted-foreground">Fall back to regular download if hardlink/reflink creation fails.</p>
							</div>
							<label class="inline-flex cursor-pointer items-center gap-2">
								<input
									type="checkbox"
									name="fallback_to_regular"
									value="on"
									checked?={ d.FallbackToRegularMode }
									class="peer hidden"
									role="switch"
								/>
								<div class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer items-center rounded-full border-2 border-transparent transition-colors bg-input peer-checked:bg-primary">
									<span class="pointer-events-none block h-4 w-4 translate-x-0 rounded-full bg-background shadow-sm ring-0 transition-transform peer-checked:translate-x-4"></span>
								</div>
							</label>
						</div>
					</div>
				</div>

			<!-- Test connection result area -->
			<div id="test-result"></div>

			<!-- Form actions -->
			<div class="flex gap-2 pt-2 border-t border-border">
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDefault}) {
					if isEdit {
						Save Changes
					} else {
						Add Instance
					}
				}
				<button
					type="button"
					class="inline-flex items-center gap-1.5 rounded-md border border-input bg-background px-4 py-2 text-sm font-medium hover:bg-accent hover:text-accent-foreground transition-colors"
					hx-post={ baseURL + "/ui/instances/test" }
					hx-include="#instance-form"
					hx-target="#test-result"
					hx-swap="innerHTML"
					hx-indicator="#test-spinner"
				>
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
					<span>Test</span>
					<svg id="test-spinner" class="htmx-indicator h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
				</button>
				if isEdit {
					<input type="hidden" name="instance_id" value={ strconv.Itoa(id) }/>
				}
				@button.Button(button.Props{
					Type:    button.TypeButton,
					Variant: button.VariantOutline,
					Attributes: templ.Attributes{
						"data-tui-dialog-close": "instance-dialog",
					},
				}) {
					Cancel
				}
			</div>
		</form>
	</div>
}

// instanceFormAlpineData builds the x-data string for the form.
func instanceFormAlpineData(authBypass, showBasicAuth, localFS, useHardlinks, useReflinks bool) string {
	ab := "false"
	if authBypass {
		ab = "true"
	}
	sba := "false"
	if showBasicAuth {
		sba = "true"
	}
	lfs := "false"
	if localFS {
		lfs = "true"
	}
	hlMode := "'regular'"
	if useHardlinks {
		hlMode = "'hardlink'"
	} else if useReflinks {
		hlMode = "'reflink'"
	}
	return fmt.Sprintf("{ authBypass: %s, showBasicAuth: %s, localFS: %s, hardlinkMode: %s }", ab, sba, lfs, hlMode)
}

// instancePasswordPlaceholder returns the password field placeholder.
func instancePasswordPlaceholder(isEdit bool) string {
	if isEdit {
		return "Leave empty to keep current password"
	}
	return "qBittorrent password"
}

// InstanceFormSuccessOOB returns an empty form slot + OOB list replacement on create/edit success.
templ InstanceFormSuccessOOB(instances []InstanceListItem, baseURL string) {
	<!-- Form slot cleared -->
	<!-- OOB: replace instance list -->
	<div id="instance-list" hx-swap-oob="innerHTML">
		@InstanceListPartial(instances, baseURL)
	</div>
}

// InstanceFormErrorResponse returns the form with an error, preserving form slot target.
templ InstanceFormNewError(baseURL, errMsg string) {
	@InstanceFormNew(baseURL, errMsg)
}

templ InstanceFormEditError(inst InstanceListItem, baseURL, errMsg string) {
	@InstanceFormEdit(inst, baseURL, errMsg)
}

// instanceCreatedAt formats the timestamp for display.
func instanceCreatedAt(t time.Time) string {
	return t.Format("Jan 2, 2006")
}

// InstanceTestResult renders the test connection result badge.
templ InstanceTestResult(success bool, message string) {
	<div id="test-result" class="flex items-center gap-2">
		if success {
			<div class="flex items-center gap-1.5 rounded-md bg-green-500/10 border border-green-500/20 px-3 py-1.5">
				<svg class="h-4 w-4 text-green-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
				<span class="text-sm text-green-600 dark:text-green-400">{ message }</span>
			</div>
		} else {
			<div class="flex items-center gap-1.5 rounded-md bg-destructive/10 border border-destructive/20 px-3 py-1.5">
				<svg class="h-4 w-4 text-destructive shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
				<span class="text-sm text-destructive break-all">{ message }</span>
			</div>
		}
	</div>
}

// InstanceTestLoading renders the loading state for the test button.
templ InstanceTestLoading() {
	<div id="test-result" class="flex items-center gap-2">
		<div class="flex items-center gap-1.5 rounded-md bg-muted px-3 py-1.5">
			<svg class="h-4 w-4 animate-spin text-muted-foreground" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
			<span class="text-sm text-muted-foreground">Testing connection...</span>
		</div>
	</div>
}

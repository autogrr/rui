package pages

import (
	"fmt"
	"strconv"

	qbt "github.com/autogrr/go-qbittorrent"
)

// TorrentDetailProps holds all data loaded for the torrent detail panel.
type TorrentDetailProps struct {
	BaseURL    string
	InstanceID int
	Hash       string
	Name       string
	State      string
	Category   string
	Tags       string

	// General tab: properties
	Properties *qbt.TorrentProperties

	// Files tab
	Files []qbt.TorrentFile

	// Trackers tab
	Trackers []qbt.TorrentTracker

	// Peers tab (values from TorrentPeersResponse.Peers map)
	Peers []qbt.TorrentPeer

	// WebSeeds tab
	WebSeeds []qbt.WebSeed

	// CrossSeed tab: local matches in other instances
	CrossSeedMatches []CrossSeedMatch
}

// CrossSeedMatch is a page-level summary of a cross-seed local match.
type CrossSeedMatch struct {
	InstanceName string
	Name         string
	Category     string
	Tags         string
	State        string
	SavePath     string
	MatchType    string
	Progress     float64
	Size         int64
}

// TorrentDetailPanel renders the full detail panel HTML returned as an HTMX partial.
// It is injected into #torrent-detail-panel on the torrents page.
templ TorrentDetailPanel(p TorrentDetailProps) {
	<div class="flex flex-col h-full" x-data="{ tab: 'general' }">
		<!-- Panel header -->
		<div class="flex items-center justify-between px-3 py-2 border-b border-border shrink-0">
			<div class="min-w-0 flex-1">
				<p class="text-sm font-semibold truncate" title={ p.Name }>{ p.Name }</p>
				<div class="flex items-center gap-2 mt-0.5">
					{{ dlabel, dcls := stateLabel(p.State) }}
					<span class={ "inline-flex items-center rounded-full px-1.5 py-0.5 text-xs font-medium", dcls }>
						{ dlabel }
					</span>
					if p.Category != "" {
						<span class="text-xs text-muted-foreground truncate">{ p.Category }</span>
					}
					if p.Tags != "" {
						<span class="text-xs text-muted-foreground truncate">{ p.Tags }</span>
					}
				</div>
				<!-- Progress bar -->
				if p.Properties != nil {
					{{ pctVal := detailProgressPct(p.Properties) }}
					{{ pctStr := fmt.Sprintf("%.1f%%", pctVal) }}
					<div class="mt-1.5 flex items-center gap-2">
						<div class="flex-1 h-1.5 rounded-full bg-muted overflow-hidden">
							<div
								class={ "h-full rounded-full transition-all",
									templ.KV("bg-blue-500", pctVal < 100),
									templ.KV("bg-green-500", pctVal >= 100),
								}
								style={ fmt.Sprintf("width: %s", pctStr) }
							></div>
						</div>
						<span class="text-xs tabular-nums text-muted-foreground shrink-0">{ pctStr }</span>
					</div>
				}
			</div>
			<!-- Close button -->
			<button
				class="ml-2 shrink-0 rounded-md p-1 text-muted-foreground hover:bg-accent hover:text-accent-foreground"
				@click="$dispatch('torrent-detail-close')"
				title="Close panel"
			>
				<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
			</button>
		</div>

		<!-- Tabs -->
		<div class="flex border-b border-border shrink-0 text-xs font-medium overflow-x-auto">
			for _, tb := range []struct{ id, label string }{
				{"general", "General"},
				{"files", "Files"},
				{"trackers", "Trackers"},
				{"peers", "Peers"},
				{"webseeds", "Web Seeds"},
				{"crossseed", "Cross-Seed"},
			} {
				<button
					@click={ "tab = '" + tb.id + "'" }
					:class={ "tab === '" + tb.id + "' ? 'border-b-2 border-primary text-primary' : 'text-muted-foreground hover:text-foreground'" }
					class="px-3 py-2 whitespace-nowrap transition-colors"
				>
					{ tb.label }
				</button>
			}
		</div>

		<!-- Tab content -->
		<div class="flex-1 overflow-auto text-xs">
			<!-- General tab -->
			<div x-show="tab === 'general'" class="p-3 space-y-2">
				if p.Properties != nil {
					@detailRow("Save path", qbt.Deref(p.Properties.SavePath))
					@detailRow("Hash", p.Hash)
					@detailRow("Total size", formatBytes(uint64(qbt.Deref(p.Properties.TotalSize))))
					@detailRow("Downloaded", formatBytes(uint64(qbt.Deref(p.Properties.TotalDownloaded))))
					@detailRow("Uploaded", formatBytes(uint64(qbt.Deref(p.Properties.TotalUploaded))))
					@detailRow("Share ratio", strconv.FormatFloat(qbt.Deref(p.Properties.ShareRatio), 'f', 3, 64))
					@detailRow("Download speed", formatBytesPerSec(uint64(max(qbt.Deref(p.Properties.DlSpeed), 0))))
					@detailRow("Upload speed", formatBytesPerSec(uint64(max(qbt.Deref(p.Properties.UpSpeed), 0))))
					@detailRow("Seeds", strconv.Itoa(qbt.Deref(p.Properties.Seeds))+" / "+strconv.Itoa(qbt.Deref(p.Properties.SeedsTotal)))
					@detailRow("Peers", strconv.Itoa(qbt.Deref(p.Properties.Peers))+" / "+strconv.Itoa(qbt.Deref(p.Properties.PeersTotal)))
					@detailRow("ETA", formatETA(qbt.Deref(p.Properties.ETA)))
					if qbt.Deref(p.Properties.Comment) != "" {
						@detailRow("Comment", qbt.Deref(p.Properties.Comment))
					}
					if qbt.Deref(p.Properties.CreatedBy) != "" {
						@detailRow("Created by", qbt.Deref(p.Properties.CreatedBy))
					}
					@detailRow("Private", boolStr(qbt.Deref(p.Properties.IsPrivate)))
					@detailRow("Connections", strconv.Itoa(qbt.Deref(p.Properties.NbConnections))+" / "+strconv.Itoa(qbt.Deref(p.Properties.NbConnectionsLimit)))
					@detailRow("Piece size", formatBytes(uint64(qbt.Deref(p.Properties.PieceSize))))
					@detailRow("Pieces have", strconv.Itoa(qbt.Deref(p.Properties.PiecesHave))+" / "+strconv.Itoa(qbt.Deref(p.Properties.PiecesNum)))
				} else {
					<p class="text-muted-foreground">No properties available.</p>
				}
			</div>

			<!-- Files tab -->
			<div x-show="tab === 'files'" x-data="{ fileCtx: { show: false, x: 0, y: 0, name: '', index: -1, hash: '', instance: '' }, renameDialog: false, renameOld: '', renameNew: '' }">
				if len(p.Files) == 0 {
					<p class="p-3 text-muted-foreground">No file information available.</p>
				} else {
					<table class="w-full">
						<thead class="sticky top-0 bg-muted/80 text-left">
							<tr class="border-b border-border">
								<th class="px-3 py-1.5 font-medium text-muted-foreground w-8">#</th>
								<th class="px-3 py-1.5 font-medium text-muted-foreground">Name</th>
								<th class="px-3 py-1.5 font-medium text-muted-foreground text-right w-20">Size</th>
								<th class="px-3 py-1.5 font-medium text-muted-foreground text-right w-16">Done</th>
								<th class="px-3 py-1.5 font-medium text-muted-foreground w-24">Priority</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-border">
							for _, f := range p.Files {
								<tr
									class="hover:bg-muted/40"
									@contextmenu.prevent={ fmt.Sprintf("fileCtx = { show: true, x: $event.clientX, y: $event.clientY, name: %q, index: %d, hash: %q, instance: %q }", qbt.Deref(f.Name), qbt.Deref(f.Index), p.Hash, strconv.Itoa(p.InstanceID)) }
								>
									<td class="px-3 py-1 text-muted-foreground tabular-nums">
										{ strconv.Itoa(qbt.Deref(f.Index)) }
									</td>
									<td class="px-3 py-1 max-w-xs">
										<span class="block truncate" title={ qbt.Deref(f.Name) }>{ qbt.Deref(f.Name) }</span>
									</td>
									<td class="px-3 py-1 text-right text-muted-foreground whitespace-nowrap tabular-nums">
										{ formatBytes(uint64(qbt.Deref(f.Size))) }
									</td>
									<td class="px-3 py-1 text-right whitespace-nowrap tabular-nums">
										<!-- Progress bar + percentage -->
										<div class="flex items-center gap-1 justify-end">
											<div class="w-8 h-1 rounded-full bg-muted overflow-hidden">
												<div
													class="h-full rounded-full bg-primary"
													style={ fmt.Sprintf("width: %.0f%%", qbt.Deref(f.Progress)*100) }
												></div>
											</div>
											<span>{ fmt.Sprintf("%.0f%%", qbt.Deref(f.Progress)*100) }</span>
										</div>
									</td>
									<td class="px-3 py-1">
										<select
											class="file-prio-select h-6 w-full rounded border border-input bg-background px-1 text-xs focus:outline-none focus:ring-1 focus:ring-ring"
											data-hash={ p.Hash }
											data-instance={ strconv.Itoa(p.InstanceID) }
											data-file-index={ strconv.Itoa(qbt.Deref(f.Index)) }
										>
											<option value="0" selected?={ filePriorityVal(f) == 0 }>Skip</option>
											<option value="1" selected?={ filePriorityVal(f) == 1 }>Normal</option>
											<option value="6" selected?={ filePriorityVal(f) == 6 }>High</option>
											<option value="7" selected?={ filePriorityVal(f) == 7 }>Maximum</option>
										</select>
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
				<!-- File context menu -->
				<div
					x-show="fileCtx.show"
					x-cloak
					@click.outside="fileCtx.show = false"
					@keydown.escape.window="fileCtx.show = false"
					:style="'left:' + fileCtx.x + 'px; top:' + fileCtx.y + 'px'"
					class="fixed z-[60] min-w-[10rem] rounded-lg border border-border bg-background shadow-xl py-1 text-xs"
				>
					<button type="button" @click="renameOld = fileCtx.name; renameNew = fileCtx.name; renameDialog = true; fileCtx.show = false" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">
						<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5z"/></svg>Rename
					</button>
					<div class="my-1 border-t border-border"></div>
					<button type="button" @click="handleDetailFilePriority(fileCtx.hash, fileCtx.instance, fileCtx.index, 1); fileCtx.show = false" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">Normal Priority</button>
					<button type="button" @click="handleDetailFilePriority(fileCtx.hash, fileCtx.instance, fileCtx.index, 6); fileCtx.show = false" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">High Priority</button>
					<button type="button" @click="handleDetailFilePriority(fileCtx.hash, fileCtx.instance, fileCtx.index, 7); fileCtx.show = false" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">Maximum Priority</button>
					<button type="button" @click="handleDetailFilePriority(fileCtx.hash, fileCtx.instance, fileCtx.index, 0); fileCtx.show = false" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors text-muted-foreground">Skip</button>
					<div class="my-1 border-t border-border"></div>
					<button type="button" @click="navigator.clipboard.writeText(fileCtx.name); fileCtx.show = false" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">
						<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>Copy Path
					</button>
				</div>
				<!-- Rename file dialog -->
				<div x-show="renameDialog" x-cloak class="fixed inset-0 z-[70] flex items-center justify-center bg-background/80 backdrop-blur-sm">
					<div class="w-96 rounded-xl border border-border bg-background shadow-xl p-5 space-y-3" @click.outside="renameDialog = false">
						<h3 class="font-semibold text-sm">Rename File</h3>
						<p class="text-xs text-muted-foreground truncate" x-text="renameOld"></p>
						<input
							x-model="renameNew"
							type="text"
							class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
							@keydown.enter="handleDetailRenameFile(fileCtx.hash, fileCtx.instance, renameOld, renameNew); renameDialog = false"
						/>
						<div class="flex justify-end gap-2">
							<button @click="renameDialog = false" class="rounded px-3 py-1.5 text-xs text-muted-foreground hover:bg-accent">Cancel</button>
							<button @click="handleDetailRenameFile(fileCtx.hash, fileCtx.instance, renameOld, renameNew); renameDialog = false" class="rounded bg-primary px-3 py-1.5 text-xs font-medium text-primary-foreground hover:bg-primary/90">Rename</button>
						</div>
					</div>
				</div>
			</div>

			<!-- Trackers tab -->
			<div x-show="tab === 'trackers'" x-data="{ showAddTracker: false, newTrackerURLs: '', trkCtx: { show: false, x: 0, y: 0, url: '', hash: '', instance: '', isReal: false }, editDialog: false, editOld: '', editNew: '' }">
				if len(p.Trackers) == 0 {
					<p class="p-3 text-muted-foreground">No trackers available.</p>
				} else {
					<table class="w-full">
						<thead class="sticky top-0 bg-muted/80 text-left">
							<tr class="border-b border-border">
								<th class="px-3 py-1.5 font-medium text-muted-foreground">URL</th>
								<th class="px-3 py-1.5 font-medium text-muted-foreground text-right w-16">Seeds</th>
								<th class="px-3 py-1.5 font-medium text-muted-foreground text-right w-16">Peers</th>
								<th class="px-3 py-1.5 font-medium text-muted-foreground w-24">Status</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-border">
							for _, tr := range p.Trackers {
								<tr
									class="hover:bg-muted/40 group"
									@contextmenu.prevent={ fmt.Sprintf("trkCtx = { show: true, x: $event.clientX, y: $event.clientY, url: %q, hash: %q, instance: %q, isReal: %t }", qbt.Deref(tr.URL), p.Hash, strconv.Itoa(p.InstanceID), isRealTrackerURL(qbt.Deref(tr.URL))) }
								>
									<td class="px-3 py-1 max-w-xs">
										<span class="block truncate text-xs" title={ qbt.Deref(tr.URL) }>{ qbt.Deref(tr.URL) }</span>
										if qbt.Deref(tr.Message) != "" {
											<span class="block text-muted-foreground truncate" title={ qbt.Deref(tr.Message) }>{ qbt.Deref(tr.Message) }</span>
										}
									</td>
									<td class="px-3 py-1 text-right tabular-nums">
										if qbt.Deref(tr.NumSeeds) >= 0 {
											{ strconv.Itoa(qbt.Deref(tr.NumSeeds)) }
										} else {
											<span class="text-muted-foreground">—</span>
										}
									</td>
									<td class="px-3 py-1 text-right tabular-nums">
										if qbt.Deref(tr.NumPeers) >= 0 {
											{ strconv.Itoa(qbt.Deref(tr.NumPeers)) }
										} else {
											<span class="text-muted-foreground">—</span>
										}
									</td>
									<td class="px-3 py-1">
										<span class={ "inline-flex rounded-full px-1.5 py-0.5 text-xs font-medium", trackerStatusClass(int(qbt.Deref(tr.Status))) }>
											{ trackerStatusLabel(int(qbt.Deref(tr.Status))) }
										</span>
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
				<!-- Tracker context menu -->
				<div
					x-show="trkCtx.show"
					x-cloak
					@click.outside="trkCtx.show = false"
					@keydown.escape.window="trkCtx.show = false"
					:style="'left:' + trkCtx.x + 'px; top:' + trkCtx.y + 'px'"
					class="fixed z-[60] min-w-[10rem] rounded-lg border border-border bg-background shadow-xl py-1 text-xs"
				>
					<template x-if="trkCtx.isReal">
						<div>
							<button type="button" @click="editOld = trkCtx.url; editNew = trkCtx.url; editDialog = true; trkCtx.show = false" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">
								<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5z"/></svg>Edit Tracker
							</button>
							<button type="button" @click="handleDetailRemoveTracker(trkCtx.hash, trkCtx.instance, trkCtx.url); trkCtx.show = false" class="flex w-full items-center gap-2 px-3 py-1.5 text-left text-destructive hover:bg-destructive hover:text-destructive-foreground transition-colors">
								<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>Remove Tracker
							</button>
							<div class="my-1 border-t border-border"></div>
						</div>
					</template>
					<button type="button" @click="navigator.clipboard.writeText(trkCtx.url); trkCtx.show = false" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">
						<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>Copy URL
					</button>
				</div>
				<!-- Edit tracker dialog -->
				<div x-show="editDialog" x-cloak class="fixed inset-0 z-[70] flex items-center justify-center bg-background/80 backdrop-blur-sm">
					<div class="w-96 rounded-xl border border-border bg-background shadow-xl p-5 space-y-3" @click.outside="editDialog = false">
						<h3 class="font-semibold text-sm">Edit Tracker</h3>
						<p class="text-xs text-muted-foreground truncate" x-text="editOld"></p>
						<input
							x-model="editNew"
							type="text"
							placeholder="New tracker URL"
							class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
							@keydown.enter="handleDetailEditTracker(trkCtx.hash, trkCtx.instance, editOld, editNew); editDialog = false"
						/>
						<div class="flex justify-end gap-2">
							<button @click="editDialog = false" class="rounded px-3 py-1.5 text-xs text-muted-foreground hover:bg-accent">Cancel</button>
							<button @click="handleDetailEditTracker(trkCtx.hash, trkCtx.instance, editOld, editNew); editDialog = false" class="rounded bg-primary px-3 py-1.5 text-xs font-medium text-primary-foreground hover:bg-primary/90">Save</button>
						</div>
					</div>
				</div>
				<!-- Add Tracker -->
				<div class="border-t border-border p-2">
					<template x-if="!showAddTracker">
						<button
							@click="showAddTracker = true"
							class="flex items-center gap-1.5 text-xs text-primary hover:underline"
						>
							<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
							Add Tracker
						</button>
					</template>
					<template x-if="showAddTracker">
						<div class="space-y-2">
							<textarea
								x-model="newTrackerURLs"
								rows="3"
								placeholder="One tracker URL per line"
								class="w-full rounded-md border border-input bg-background px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-ring resize-none"
							></textarea>
							<div class="flex gap-2 justify-end">
								<button
									@click="showAddTracker = false; newTrackerURLs = ''"
									class="rounded px-2 py-1 text-xs text-muted-foreground hover:bg-accent"
								>
									Cancel
								</button>
								<button
									class="tracker-add-btn rounded bg-primary px-2 py-1 text-xs font-medium text-primary-foreground hover:bg-primary/90"
									data-hash={ p.Hash }
									data-instance={ strconv.Itoa(p.InstanceID) }
									@click="handleAddTrackers($el.dataset.hash, $el.dataset.instance, newTrackerURLs); showAddTracker = false; newTrackerURLs = ''"
								>
									Add
								</button>
							</div>
						</div>
					</template>
				</div>
			</div>

			<!-- Peers tab -->
			<div x-show="tab === 'peers'" x-data="{ peerCtx: { show: false, x: 0, y: 0, ip: '', port: '', hash: '', instance: '', client: '' }, showAddPeers: false, newPeerAddrs: '' }">
				if len(p.Peers) == 0 {
					<p class="p-3 text-muted-foreground">No peers connected.</p>
				} else {
					<table class="w-full">
						<thead class="sticky top-0 bg-muted/80 text-left">
							<tr class="border-b border-border">
								<th class="px-3 py-1.5 font-medium text-muted-foreground">IP</th>
								<th class="px-3 py-1.5 font-medium text-muted-foreground w-20">Client</th>
								<th class="px-3 py-1.5 font-medium text-muted-foreground text-right w-16">↓</th>
								<th class="px-3 py-1.5 font-medium text-muted-foreground text-right w-16">↑</th>
								<th class="px-3 py-1.5 font-medium text-muted-foreground text-right w-12">Done</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-border">
							for _, peer := range p.Peers {
								<tr
									class="hover:bg-muted/40"
									@contextmenu.prevent={ fmt.Sprintf("peerCtx = { show: true, x: $event.clientX, y: $event.clientY, ip: %q, port: %q, hash: %q, instance: %q, client: %q }", qbt.Deref(peer.IP), strconv.Itoa(qbt.Deref(peer.Port)), p.Hash, strconv.Itoa(p.InstanceID), qbt.Deref(peer.Client)) }
								>
									<td class="px-3 py-1 tabular-nums whitespace-nowrap">
										{ qbt.Deref(peer.IP) }:{ strconv.Itoa(qbt.Deref(peer.Port)) }
									</td>
									<td class="px-3 py-1 max-w-[5rem]">
										<span class="block truncate text-muted-foreground" title={ qbt.Deref(peer.Client) }>{ qbt.Deref(peer.Client) }</span>
									</td>
									<td class="px-3 py-1 text-right tabular-nums text-blue-600 dark:text-blue-400 whitespace-nowrap">
										if qbt.Deref(peer.DlSpeed) > 0 {
											{ formatBytesPerSec(uint64(qbt.Deref(peer.DlSpeed))) }
										} else {
											<span class="text-muted-foreground">—</span>
										}
									</td>
									<td class="px-3 py-1 text-right tabular-nums text-green-600 dark:text-green-400 whitespace-nowrap">
										if qbt.Deref(peer.UpSpeed) > 0 {
											{ formatBytesPerSec(uint64(qbt.Deref(peer.UpSpeed))) }
										} else {
											<span class="text-muted-foreground">—</span>
										}
									</td>
									<td class="px-3 py-1 text-right tabular-nums">
										{ fmt.Sprintf("%.0f%%", qbt.Deref(peer.Progress)*100) }
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
				<!-- Peer context menu -->
				<div
					x-show="peerCtx.show"
					x-cloak
					@click.outside="peerCtx.show = false"
					@keydown.escape.window="peerCtx.show = false"
					:style="'left:' + peerCtx.x + 'px; top:' + peerCtx.y + 'px'"
					class="fixed z-[60] min-w-[10rem] rounded-lg border border-border bg-background shadow-xl py-1 text-xs"
				>
					<button type="button" @click="handleDetailBanPeer(peerCtx.instance, peerCtx.ip + ':' + peerCtx.port); peerCtx.show = false" class="flex w-full items-center gap-2 px-3 py-1.5 text-left text-destructive hover:bg-destructive hover:text-destructive-foreground transition-colors">
						<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>Ban Peer
					</button>
					<div class="my-1 border-t border-border"></div>
					<button type="button" @click="navigator.clipboard.writeText(peerCtx.ip); peerCtx.show = false" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">
						<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>Copy IP
					</button>
					<button type="button" @click="navigator.clipboard.writeText(peerCtx.ip + ':' + peerCtx.port); peerCtx.show = false" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">
						<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>Copy IP:Port
					</button>
					<button type="button" @click="navigator.clipboard.writeText(peerCtx.client); peerCtx.show = false" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">
						<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>Copy Client
					</button>
				</div>
				<!-- Add Peers -->
				<div class="border-t border-border p-2">
					<template x-if="!showAddPeers">
						<button
							@click="showAddPeers = true"
							class="flex items-center gap-1.5 text-xs text-primary hover:underline"
						>
							<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
							Add Peers
						</button>
					</template>
					<template x-if="showAddPeers">
						<div class="space-y-2">
							<textarea
								x-model="newPeerAddrs"
								rows="3"
								placeholder="One peer per line (host:port)"
								class="w-full rounded-md border border-input bg-background px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-ring resize-none"
							></textarea>
							<div class="flex gap-2 justify-end">
								<button
									@click="showAddPeers = false; newPeerAddrs = ''"
									class="rounded px-2 py-1 text-xs text-muted-foreground hover:bg-accent"
								>
									Cancel
								</button>
								<button
									class="rounded bg-primary px-2 py-1 text-xs font-medium text-primary-foreground hover:bg-primary/90"
									data-hash={ p.Hash }
									data-instance={ strconv.Itoa(p.InstanceID) }
									@click="handleDetailAddPeers($el.dataset.hash, $el.dataset.instance, newPeerAddrs); showAddPeers = false; newPeerAddrs = ''"
								>
									Add
								</button>
							</div>
						</div>
					</template>
				</div>
			</div>

			<!-- WebSeeds tab -->
			<div x-show="tab === 'webseeds'">
				if len(p.WebSeeds) == 0 {
					<p class="p-3 text-muted-foreground">No web seeds available.</p>
				} else {
					<table class="w-full">
						<thead class="sticky top-0 bg-muted/80 text-left">
							<tr class="border-b border-border">
								<th class="px-3 py-1.5 font-medium text-muted-foreground">URL</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-border">
							for _, ws := range p.WebSeeds {
								<tr class="hover:bg-muted/40">
									<td class="px-3 py-1">
										<a
											href={ templ.URL(ws.URL) }
											target="_blank"
											rel="noopener noreferrer"
											class="text-primary hover:underline break-all"
										>{ ws.URL }</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>
			<!-- CrossSeed tab -->
			<div x-show="tab === 'crossseed'">
				if len(p.CrossSeedMatches) == 0 {
					<p class="p-3 text-muted-foreground">No cross-seed copies found in other instances.</p>
				} else {
					<table class="w-full">
						<thead class="sticky top-0 bg-muted/80 text-left">
							<tr class="border-b border-border">
								<th class="px-3 py-1.5 font-medium text-muted-foreground">Name</th>
								<th class="px-3 py-1.5 font-medium text-muted-foreground w-24">Instance</th>
								<th class="px-3 py-1.5 font-medium text-muted-foreground w-20">State</th>
								<th class="px-3 py-1.5 font-medium text-muted-foreground text-right w-14">Done</th>
								<th class="px-3 py-1.5 font-medium text-muted-foreground w-20">Match</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-border">
							for _, m := range p.CrossSeedMatches {
								<tr class="hover:bg-muted/40">
									<td class="px-3 py-1 max-w-xs">
										<span class="block truncate" title={ m.Name }>{ m.Name }</span>
										if m.Category != "" {
											<span class="block text-muted-foreground text-xs truncate">{ m.Category }</span>
										}
									</td>
									<td class="px-3 py-1 text-xs text-muted-foreground whitespace-nowrap">{ m.InstanceName }</td>
									<td class="px-3 py-1">
										{{ dlabel, dcls := stateLabel(m.State) }}
										<span class={ "inline-flex items-center rounded-full px-1.5 py-0.5 text-xs font-medium", dcls }>
											{ dlabel }
										</span>
									</td>
									<td class="px-3 py-1 text-right tabular-nums">
										{ fmt.Sprintf("%.0f%%", m.Progress*100) }
									</td>
									<td class="px-3 py-1 text-xs text-muted-foreground">{ m.MatchType }</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>
		</div>
	</div>
}

// detailRow renders a label/value pair in the General tab.
templ detailRow(label, value string) {
	<div class="grid grid-cols-[8rem_1fr] gap-x-2 py-0.5">
		<span class="text-muted-foreground truncate">{ label }</span>
		<span class="break-all">{ value }</span>
	</div>
}

// trackerStatusLabel maps a tracker status int to a human-readable label.
func trackerStatusLabel(status int) string {
	switch status {
	case 0:
		return "Disabled"
	case 1:
		return "Not contacted"
	case 2:
		return "Working"
	case 3:
		return "Updating"
	case 4:
		return "Error"
	default:
		return "Unknown"
	}
}

// trackerStatusClass returns Tailwind badge classes for a tracker status.
func trackerStatusClass(status int) string {
	switch status {
	case 2:
		return "bg-green-500/15 text-green-700 dark:text-green-400"
	case 4:
		return "bg-red-500/15 text-red-700 dark:text-red-400"
	case 3:
		return "bg-yellow-500/15 text-yellow-700 dark:text-yellow-400"
	default:
		return "bg-muted text-muted-foreground"
	}
}

// boolStr converts a bool to "Yes"/"No".
func boolStr(b bool) string {
	if b {
		return "Yes"
	}
	return "No"
}

// filePriorityVal extracts the integer file priority, defaulting to 1 (Normal).
func filePriorityVal(f qbt.TorrentFile) int {
	if f.Priority == nil {
		return 1
	}
	return int(*f.Priority)
}

// isRealTrackerURL returns true if the URL is an actual tracker (not DHT/PeX/LSD).
func isRealTrackerURL(url string) bool {
	return url != "" && url != "** [DHT] **" && url != "** [PeX] **" && url != "** [LSD] **"
}

// detailProgressPct computes completion percentage from PiecesHave/PiecesNum.
func detailProgressPct(props *qbt.TorrentProperties) float64 {
	if props == nil {
		return 0
	}
	total := qbt.Deref(props.PiecesNum)
	have := qbt.Deref(props.PiecesHave)
	if total <= 0 {
		return 0
	}
	return float64(have) / float64(total) * 100
}

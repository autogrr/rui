package pages

import (
"encoding/json"
"fmt"
"net/url"
"strconv"
"strings"
"time"

"github.com/autogrr/rui/internal/ui/layouts"
)

// TorrentRow is a view of one torrent for the list table.
type TorrentRow struct {
	Hash         string
	Name         string
	State        string  // qbt state string
	SizeB        int64   // selected-file size, bytes
	TotalSizeB   int64   // total_size including skipped files, bytes
	Progress     float64 // 0–1
	DlSpeed      int64   // bytes/s
	UpSpeed      int64   // bytes/s
	Ratio        float64
	Category     string
	Tags         string  // comma-separated
	ETA          int64   // seconds; -1 / large = ∞
	AddedOn      int64   // unix timestamp
	CompletionOn int64   // unix timestamp (0 = not yet completed)
	SavePath     string
	Tracker      string  // primary tracker URL
	Uploaded     int64   // total bytes uploaded ever
	Downloaded   int64   // total bytes downloaded
	NumSeeds     int64   // connected seeds
	NumLeechs    int64   // connected leechers
	NumComplete  int64   // total seeds (tracker)
	NumIncomplete int64  // total peers (tracker)
	SeedingTime  int64   // seconds seeding
	TimeActive   int64   // seconds total active
	AmountLeft   int64   // bytes remaining
	LastActivity int64   // unix timestamp of last bandwidth activity
	Availability float64 // 0–1 piece availability
	InfohashV1   string
	InfohashV2   string
	Priority     int64   // queue position (0 = not queued)
}

// TorrentsProps holds data for the torrents list page.
type TorrentsProps struct {
BaseURL    string
Username   string
Version    string
Instances  []layouts.Instance
InstanceID int // currently selected instance (0 = all)
Rows       []TorrentRow
Total      int
Search     string
Status     string // active status filter, e.g. "downloading"
Category   string // active category filter
Tag        string // active tag filter
Sort       string // sort column, e.g. "added_on", "name", "size"
Order      string // "asc" or "desc"
Expr       string // optional expr-lang filter expression

// Sidebar data (populated for full page renders only)
Categories    []string
Tags          []string
FilterTracker  string
FilterSavePath string
}

// stateLabel maps a qBittorrent torrent state to a human-readable badge label + CSS class.
func stateLabel(state string) (label string, class string) {
switch state {
case "downloading", "metaDL", "allocating":
return "Downloading", "bg-blue-500/15 text-blue-700 dark:text-blue-400"
case "uploading", "stalledUP", "forcedUP", "queuedUP":
return "Seeding", "bg-green-500/15 text-green-700 dark:text-green-400"
case "pausedDL", "stoppedDL":
return "Paused", "bg-muted text-muted-foreground"
case "pausedUP", "stoppedUP":
return "Completed", "bg-muted text-muted-foreground"
case "error", "missingFiles":
return "Error", "bg-red-500/15 text-red-700 dark:text-red-400"
case "checkingUP", "checkingDL", "checkingResumeData":
return "Checking", "bg-yellow-500/15 text-yellow-700 dark:text-yellow-400"
default:
return state, "bg-muted text-muted-foreground"
}
}

// formatETA returns a human-readable ETA string.
func formatETA(seconds int64) string {
if seconds < 0 || seconds > 8640000 {
return "∞"
}
h := seconds / 3600
m := (seconds % 3600) / 60
s := seconds % 60
if h > 0 {
return fmt.Sprintf("%dh%02dm", h, m)
}
if m > 0 {
return fmt.Sprintf("%dm%02ds", m, s)
}
return fmt.Sprintf("%ds", s)
}

// formatRatio returns ratio as a short string.
func formatRatio(r float64) string {
if r >= 100 {
return ">100"
}
return strconv.FormatFloat(r, 'f', 2, 64)
}

// formatPercent renders progress as "XX.X%".
func formatPercent(p float64) string {
return fmt.Sprintf("%.1f%%", p*100)
}

// formatTimestamp converts a Unix timestamp to a human-readable date+time string.
func formatTimestamp(t int64) string {
if t <= 0 {
return "—"
}
return time.Unix(t, 0).Format("Jan 2, 2006 15:04")
}

// formatSeedingTime formats seeding duration from seconds.
func formatSeedingTime(seconds int64) string {
if seconds <= 0 {
return "—"
}
d := seconds / 86400
h := (seconds % 86400) / 3600
if d > 0 {
return fmt.Sprintf("%dd %dh", d, h)
}
m := (seconds % 3600) / 60
if h > 0 {
return fmt.Sprintf("%dh %dm", h, m)
}
return fmt.Sprintf("%dm", m)
}

// trackerHost extracts just the hostname from a tracker URL for display.
func trackerHost(rawURL string) string {
if rawURL == "" {
return ""
}
if u, err := url.Parse(rawURL); err == nil && u.Host != "" {
host := u.Host
if i := strings.LastIndex(host, ":"); i != -1 {
host = host[:i]
}
parts := strings.Split(host, ".")
if len(parts) >= 2 {
return parts[len(parts)-2] + "." + parts[len(parts)-1]
}
return host
}
return rawURL
}

// isDownloading reports whether the torrent state is an active-download state.
func isDownloading(state string) bool {
	switch state {
	case "downloading", "metaDL", "allocating", "checkingDL", "forcedDL":
		return true
	}
	return false
}

// torrentColDef describes one column in the toggle dropdown.
type torrentColDef struct {
	ID      string
	Label   string
	Default bool
}

// torrentColumnDefs is the canonical ordered list of togglable columns.
var torrentColumnDefs = []torrentColDef{
	// Visible by default
	{ID: "status", Label: "Status", Default: true},
	{ID: "size", Label: "Size", Default: true},
	{ID: "progress", Label: "Progress", Default: true},
	{ID: "dlspeed", Label: "Down ↓", Default: true},
	{ID: "upspeed", Label: "Up ↑", Default: true},
	{ID: "eta", Label: "ETA", Default: true},
	{ID: "ratio", Label: "Ratio", Default: true},
	{ID: "seeds", Label: "Seeds", Default: true},
	{ID: "category", Label: "Category", Default: true},
	{ID: "tags", Label: "Tags", Default: true},
	{ID: "tracker", Label: "Tracker", Default: true},
	{ID: "added_on", Label: "Added", Default: true},
	// Hidden by default
	{ID: "total_size", Label: "Total Size", Default: false},
	{ID: "uploaded", Label: "Uploaded", Default: false},
	{ID: "downloaded", Label: "Downloaded", Default: false},
	{ID: "amount_left", Label: "Remaining", Default: false},
	{ID: "completion_on", Label: "Completed On", Default: false},
	{ID: "time_active", Label: "Time Active", Default: false},
	{ID: "seeding_time", Label: "Seeding Time", Default: false},
	{ID: "last_activity", Label: "Last Activity", Default: false},
	{ID: "priority", Label: "Priority", Default: false},
	{ID: "save_path", Label: "Save Path", Default: false},
	{ID: "infohash", Label: "Info Hash", Default: false},
	{ID: "availability", Label: "Avail.", Default: false},
}

// colDefaultsJSON returns a valid JSON object like {"status":true,"size":true,...}
// for bootstrapping client-side column visibility state. Keys are double-quoted
// so the output can be parsed with JSON.parse().
func colDefaultsJSON() string {
	var b strings.Builder
	b.WriteString("{")
	for i, c := range torrentColumnDefs {
		if i > 0 {
			b.WriteString(",")
		}
		b.WriteString(`"`)
		b.WriteString(c.ID)
		b.WriteString(`":`)
		if c.Default {
			b.WriteString("true")
		} else {
			b.WriteString("false")
		}
	}
	b.WriteString("}")
	return b.String()
}

// torrentsToJSON serialises props into a compact JSON blob for the virtual
// scroll renderer. Safe to embed in <script type="application/json">.
func torrentsToJSON(p TorrentsProps) string {
	type payload struct {
		Rows       []TorrentRow `json:"rows"`
		BaseURL    string       `json:"baseURL"`
		InstanceID int          `json:"instanceID"`
		Total      int          `json:"total"`
	}
	b, _ := json.Marshal(payload{
		Rows:       p.Rows,
		BaseURL:    p.BaseURL,
		InstanceID: p.InstanceID,
		Total:      p.Total,
	})
	s := string(b)
	s = strings.ReplaceAll(s, "</script>", `<\/script>`)
	s = strings.ReplaceAll(s, "<!--", `<\!--`)
	return s
}

// torrentsActiveInstance returns the layouts.Instance matching p.InstanceID, or
// nil if no instance is selected (e.g. when there are no active instances).
func torrentsActiveInstance(p TorrentsProps) *layouts.Instance {
	for _, inst := range p.Instances {
		if inst.ID == p.InstanceID {
			return &layouts.Instance{ID: inst.ID, Name: inst.Name, IsActive: inst.IsActive}
		}
	}
	return nil
}

// Torrents renders the torrents list page.
templ Torrents(p TorrentsProps) {
@layouts.Authenticated(layouts.AuthProps{
BaseURL:        p.BaseURL,
Title:          "Torrents",
CurrentPath:    "/ui/torrents",
Username:       p.Username,
AppVersion:     p.Version,
Instances:      p.Instances,
ActiveInstance: torrentsActiveInstance(p),
}) {
<div
class="flex h-full min-h-0 gap-0"
x-data="{ addOpen: false, sidebarOpen: true, addTab: 'file', addAdv: false, useTmpPath: false }"
>
<!-- Left filter sidebar -->
<div
x-show="sidebarOpen"
x-cloak
class="w-48 shrink-0 flex flex-col border-r border-border bg-background overflow-y-auto text-sm"
>
<div class="px-3 py-2 space-y-4">
<!-- Status section -->
<div>
<p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1">Status</p>
<ul class="space-y-0.5">
for _, sf := range []struct{ val, label string }{
{"", "All"},
{"downloading", "Downloading"},
{"uploading", "Seeding"},
{"paused", "Paused"},
{"completed", "Completed"},
{"errored", "Error"},
} {
<li>
<button
hx-get={ p.BaseURL + "/ui/partials/torrents" }
hx-target="#vt-data-slot"
hx-swap="innerHTML"
hx-push-url="false"
hx-vals={ `{"status":"` + sf.val + `"}` }
hx-include="#current-category,#current-tag,#current-instance,#current-sort,#current-order,#current-tracker,#current-savepath,#current-expr,#torrents-search"
class={
"w-full text-left px-2 py-1 rounded-md transition-colors flex items-center justify-between",
templ.KV("bg-primary/10 text-primary font-medium", p.Status == sf.val),
templ.KV("text-muted-foreground hover:bg-accent hover:text-foreground", p.Status != sf.val),
}
>
<span>{ sf.label }</span>
<span
id={ "sb-status-count-" + sf.val }
class={
"tabular-nums text-xs",
templ.KV("text-primary/70", p.Status == sf.val),
templ.KV("text-muted-foreground/60", p.Status != sf.val),
}
></span>
</button>
</li>
}
</ul>
</div>
<!-- Categories section (derived from row data) -->
<div id="vt-sidebar-cats-section" class="hidden">
<p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1">Categories</p>
<input id="vt-cat-filter" type="text" placeholder="Filter…" class="w-full mb-1 h-6 rounded border border-input bg-background px-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-ring" oninput="_filterSidebar('cats')"/>
<div id="vt-cat-scroll" class="max-h-48 overflow-y-auto">
<ul id="vt-sidebar-cats" class="space-y-0.5"></ul>
</div>
</div>
<!-- Tags section -->
<div id="vt-sidebar-tags-section" class="hidden">
<p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1">Tags</p>
<input id="vt-tag-filter" type="text" placeholder="Filter…" class="w-full mb-1 h-6 rounded border border-input bg-background px-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-ring" oninput="_filterSidebar('tags')"/>
<div id="vt-tag-scroll" class="max-h-36 overflow-y-auto">
<ul id="vt-sidebar-tags" class="space-y-0.5"></ul>
</div>
</div>
<!-- Trackers section -->
<div id="vt-sidebar-trackers-section" class="hidden">
<p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1">Trackers</p>
<input id="vt-tracker-filter" type="text" placeholder="Filter…" class="w-full mb-1 h-6 rounded border border-input bg-background px-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-ring" oninput="_filterSidebar('trackers')"/>
<div id="vt-tracker-scroll" class="max-h-36 overflow-y-auto">
<ul id="vt-sidebar-trackers" class="space-y-0.5"></ul>
</div>
</div>
<!-- Save Paths section -->
<div id="vt-sidebar-savepaths-section" class="hidden">
<p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1">Save Paths</p>
<input id="vt-savepath-filter" type="text" placeholder="Filter…" class="w-full mb-1 h-6 rounded border border-input bg-background px-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-ring" oninput="_filterSidebar('savepaths')"/>
<div id="vt-savepath-scroll" class="max-h-36 overflow-y-auto">
<ul id="vt-sidebar-savepaths" class="space-y-0.5"></ul>
</div>
</div>
</div>
</div>

<!-- Main content (toolbar + table + pagination) -->
<div class="flex flex-col flex-1 min-w-0 gap-2 p-2 overflow-hidden">
<!-- Toolbar -->
<div class="flex flex-wrap items-center gap-2 shrink-0">
<!-- Sidebar toggle -->
<button
@click="sidebarOpen = !sidebarOpen"
class="p-1.5 rounded-md text-muted-foreground hover:bg-accent hover:text-foreground transition-colors"
title="Toggle filter sidebar"
>
<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
</button>
<h1 class="text-lg font-bold tracking-tight">Torrents</h1>
<!-- Search -->
<input
id="torrents-search"
type="search"
name="search"
value={ p.Search }
placeholder="Search torrents…"
class="h-8 rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring w-48 md:w-64"
hx-trigger="keyup changed delay:400ms, search"
hx-get={ p.BaseURL + "/ui/partials/torrents" }
hx-target="#vt-data-slot"
hx-swap="innerHTML"
hx-push-url="false"
hx-include="#current-status,#current-category,#current-tag,#current-instance,#current-sort,#current-order,#current-tracker,#current-savepath,#current-expr"
hx-on::after-request="renderFilterChips()"
/>
<!-- Filter builder popover -->
<div class="relative" x-data="{ builderOpen: false }">
<button
@click="builderOpen = !builderOpen; if(builderOpen) initExprBuilder()"
class="inline-flex items-center gap-1 h-8 rounded-md border border-input bg-background px-2.5 text-xs font-medium text-muted-foreground hover:bg-accent hover:text-foreground transition-colors"
title="Build a filter expression"
>
<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M7 12h10M11 18h2"/></svg>
Filter
</button>
<div
x-show="builderOpen"
x-cloak
@click.outside="builderOpen = false"
class="absolute left-0 top-full mt-1 z-30 w-[26rem] rounded-lg border border-border bg-background shadow-lg p-3 space-y-2"
>
<p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Add Condition</p>
<!-- Row 1: field + op + value + range toggle -->
<div class="flex items-center gap-1.5 flex-wrap">
<select id="eb-field" onchange="exprBuilderFieldChanged()" class="h-7 rounded-md border border-input bg-background px-2 text-xs focus:outline-none focus:ring-1 focus:ring-ring">
<!-- populated by initExprBuilder() -->
</select>
<select id="eb-op" class="h-7 rounded-md border border-input bg-background px-2 text-xs focus:outline-none focus:ring-1 focus:ring-ring">
<!-- populated by exprBuilderFieldChanged() -->
</select>
<div id="eb-val-container">
<input id="eb-val" type="text" placeholder="value" class="h-7 w-24 rounded-md border border-input bg-background px-2 text-xs focus:outline-none focus:ring-1 focus:ring-ring" onfocus="_ebFocusedVal='eb-val'" onkeydown="if(event.key==='Enter'){event.preventDefault();ebStageAdd();}"/>
</div>
<button id="eb-range-btn" type="button" onclick="ebToggleRange()" title="Add a second bound (range)" class="h-7 px-2 rounded-md border border-input bg-background text-xs text-muted-foreground hover:bg-accent hover:text-foreground transition-colors">⇔</button>
</div>
<!-- Row 2: second constraint for range queries (hidden by default) -->
<div id="eb-range-row" class="hidden flex items-center gap-1.5">
<span class="text-[10px] text-muted-foreground font-medium uppercase tracking-wider">and</span>
<select id="eb-op2" class="h-7 rounded-md border border-input bg-background px-2 text-xs focus:outline-none focus:ring-1 focus:ring-ring"></select>
<div id="eb-val2-container">
<input id="eb-val2" type="text" placeholder="value" class="h-7 w-24 rounded-md border border-input bg-background px-2 text-xs focus:outline-none focus:ring-1 focus:ring-ring" onfocus="_ebFocusedVal='eb-val2'" onkeydown="if(event.key==='Enter'){event.preventDefault();ebStageAdd();}"/>
</div>
</div>
<!-- Add row: next-connector toggle + Add / Update button + cancel -->
<div class="flex items-center justify-between">
<div class="inline-flex rounded border border-border overflow-hidden text-[10px] font-semibold" title="Connector for the next condition">
<button id="eb-join-and" type="button" onclick="ebSetJoin('and')" class="px-2 py-0.5 bg-primary text-primary-foreground">AND</button>
<button id="eb-join-or"  type="button" onclick="ebSetJoin('or')"  class="px-2 py-0.5 bg-background text-muted-foreground hover:bg-accent hover:text-foreground transition-colors">OR</button>
</div>
<div class="flex items-center gap-2">
<span id="eb-cancel-edit" class="hidden text-xs text-muted-foreground cursor-pointer hover:text-foreground transition-colors" onclick="ebCancelEdit()">Cancel</span>
<button id="eb-add-btn" onclick="ebStageAdd()" class="h-7 rounded-md bg-primary px-2.5 text-xs font-medium text-primary-foreground hover:bg-primary/90 transition-colors">+ Add</button>
</div>
</div>
<!-- Staged conditions list (Sortable drag-and-drop); scrollable if many items -->
<ol id="eb-conditions" class="space-y-1 list-none max-h-48 overflow-y-auto"></ol>
<!-- Footer: group + clear + apply — only visible when there are staged conditions -->
<div id="eb-footer" class="hidden border-t border-border pt-2 flex items-center justify-between gap-2">
<div class="flex items-center gap-2">
<button id="eb-group-btn" type="button" onclick="ebGroupChecked()" class="hidden h-6 rounded border border-border px-2 text-[10px] font-medium text-muted-foreground hover:bg-accent hover:text-foreground transition-colors">↱ Group checked</button>
<button type="button" onclick="ebClearAll()" class="text-xs text-muted-foreground hover:text-foreground transition-colors">Clear all</button>
</div>
<button type="button" onclick="ebCommit()" class="h-7 rounded-md bg-primary px-3 text-xs font-semibold text-primary-foreground hover:bg-primary/90 transition-colors">Apply</button>
</div>
<!-- Raw expr escape hatch -->
<div class="border-t border-border pt-2 flex items-center gap-2">
<label class="text-xs text-muted-foreground shrink-0" for="current-expr">Expr:</label>
<input
id="current-expr"
type="text"
name="expr"
value={ p.Expr }
placeholder='e.g. Ratio &lt; 1 &amp;&amp; State == "downloading"'
title="expr-lang fields: Name, State, Category, Tags, Ratio, Size, DlSpeed, UpSpeed, Uploaded, Downloaded, SeedingTime, TimeActive, AddedOn, NumSeeds, NumLeechs, NumComplete, NumIncomplete, Priority, SavePath, Tracker, Progress, Availability"
class="h-7 flex-1 rounded-md border border-input bg-background px-2 text-xs font-mono focus:outline-none focus:ring-1 focus:ring-ring"
hx-trigger="keyup changed delay:600ms"
hx-get={ p.BaseURL + "/ui/partials/torrents" }
hx-target="#vt-data-slot"
hx-swap="innerHTML"
hx-push-url="false"
hx-include="#current-status,#current-category,#current-tag,#current-instance,#current-sort,#current-order,#current-tracker,#current-savepath,#torrents-search"
hx-on::after-request="renderFilterChips()"
/>
</div>
</div>
</div>
<!-- Hidden filter state inputs -->
<input type="hidden" id="current-status" name="status" value={ p.Status }/>
<input type="hidden" id="current-category" name="category" value={ p.Category }/>
<input type="hidden" id="current-tag" name="tag" value={ p.Tag }/>
<input type="hidden" id="current-tracker" name="tracker" value={ p.FilterTracker }/>
<input type="hidden" id="current-savepath" name="savepath" value={ p.FilterSavePath }/>
<input type="hidden" id="current-instance" name="instance_id" value={ itoa(p.InstanceID) }/>
<input type="hidden" id="current-sort" name="sort" value={ p.Sort }/>
<input type="hidden" id="current-order" name="order" value={ p.Order }/>
<!-- Hidden sort trigger button (invoked by sortBy() / triggerTableRefresh()) -->
<!-- Uses custom event 'tbl-refresh' so synthetic dispatches do not bubble as
     a DOM click and accidentally close Alpine @click.outside popovers. -->
<button
id="sort-trigger"
style="display:none"
hx-trigger="tbl-refresh"
hx-get={ p.BaseURL + "/ui/partials/torrents" }
hx-target="#vt-data-slot"
hx-swap="innerHTML"
hx-push-url="false"
hx-include="#current-status,#current-category,#current-tag,#current-instance,#current-sort,#current-order,#current-tracker,#current-savepath,#current-expr,#torrents-search"
hx-on::after-request="renderFilterChips()"
></button>
<!-- Filter chips (JS-managed, shows active conditions as expr-style pills) -->
<div id="filter-chips" class="flex flex-wrap gap-1"></div>
<!-- Spacer -->
<div class="flex-1"></div>
<span id="torrent-count" class="text-xs text-muted-foreground tabular-nums">{ itoa(p.Total) } torrent(s)</span>
<!-- SSE live indicator -->
<span
id="sse-indicator"
class="hidden w-2 h-2 rounded-full bg-green-500 flex-shrink-0"
title="Live updates active"
></span>
<!-- Columns toggle dropdown -->
<div class="relative" x-data="{ colsOpen: false }">
<button
@click="colsOpen = !colsOpen"
class="inline-flex items-center gap-1 rounded-md border border-input bg-background px-2.5 py-1.5 text-xs font-medium text-muted-foreground hover:bg-accent hover:text-foreground transition-colors"
title="Toggle column visibility"
>
<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
Columns
</button>
<div
x-show="colsOpen"
x-cloak
@click.outside="colsOpen = false"
class="absolute right-0 top-full mt-1 z-30 w-52 rounded-lg border border-border bg-background shadow-lg py-2 max-h-80 overflow-y-auto"
>
<div class="px-3 pb-1.5 border-b border-border mb-1.5 flex justify-between items-center">
<span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Columns</span>
<button onclick="resetTblCols()" class="text-xs text-muted-foreground hover:text-foreground">Reset</button>
</div>
for _, col := range torrentColumnDefs {
<label class="flex items-center gap-2 px-3 py-1 hover:bg-accent cursor-pointer text-sm select-none">
<input
type="checkbox"
id={ "col-toggle-" + col.ID }
class="rounded"
data-col-toggle={ col.ID }
onchange="toggleTblCol(this.dataset.colToggle)"
/>
{ col.Label }
</label>
}
</div>
</div>
<button
@click="addOpen = true"
class="inline-flex items-center gap-1.5 rounded-md bg-primary px-3 py-1.5 text-xs font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
>
<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
Add
</button>
</div>

<!-- Table + detail panel row -->
<div class="flex flex-1 min-h-0 gap-2">
<!-- Table + bulk bar wrapper -->
<div
class="flex flex-col flex-1 min-w-0"
>
<!-- vt-data-slot: hidden; receives HTMX swaps. hx-ext="sse" lives here so the
     SSE extension registers hx-trigger="sse:..." directly on this element. -->
<div
id="vt-data-slot"
style="display:none"
hx-ext="sse"
sse-connect={ p.BaseURL + "/ui/sse/torrents?instance_id=" + itoa(p.InstanceID) }
hx-trigger="sse:torrent-update throttle:2s, every 5s"
hx-get={ p.BaseURL + "/ui/partials/torrents" }
hx-swap="innerHTML"
hx-push-url="false"
hx-include="#current-status,#current-category,#current-tag,#current-instance,#current-sort,#current-order,#current-tracker,#current-savepath,#current-expr,#torrents-search"
>
@TorrentsTableBody(p)
</div>
<div id="torrents-scroll-container" class="flex-1 overflow-auto rounded-lg border border-border">
<table class="w-full text-sm">
<thead class="sticky top-0 z-10 bg-muted/80 backdrop-blur border-b border-border">
<tr>
<th class="px-2 py-2 w-8">
<input
type="checkbox"
id="select-all"
class="rounded"
onchange="selectAll(this.checked)"
/>
</th>
<th class="px-3 py-2 text-left font-medium text-muted-foreground"><button class="hover:text-foreground" data-sort-col="name" onclick="sortBy('name')">Name</button></th>
<th class="px-3 py-2 text-left font-medium text-muted-foreground w-24" data-col="status"><button class="hover:text-foreground" data-sort-col="state" onclick="sortBy('state')">Status</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-20" data-col="size"><button class="hover:text-foreground" data-sort-col="size" onclick="sortBy('size')">Size</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-20" data-col="total_size"><button class="hover:text-foreground" data-sort-col="total_size" onclick="sortBy('total_size')">Total</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-16" data-col="progress"><button class="hover:text-foreground" data-sort-col="progress" onclick="sortBy('progress')">Done</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-20" data-col="dlspeed"><button class="hover:text-foreground" data-sort-col="dlspeed" onclick="sortBy('dlspeed')">&#x2193;</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-20" data-col="upspeed"><button class="hover:text-foreground" data-sort-col="upspeed" onclick="sortBy('upspeed')">&#x2191;</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-16" data-col="eta">ETA</th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-16" data-col="ratio"><button class="hover:text-foreground" data-sort-col="ratio" onclick="sortBy('ratio')">Ratio</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-20" data-col="uploaded"><button class="hover:text-foreground" data-sort-col="uploaded" onclick="sortBy('uploaded')">Uploaded</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-20" data-col="downloaded"><button class="hover:text-foreground" data-sort-col="downloaded" onclick="sortBy('downloaded')">Downloaded</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-20" data-col="amount_left">Remaining</th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-14" data-col="seeds"><button class="hover:text-foreground" data-sort-col="num_seeds" onclick="sortBy('num_seeds')">Seeds</button></th>
<th class="px-3 py-2 text-left font-medium text-muted-foreground w-28" data-col="category"><button class="hover:text-foreground" data-sort-col="category" onclick="sortBy('category')">Category</button></th>
<th class="px-3 py-2 text-left font-medium text-muted-foreground w-32" data-col="tags">Tags</th>
<th class="px-3 py-2 text-left font-medium text-muted-foreground w-24" data-col="tracker">Tracker</th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-28" data-col="added_on"><button class="hover:text-foreground" data-sort-col="added_on" onclick="sortBy('added_on')">Added</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-28" data-col="completion_on"><button class="hover:text-foreground" data-sort-col="completion_on" onclick="sortBy('completion_on')">Completed</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-24" data-col="seeding_time"><button class="hover:text-foreground" data-sort-col="seeding_time" onclick="sortBy('seeding_time')">Seeding</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-24" data-col="time_active">Time Active</th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-28" data-col="last_activity"><button class="hover:text-foreground" data-sort-col="last_activity" onclick="sortBy('last_activity')">Last Activity</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-16" data-col="priority"><button class="hover:text-foreground" data-sort-col="priority" onclick="sortBy('priority')">Queue</button></th>
<th class="px-3 py-2 text-left font-medium text-muted-foreground" data-col="save_path">Save Path</th>
<th class="px-3 py-2 text-left font-medium text-muted-foreground w-32" data-col="infohash">Info Hash</th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-14" data-col="availability">Avail.</th>
</tr>
</thead>
<tbody
id="torrents-table-body"
class="divide-y divide-border"
>
</tbody>
</table>
</div>

<!-- Bulk action bar (hidden until rows are selected) -->
<!-- Bulk selection: _checkedHashes Set tracks checked hashes; prepareBulkHashes() injects hidden inputs before submit -->
<div id="bulk-hashes-hidden" style="display:none"></div>
<div
id="bulk-action-bar"
class="hidden mt-2 flex items-center gap-2 rounded-lg border border-border bg-background px-3 py-2 shadow-md"
>
<span id="bulk-count" class="text-xs text-muted-foreground mr-2">0 selected</span>
for _, act := range []struct{ action, label, cls string }{
{"pause", "Pause", "bg-muted text-muted-foreground hover:bg-accent hover:text-foreground"},
{"resume", "Resume", "bg-muted text-muted-foreground hover:bg-accent hover:text-foreground"},
{"recheck", "Recheck", "bg-muted text-muted-foreground hover:bg-accent hover:text-foreground"},
{"reannounce", "Reannounce", "bg-muted text-muted-foreground hover:bg-accent hover:text-foreground"},
{"deleteWithFiles", "Delete+Files", "text-destructive border border-destructive/30 hover:bg-destructive hover:text-destructive-foreground"},
{"delete", "Delete", "text-destructive border border-destructive/30 hover:bg-destructive hover:text-destructive-foreground"},
} {
<button
hx-post={ p.BaseURL + "/ui/partials/torrents/action" }
hx-include="#bulk-hashes-hidden,[name='instance_id']"
hx-vals={ `{"action":"` + act.action + `"}` }
hx-target="#vt-data-slot"
hx-swap="innerHTML"
hx-on::before-request="prepareBulkHashes()"
hx-on::after-request="selectAll(false)"
class={ "rounded-md px-2.5 py-1 text-xs font-medium transition-colors", act.cls }
>
{ act.label }
</button>
}
<button
onclick="selectAll(false)"
class="ml-auto rounded-md px-2 py-1 text-xs text-muted-foreground hover:text-foreground transition-colors"
>
✕ Clear
</button>
</div>

<!-- Global status bar -->
<div
id="status-bar"
class="flex items-center justify-between rounded-lg border border-border bg-background/80 px-3 py-1.5 text-xs text-muted-foreground tabular-nums"
>
<div class="flex items-center gap-4">
<span id="sb-total">0 torrents</span>
<span id="sb-selected" class="hidden">0 selected</span>
</div>
<div class="flex items-center gap-4">
<span class="flex items-center gap-1 text-blue-600 dark:text-blue-400">
<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
<span id="sb-dl">0 B/s</span>
</span>
<span class="flex items-center gap-1 text-green-600 dark:text-green-400">
<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="17 14 12 9 7 14"/><line x1="12" y1="9" x2="12" y2="21"/></svg>
<span id="sb-up">0 B/s</span>
</span>
</div>
</div>
</div>

<!-- Right detail panel (shown when a torrent row is clicked) -->
<div
id="torrent-detail-outer"
style="display:none"
class="w-96 shrink-0 rounded-lg border border-border bg-background overflow-hidden flex flex-col"
>
<div id="torrent-detail-panel" class="h-full overflow-hidden flex flex-col">
<!-- Loaded via HTMX when a row is clicked -->
</div>
</div>
</div>
</div>

<!-- Context menu (positioned via JS) -->
<div
id="ctx-menu"
class="fixed z-50 hidden min-w-[12rem] rounded-lg border border-border bg-background shadow-xl py-1 text-sm"
@click.outside="document.getElementById('ctx-menu').classList.add('hidden')"
>
<button type="button" onclick="ctxAction('resume')" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">
<svg class="h-3.5 w-3.5 text-green-500" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg>Resume
</button>
<button type="button" onclick="ctxAction('pause')" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">
<svg class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>Pause
</button>
<button type="button" onclick="ctxAction('forceStart')" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">
<svg class="h-3.5 w-3.5 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13,2 3,14 12,14 11,22 21,10 12,10" fill="currentColor"/></svg>Force Start
</button>
<div class="my-1 border-t border-border"></div>
<button type="button" onclick="ctxAction('recheck')" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">
<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>Force Recheck
</button>
<button type="button" onclick="ctxAction('reannounce')" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">
<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>Reannounce
</button>
<button type="button" onclick="ctxAction('toggleSequentialDownload')" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">
<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="20" x2="12" y2="4"/><polyline points="6 10 12 4 18 10"/></svg>Toggle Sequential
</button>
<div class="my-1 border-t border-border"></div>
<!-- Priority submenu -->
<div class="relative" x-data="{ open: false, _timer: null }" @mouseenter="clearTimeout(_timer); _timer = setTimeout(() => open = true, 200)" @mouseleave="clearTimeout(_timer); open = false">
<button type="button" class="flex w-full items-center justify-between px-3 py-1.5 text-left hover:bg-accent transition-colors">
<span class="flex items-center gap-2"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>Queue</span>
<svg class="h-3 w-3 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
</button>
<div x-show="open" x-cloak class="absolute left-full top-0 ml-1 min-w-[10rem] rounded-lg border border-border bg-background shadow-xl py-1 z-50">
<button type="button" onclick="ctxAction('topPriority')" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">Move to Top</button>
<button type="button" onclick="ctxAction('increasePriority')" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">Move Up</button>
<button type="button" onclick="ctxAction('decreasePriority')" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">Move Down</button>
<button type="button" onclick="ctxAction('bottomPriority')" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">Move to Bottom</button>
</div>
</div>
<div class="my-1 border-t border-border"></div>
<button type="button" onclick="ctxShowCategoryDialog()" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">
<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>Set Category…
</button>
<button type="button" onclick="ctxShowTagDialog()" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">
<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>Tags…
</button>
<button type="button" onclick="ctxShowLocationDialog()" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">
<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>Set Location…
</button>
<button type="button" onclick="ctxShowLimitsDialog()" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">
<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>Set Limits…
</button>
<button type="button" onclick="ctxShowRenameDialog()" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">
<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5z"/></svg>Rename…
</button>
<div class="my-1 border-t border-border"></div>
<!-- Copy submenu -->
<div class="relative" x-data="{ open: false, _timer: null }" @mouseenter="clearTimeout(_timer); _timer = setTimeout(() => open = true, 200)" @mouseleave="clearTimeout(_timer); open = false">
<button type="button" class="flex w-full items-center justify-between px-3 py-1.5 text-left hover:bg-accent transition-colors">
<span class="flex items-center gap-2"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>Copy</span>
<svg class="h-3 w-3 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
</button>
<div x-show="open" x-cloak class="absolute left-full top-0 ml-1 min-w-[10rem] rounded-lg border border-border bg-background shadow-xl py-1 z-50">
<button type="button" onclick="ctxCopy('name')" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">Name</button>
<button type="button" onclick="ctxCopy('hash')" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">Hash</button>
<button type="button" onclick="ctxCopy('magnet')" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">Magnet Link</button>
</div>
</div>
<button type="button" onclick="ctxExport()" class="flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-accent transition-colors">
<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>Export .torrent
</button>
<div class="my-1 border-t border-border"></div>
<button type="button" onclick="ctxAction('delete')" class="flex w-full items-center gap-2 px-3 py-1.5 text-left text-destructive hover:bg-destructive hover:text-destructive-foreground transition-colors">
<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>Delete
</button>
<button type="button" onclick="ctxAction('deleteWithFiles')" class="flex w-full items-center gap-2 px-3 py-1.5 text-left text-destructive hover:bg-destructive hover:text-destructive-foreground transition-colors">
<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>Delete + Files
</button>
</div>

<!-- Set Category dialog -->
<div id="ctx-category-dialog" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-background/80 backdrop-blur-sm">
<div class="w-96 rounded-xl border border-border bg-background shadow-xl p-5 space-y-3" @click.outside="document.getElementById('ctx-category-dialog').classList.add('hidden')">
<h3 class="font-semibold text-sm">Set Category</h3>
<input id="ctx-category-input" type="text" autocomplete="off" placeholder="Filter or type category name…" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring" oninput="ctxFilterCategories()" onkeydown="ctxCategoryKeydown(event)"/>
<div id="ctx-category-listbox" class="hidden max-h-56 overflow-y-auto rounded-md border border-input bg-background text-sm"></div>
<div class="flex justify-end gap-2">
<button type="button" onclick="document.getElementById('ctx-category-dialog').classList.add('hidden')" class="rounded-md border border-input px-3 py-1.5 text-sm hover:bg-accent transition-colors">Cancel</button>
<button type="button" onclick="ctxSubmitCategory()" class="rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground hover:bg-primary/90">Apply</button>
</div>
</div>
</div>

<!-- Add/Remove Tags dialog -->
<div id="ctx-tags-dialog" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-background/80 backdrop-blur-sm">
<div class="w-80 rounded-xl border border-border bg-background shadow-xl p-5 space-y-4" @click.outside="document.getElementById('ctx-tags-dialog').classList.add('hidden')">
<h3 class="font-semibold text-sm">Manage Tags</h3>
<div class="space-y-2">
<label class="block text-xs font-medium text-muted-foreground">Add tags (comma-separated)</label>
<input id="ctx-add-tags-input" type="text" placeholder="tag1, tag2" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring" onkeydown="if(event.key==='Enter'){event.preventDefault();ctxSubmitTags();}"/>
</div>
<div class="space-y-2">
<label class="block text-xs font-medium text-muted-foreground">Remove tags (comma-separated)</label>
<input id="ctx-remove-tags-input" type="text" placeholder="tag-to-remove" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"/>
</div>
<div class="flex justify-end gap-2">
<button type="button" onclick="document.getElementById('ctx-tags-dialog').classList.add('hidden')" class="rounded-md border border-input px-3 py-1.5 text-sm hover:bg-accent transition-colors">Cancel</button>
<button type="button" onclick="ctxSubmitTags()" class="rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground hover:bg-primary/90">Apply</button>
</div>
</div>
</div>

<!-- Set Location dialog -->
<div id="ctx-location-dialog" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-background/80 backdrop-blur-sm">
<div class="w-96 rounded-xl border border-border bg-background shadow-xl p-5 space-y-4" @click.outside="document.getElementById('ctx-location-dialog').classList.add('hidden')">
<h3 class="font-semibold text-sm">Set Location</h3>
<input id="ctx-location-input" type="text" placeholder="/path/to/save" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring" onkeydown="if(event.key==='Enter'){event.preventDefault();ctxSubmitLocation();}"/>
<div class="flex justify-end gap-2">
<button type="button" onclick="document.getElementById('ctx-location-dialog').classList.add('hidden')" class="rounded-md border border-input px-3 py-1.5 text-sm hover:bg-accent transition-colors">Cancel</button>
<button type="button" onclick="ctxSubmitLocation()" class="rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground hover:bg-primary/90">Move</button>
</div>
</div>
</div>

<!-- Set Limits dialog -->
<div id="ctx-limits-dialog" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-background/80 backdrop-blur-sm">
<div class="w-96 rounded-xl border border-border bg-background shadow-xl p-5 space-y-4" @click.outside="document.getElementById('ctx-limits-dialog').classList.add('hidden')">
<h3 class="font-semibold text-sm">Set Speed &amp; Share Limits</h3>
<div class="grid grid-cols-2 gap-3">
<div><label class="block text-xs font-medium text-muted-foreground mb-1">Download (KiB/s)</label><input id="ctx-dl-limit" type="number" min="-1" placeholder="-1 = global" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"/></div>
<div><label class="block text-xs font-medium text-muted-foreground mb-1">Upload (KiB/s)</label><input id="ctx-ul-limit" type="number" min="-1" placeholder="-1 = global" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"/></div>
</div>
<div class="grid grid-cols-2 gap-3">
<div><label class="block text-xs font-medium text-muted-foreground mb-1">Ratio limit</label><input id="ctx-ratio-limit" type="number" step="0.1" min="-2" placeholder="-2 = global" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"/></div>
<div><label class="block text-xs font-medium text-muted-foreground mb-1">Seed time (min)</label><input id="ctx-seed-time-limit" type="number" min="-2" placeholder="-2 = global" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"/></div>
</div>
<div class="flex justify-end gap-2">
<button type="button" onclick="document.getElementById('ctx-limits-dialog').classList.add('hidden')" class="rounded-md border border-input px-3 py-1.5 text-sm hover:bg-accent transition-colors">Cancel</button>
<button type="button" onclick="ctxSubmitLimits()" class="rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground hover:bg-primary/90">Apply</button>
</div>
</div>
</div>

<!-- Rename dialog -->
<div id="ctx-rename-dialog" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-background/80 backdrop-blur-sm">
<div class="w-96 rounded-xl border border-border bg-background shadow-xl p-5 space-y-4" @click.outside="document.getElementById('ctx-rename-dialog').classList.add('hidden')">
<h3 class="font-semibold text-sm">Rename Torrent</h3>
<input id="ctx-rename-input" type="text" placeholder="New name" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring" onkeydown="if(event.key==='Enter'){event.preventDefault();ctxSubmitRename();}"/>
<div class="flex justify-end gap-2">
<button type="button" onclick="document.getElementById('ctx-rename-dialog').classList.add('hidden')" class="rounded-md border border-input px-3 py-1.5 text-sm hover:bg-accent transition-colors">Cancel</button>
<button type="button" onclick="ctxSubmitRename()" class="rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground hover:bg-primary/90">Rename</button>
</div>
</div>
</div>

<!-- Add Torrent dialog (Alpine.js modal) -->
<div
x-show="addOpen"
x-cloak
class="fixed inset-0 z-50 flex items-center justify-center bg-background/80 backdrop-blur-sm"
@keydown.escape.window="addOpen = false; addTab = 'file'; addAdv = false; useTmpPath = false;"
>
<div
class="w-full max-w-lg rounded-xl border border-border bg-background shadow-xl flex flex-col max-h-[90vh]"
@click.outside="addOpen = false; addTab = 'file'; addAdv = false; useTmpPath = false;"
>
<!-- Header -->
<div class="flex items-center justify-between px-5 py-4 border-b border-border shrink-0">
<h2 class="text-base font-semibold">Add Torrent</h2>
<button
@click="addOpen = false; addTab = 'file'; addAdv = false; useTmpPath = false;"
class="rounded-md p-1 text-muted-foreground hover:bg-accent transition-colors"
>
<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
</button>
</div>
<!-- Scrollable form body -->
<form
id="add-torrent-form"
hx-post={ p.BaseURL + "/ui/partials/torrents/add" }
hx-target="#vt-data-slot"
hx-swap="innerHTML"
hx-on::after-request="if(event.detail.successful){ addOpen = false; addTab = 'file'; addAdv = false; useTmpPath = false; document.getElementById('add-torrent-form').reset(); document.getElementById('add-file-lbl').textContent = 'No files selected'; }"
class="flex-1 overflow-y-auto px-5 py-4 space-y-4 min-h-0"
enctype="multipart/form-data"
>
<input type="hidden" name="instance_id" value={ itoa(p.InstanceID) }/>
<!-- Source tabs: File / URL -->
<div class="flex rounded-md bg-muted p-1 gap-1">
<button
type="button"
@click="addTab = 'file'"
:class="addTab === 'file' ? 'bg-background shadow-sm text-foreground font-medium' : 'text-muted-foreground hover:text-foreground'"
class="flex-1 rounded-sm px-3 py-1.5 text-sm transition-colors flex items-center justify-center gap-1.5"
>
<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
Upload File
</button>
<button
type="button"
@click="addTab = 'url'"
:class="addTab === 'url' ? 'bg-background shadow-sm text-foreground font-medium' : 'text-muted-foreground hover:text-foreground'"
class="flex-1 rounded-sm px-3 py-1.5 text-sm transition-colors flex items-center justify-center gap-1.5"
>
<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
URL / Magnet
</button>
</div>
<!-- File drop zone (visible when addTab === 'file') -->
<div x-show="addTab === 'file'">
<div
class="border-2 border-dashed border-border rounded-md p-6 text-center cursor-pointer transition-colors hover:border-primary/40 hover:bg-accent/30"
@click="document.getElementById('add-torrent-file-input').click()"
@dragover.prevent="$el.classList.add('border-primary','bg-accent/20')"
@dragleave.self="$el.classList.remove('border-primary','bg-accent/20')"
@drop.prevent="
const dt = new DataTransfer();
const inp = document.getElementById('add-torrent-file-input');
Array.from(inp.files || []).forEach(f => dt.items.add(f));
Array.from($event.dataTransfer.files).filter(f => f.name.endsWith('.torrent')).forEach(f => dt.items.add(f));
inp.files = dt.files;
$el.classList.remove('border-primary','bg-accent/20');
document.getElementById('add-file-lbl').textContent = dt.files.length + ' file(s) selected';
"
>
<svg class="h-8 w-8 mx-auto mb-2 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
<p class="text-sm font-medium">Drag &amp; drop .torrent files here</p>
<p class="text-xs text-muted-foreground mt-0.5">or click to browse · multiple files supported</p>
</div>
<input
id="add-torrent-file-input"
type="file"
name="torrentfile"
accept=".torrent"
multiple
class="hidden"
@change="document.getElementById('add-file-lbl').textContent = $event.target.files.length + ' file(s) selected'"
/>
<span id="add-file-lbl" class="text-xs text-muted-foreground mt-1 block">No files selected</span>
</div>
<!-- URL / magnet textarea (visible when addTab === 'url') -->
<div x-show="addTab === 'url'" x-cloak>
<label class="block text-xs font-medium text-muted-foreground mb-1">URLs / Magnet links (one per line)</label>
<textarea
name="urls"
rows="4"
placeholder="magnet:?xt=urn:btih:…&#10;https://example.com/file.torrent"
class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-ring resize-none"
></textarea>
</div>
<!-- Category + Tags -->
<div class="grid grid-cols-2 gap-3">
<div>
<label class="block text-xs font-medium text-muted-foreground mb-1">Category</label>
<input
type="text"
name="category"
list="add-dialog-categories"
class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
placeholder="none"
/>
if len(p.Categories) > 0 {
<datalist id="add-dialog-categories">
for _, cat := range p.Categories {
<option value={ cat }></option>
}
</datalist>
}
</div>
<div>
<label class="block text-xs font-medium text-muted-foreground mb-1">Tags (comma-separated)</label>
<input
type="text"
name="tags"
list="add-dialog-tags"
class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
placeholder="e.g. hd, seedbox"
/>
if len(p.Tags) > 0 {
<datalist id="add-dialog-tags">
for _, tag := range p.Tags {
<option value={ tag }></option>
}
</datalist>
}
</div>
</div>
<!-- Basic toggles -->
<div class="flex flex-wrap items-center gap-x-5 gap-y-2">
<label class="flex items-center gap-2 text-sm cursor-pointer select-none">
<input type="checkbox" name="paused" value="true" class="rounded"/> Start paused
</label>
<label class="flex items-center gap-2 text-sm cursor-pointer select-none">
<input type="checkbox" name="skip_hash_check" value="true" class="rounded"/> Skip hash check
</label>
</div>
<!-- Advanced options collapsible -->
<div>
<button
type="button"
@click="addAdv = !addAdv"
class="flex items-center gap-1.5 text-xs font-medium text-muted-foreground hover:text-foreground transition-colors w-full text-left"
>
<svg
class="h-3.5 w-3.5 transition-transform duration-150"
:class="addAdv ? 'rotate-90' : ''"
viewBox="0 0 24 24"
fill="none"
stroke="currentColor"
stroke-width="2.5"
><path d="M9 18l6-6-6-6"/></svg>
Advanced options
</button>
<div x-show="addAdv" x-cloak class="mt-3 space-y-3 pl-3 border-l border-border">
<!-- Auto TMM -->
<label class="flex items-center gap-2 text-sm cursor-pointer select-none">
<input type="checkbox" name="auto_tmm" value="true" class="rounded"/> Automatic Torrent Management
</label>
<!-- Save path -->
<div>
<label class="block text-xs font-medium text-muted-foreground mb-1">Save path</label>
<input
type="text"
name="savepath"
class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
placeholder="Leave empty for default"
/>
</div>
<!-- Temporary download path -->
<div class="space-y-2">
<label class="flex items-center gap-2 text-sm cursor-pointer select-none">
<input
type="checkbox"
name="use_download_path"
value="true"
class="rounded"
x-model="useTmpPath"
/> Use temporary download path
</label>
<input
type="text"
name="download_path"
:disabled="!useTmpPath"
class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring disabled:opacity-40 disabled:cursor-not-allowed"
placeholder="Temporary download path"
/>
</div>
<!-- Content layout + rename -->
<div class="grid grid-cols-2 gap-3">
<div>
<label class="block text-xs font-medium text-muted-foreground mb-1">Content layout</label>
<select
name="content_layout"
class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
>
<option value="">Use global setting</option>
<option value="Original">Original</option>
<option value="Subfolder">Create subfolder</option>
<option value="NoSubfolder">No subfolder</option>
</select>
</div>
<div>
<label class="block text-xs font-medium text-muted-foreground mb-1">Rename torrent</label>
<input
type="text"
name="rename"
class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
placeholder="Leave empty for original name"
/>
</div>
</div>
<!-- Sequential + first/last piece -->
<div class="flex flex-wrap items-center gap-x-5 gap-y-2">
<label class="flex items-center gap-2 text-sm cursor-pointer select-none">
<input type="checkbox" name="sequential_download" value="true" class="rounded"/> Sequential download
</label>
<label class="flex items-center gap-2 text-sm cursor-pointer select-none">
<input type="checkbox" name="first_last_piece_prio" value="true" class="rounded"/> First/last piece priority
</label>
</div>
<!-- Speed limits -->
<div class="grid grid-cols-2 gap-3">
<div>
<label class="block text-xs font-medium text-muted-foreground mb-1">Download limit (KiB/s)</label>
<input
type="number"
name="dl_limit"
min="0"
class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
placeholder="0 = unlimited"
/>
</div>
<div>
<label class="block text-xs font-medium text-muted-foreground mb-1">Upload limit (KiB/s)</label>
<input
type="number"
name="up_limit"
min="0"
class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
placeholder="0 = unlimited"
/>
</div>
</div>
<!-- Seeding limits -->
<div class="grid grid-cols-2 gap-3">
<div>
<label class="block text-xs font-medium text-muted-foreground mb-1">Ratio limit</label>
<input
type="number"
name="ratio_limit"
min="0"
step="0.1"
class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
placeholder="0 = use global"
/>
</div>
<div>
<label class="block text-xs font-medium text-muted-foreground mb-1">Seed time limit (min)</label>
<input
type="number"
name="seed_time_limit"
min="0"
class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
placeholder="0 = use global"
/>
</div>
</div>
</div>
</div>
</form>
<!-- Footer -->
<div class="flex justify-end gap-2 px-5 py-3 border-t border-border shrink-0">
<button
type="button"
@click="addOpen = false; addTab = 'file'; addAdv = false; useTmpPath = false;"
class="rounded-md border border-input px-4 py-2 text-sm hover:bg-accent transition-colors"
>Cancel</button>
<button
type="submit"
form="add-torrent-form"
class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
>Add Torrent</button>
</div>
</div>
</div>
</div>

<!-- Column defaults JSON (read by JS below; Go expressions can't appear inside <script> text) -->
@TorrentsColDefaults()
<!-- Virtual scroll + sort arrows + filter chips + expr builder JS -->
<script>
// ── Expr field definitions ──────────────────────────────────────────────────
var _ebSpeedUnits    = [ { label:'B/s', f:1 }, { label:'KB/s', f:1024 }, { label:'MB/s', f:1048576, dflt:true }, { label:'GB/s', f:1073741824 } ];
var _ebBytesUnits    = [ { label:'B', f:1 }, { label:'KB', f:1024 }, { label:'MB', f:1048576, dflt:true }, { label:'GB', f:1073741824 }, { label:'TB', f:1099511627776 } ];
var _ebDurationUnits = [ { label:'sec', f:1 }, { label:'min', f:60, dflt:true }, { label:'hr', f:3600 }, { label:'day', f:86400 }, { label:'week', f:604800 } ];
var _ebTimeAgoUnits  = [ { label:'s ago', ta:1 }, { label:'h ago', ta:3600, dflt:true }, { label:'d ago', ta:86400 }, { label:'w ago', ta:604800 }, { label:'mo ago', ta:2592000 } ];
var _exprFields = [
  { id: 'Name',          label: 'Name',           type: 'text' },
  { id: 'State',         label: 'State',          type: 'enum', values: ['downloading','uploading','stalledDL','stalledUP','pausedDL','pausedUP','stoppedDL','stoppedUP','error','missingFiles','checkingUP','checkingDL','forcedUP','forcedDL','metaDL','allocating','moving','queuedDL','queuedUP'] },
  { id: 'Category',      label: 'Category',       type: 'text' },
  { id: 'Tags',          label: 'Tags',           type: 'text' },
  { id: 'SavePath',      label: 'Save Path',      type: 'text' },
  { id: 'Tracker',       label: 'Tracker',        type: 'text' },
  { id: 'Ratio',         label: 'Ratio',          type: 'number' },
  { id: 'Progress',      label: 'Progress (0–1)', type: 'number' },
  { id: 'Priority',      label: 'Priority',       type: 'number' },
  { id: 'Availability',  label: 'Availability',   type: 'number' },
  { id: 'NumSeeds',      label: 'Seeds',          type: 'number' },
  { id: 'NumLeechs',     label: 'Leechers',       type: 'number' },
  { id: 'NumComplete',   label: 'Total Seeds',    type: 'number' },
  { id: 'NumIncomplete', label: 'Total Peers',    type: 'number' },
  { id: 'DlSpeed',       label: 'DL Speed',       type: 'number', units: _ebSpeedUnits },
  { id: 'UpSpeed',       label: 'UP Speed',       type: 'number', units: _ebSpeedUnits },
  { id: 'Size',          label: 'Size',           type: 'number', units: _ebBytesUnits },
  { id: 'TotalSize',     label: 'Total Size',     type: 'number', units: _ebBytesUnits },
  { id: 'Uploaded',      label: 'Uploaded',       type: 'number', units: _ebBytesUnits },
  { id: 'Downloaded',    label: 'Downloaded',     type: 'number', units: _ebBytesUnits },
  { id: 'AmountLeft',    label: 'Remaining',      type: 'number', units: _ebBytesUnits },
  { id: 'SeedingTime',   label: 'Seeding Time',   type: 'number', units: _ebDurationUnits },
  { id: 'TimeActive',    label: 'Time Active',    type: 'number', units: _ebDurationUnits },
  { id: 'AddedOn',       label: 'Added On',       type: 'number', units: _ebTimeAgoUnits },
];
var _exprOpsText   = ['contains','==','!=','startsWith','endsWith'];
var _exprOpsNumber = ['<','<=','>','>=','==','!='];
var _exprOpsEnum   = ['==','!='];
var _stateLabels   = {
  'downloading':'Downloading', 'uploading':'Seeding', 'stalledDL':'Stalled↓', 'stalledUP':'Stalled↑',
  'pausedDL':'Paused↓', 'pausedUP':'Paused↑', 'stoppedDL':'Stopped↓', 'stoppedUP':'Stopped↑',
  'error':'Error', 'missingFiles':'Missing Files', 'checkingUP':'Checking', 'checkingDL':'Checking',
  'forcedUP':'Forced UP', 'forcedDL':'Forced DL', 'metaDL':'Getting Metadata',
  'allocating':'Allocating', 'moving':'Moving', 'queuedDL':'Queued↓', 'queuedUP':'Queued↑',
};

// ── Expr builder state ─────────────────────────────────────────────────────
// Each item in _ebConditions is either:
//   cond:  { kind:'cond',  join, checked, fieldId, op, rawVal, unitIdx,
//            rangeOp, rawVal2, unitIdx2 }
//   group: { kind:'group', join, checked, conditions:[...cond...] }
// join is the connector placed BEFORE this item (ignored for idx 0).
var _ebConditions = [];
var _ebSortable   = null;
var _ebJoin       = 'and';
var _ebRangeOpen  = false;
var _ebEditPath   = null;   // null | { rootIdx, innerIdx } — innerIdx=null for root items

function ebSetJoin(j) {
  _ebJoin = j;
  var act = 'px-2 py-0.5 bg-primary text-primary-foreground';
  var off = 'px-2 py-0.5 bg-background text-muted-foreground hover:bg-accent hover:text-foreground transition-colors';
  var a = document.getElementById('eb-join-and'), o = document.getElementById('eb-join-or');
  if (a) a.className = j === 'and' ? act : off;
  if (o) o.className = j === 'or'  ? act : off;
}

function ebToggleRange() {
  _ebRangeOpen = !_ebRangeOpen;
  var row = document.getElementById('eb-range-row');
  var btn = document.getElementById('eb-range-btn');
  if (row) row.classList.toggle('hidden', !_ebRangeOpen);
  if (btn) {
    btn.classList.toggle('bg-accent',            _ebRangeOpen);
    btn.classList.toggle('text-foreground',       _ebRangeOpen);
    btn.classList.toggle('text-muted-foreground', !_ebRangeOpen);
  }
}

// ── Field / unit helpers ────────────────────────────────────────────────────
function _ebGetField(id)        { return _exprFields.find(function(f){ return f.id === id; }); }
function _ebGetUnit(field, idx) { return (field && field.units && idx >= 0) ? (field.units[idx] || null) : null; }

// _ebComputeVal: apply unit conversion to a raw string value.
function _ebComputeVal(rawVal, field, unitIdx) {
  var v = parseFloat(rawVal);
  if (isNaN(v)) return rawVal;
  var u = _ebGetUnit(field, unitIdx);
  if (!u) return v;
  if (u.ta) return Math.floor(Date.now() / 1000) - v * u.ta;  // time-ago → unix ts
  return (u.f && u.f !== 1) ? Math.round(v * u.f) : v;
}

function _ebBuildAtom(field, op, computedVal) {
  var s = String(computedVal);
  if (op === 'contains')   return field.id + ' contains "'   + s + '"';
  if (op === 'startsWith') return field.id + ' startsWith "' + s + '"';
  if (op === 'endsWith')   return field.id + ' endsWith "'   + s + '"';
  if (field.type === 'text' || field.type === 'enum') return field.id + ' ' + op + ' "' + s + '"';
  return field.id + ' ' + op + ' ' + s;
}

// _ebCondToExpr: serialize a cond or group to expr string.
function _ebCondToExpr(c) {
  if (c.kind === 'group') {
    var inner = c.conditions.map(function(cc, i) {
      return (i === 0 ? '' : (cc.join === 'or' ? ' || ' : ' && ')) + _ebCondToExpr(cc);
    }).join('');
    return '(' + inner + ')';
  }
  var field = _ebGetField(c.fieldId);
  if (!field) return '';
  var v1 = _ebComputeVal(c.rawVal, field, c.unitIdx);
  var e1 = _ebBuildAtom(field, c.op, v1);
  if (c.rangeOp && c.rawVal2 !== '') {
    var uIdx2 = c.unitIdx2 >= 0 ? c.unitIdx2 : c.unitIdx;
    var v2    = _ebComputeVal(c.rawVal2, field, uIdx2);
    return '(' + e1 + ' && ' + _ebBuildAtom(field, c.rangeOp, v2) + ')';
  }
  return e1;
}

// _ebCondLabel: human-readable label for staged-row display.
function _ebCondLabel(c) {
  if (c.kind === 'group') return '( ' + c.conditions.length + ' conditions )';
  var field = _ebGetField(c.fieldId);
  if (!field) return c.rawVal || '';
  var u1  = _ebGetUnit(field, c.unitIdx);
  var lbl = field.label + ' ' + c.op + ' ' + c.rawVal + (u1 ? '\u202f' + u1.label : '');
  if (c.rangeOp && c.rawVal2 !== '') {
    var uIdx2 = c.unitIdx2 >= 0 ? c.unitIdx2 : c.unitIdx;
    var u2    = _ebGetUnit(field, uIdx2);
    lbl += ' and ' + c.rangeOp + ' ' + c.rawVal2 + (u2 ? '\u202f' + u2.label : '');
  }
  return lbl;
}

// ── Builder init + field-change ─────────────────────────────────────────────
function initExprBuilder() {
  var sel = document.getElementById('eb-field');
  if (!sel || sel.options.length > 0) return;
  sel.innerHTML = _exprFields.map(function(f){ return '<option value="'+f.id+'">'+f.label+'</option>'; }).join('');
  exprBuilderFieldChanged();
}

// _ebValInput: input + optional unit select for a field.
function _ebValInput(valId, unitId, field) {
  var cls   = 'h-7 rounded-md border border-input bg-background px-2 text-xs focus:outline-none focus:ring-1 focus:ring-ring';
  var enter = 'onkeydown="if(event.key===\'Enter\'){event.preventDefault();ebStageAdd();}"';
  if (field.type === 'enum') {
    return '<select id="'+valId+'" class="'+cls+'">'+
      field.values.map(function(v){ return '<option value="'+v+'">'+(_stateLabels[v]||v)+'</option>'; }).join('')+'</select>';
  }
  var hasUnits = field.type === 'number' && field.units && field.units.length;
  var wCls  = hasUnits ? 'w-16' : 'w-24';
  var tAttr = field.type === 'number' ? 'type="number" step="any"' : 'type="text"';
  var html  = '<input id="'+valId+'" '+tAttr+' placeholder="value" '+enter+' class="'+cls+' '+wCls+'"/>';
  if (hasUnits) {
    html += '<select id="'+unitId+'" class="'+cls+' ml-1">';
    field.units.forEach(function(u, i) {
      html += '<option value="'+i+'"'+(u.dflt ? ' selected' : '')+'>'+u.label+'</option>';
    });
    html += '</select>';
  }
  return html;
}

function exprBuilderFieldChanged() {
  var sel = document.getElementById('eb-field');
  if (!sel) return;
  var field = _ebGetField(sel.value);
  if (!field) return;
  var opSel  = document.getElementById('eb-op'),  opSel2  = document.getElementById('eb-op2');
  var valC   = document.getElementById('eb-val-container'), val2C = document.getElementById('eb-val2-container');
  if (!opSel || !valC) return;
  var ops    = field.type === 'number' ? _exprOpsNumber : field.type === 'enum' ? _exprOpsEnum : _exprOpsText;
  var opOpts = ops.map(function(o){ return '<option value="'+o+'">'+o+'</option>'; }).join('');
  opSel.innerHTML = opOpts;
  if (opSel2) opSel2.innerHTML = opOpts;
  valC.innerHTML  = _ebValInput('eb-val',  'eb-unit',  field);
  if (val2C) val2C.innerHTML = _ebValInput('eb-val2', 'eb-unit2', field);
}

// ── Stage: add / update ─────────────────────────────────────────────────────
function _ebReadInputs() {
  var fieldSel = document.getElementById('eb-field');
  var opSel    = document.getElementById('eb-op');
  var valEl    = document.getElementById('eb-val');
  var unitSel  = document.getElementById('eb-unit');
  if (!fieldSel || !opSel || !valEl) return null;
  var field = _ebGetField(fieldSel.value);
  if (!field) return null;
  var val = valEl.value.trim();
  if (val === '') return null;
  var unitIdx = unitSel ? parseInt(unitSel.value, 10) : -1;
  var rangeOp = null, rawVal2 = '', unitIdx2 = -1;
  if (_ebRangeOpen) {
    var op2Sel   = document.getElementById('eb-op2');
    var val2El   = document.getElementById('eb-val2');
    var unit2Sel = document.getElementById('eb-unit2');
    if (op2Sel && val2El && val2El.value.trim() !== '') {
      rangeOp  = op2Sel.value;
      rawVal2  = val2El.value.trim();
      unitIdx2 = unit2Sel ? parseInt(unit2Sel.value, 10) : unitIdx;
    }
  }
  return { kind:'cond', join:_ebJoin, checked:false,
    fieldId:fieldSel.value, op:opSel.value,
    rawVal:val, unitIdx:unitIdx,
    rangeOp:rangeOp, rawVal2:rawVal2, unitIdx2:unitIdx2 };
}

function ebStageAdd() {
  var c = _ebReadInputs();
  if (!c) return;
  if (_ebEditPath !== null) {
    var ep     = _ebEditPath;
    var target = ep.innerIdx !== null
      ? _ebConditions[ep.rootIdx].conditions[ep.innerIdx]
      : _ebConditions[ep.rootIdx];
    c.join = target.join;   // preserve existing connector
    if (ep.innerIdx !== null) _ebConditions[ep.rootIdx].conditions[ep.innerIdx] = c;
    else _ebConditions[ep.rootIdx] = c;
    _ebEditPath = null;
    var addBtn = document.getElementById('eb-add-btn'); if (addBtn) addBtn.textContent = '+ Add';
    var cancel = document.getElementById('eb-cancel-edit'); if (cancel) cancel.classList.add('hidden');
  } else {
    _ebConditions.push(c);
  }
  document.getElementById('eb-val').value = '';
  var v2 = document.getElementById('eb-val2'); if (v2) v2.value = '';
  ebRenderConditions();
}

// ── Edit existing condition ─────────────────────────────────────────────────
function ebEditCond(rootIdx, innerIdx) {
  var c = innerIdx !== null
    ? _ebConditions[rootIdx].conditions[innerIdx]
    : _ebConditions[rootIdx];
  if (!c || c.kind !== 'cond') return;
  _ebEditPath = { rootIdx:rootIdx, innerIdx:innerIdx };

  var fieldSel = document.getElementById('eb-field');
  if (fieldSel) { fieldSel.value = c.fieldId; exprBuilderFieldChanged(); }
  var opSel = document.getElementById('eb-op');  if (opSel) opSel.value = c.op;
  var valEl = document.getElementById('eb-val'); if (valEl) valEl.value = c.rawVal;
  var uSel  = document.getElementById('eb-unit'); if (uSel && c.unitIdx >= 0) uSel.value = c.unitIdx;

  if (c.rangeOp) {
    if (!_ebRangeOpen) ebToggleRange();
    var op2  = document.getElementById('eb-op2');   if (op2)  op2.value  = c.rangeOp;
    var val2 = document.getElementById('eb-val2');  if (val2) val2.value = c.rawVal2;
    var u2   = document.getElementById('eb-unit2'); if (u2 && c.unitIdx2 >= 0) u2.value = c.unitIdx2;
  } else {
    if (_ebRangeOpen) ebToggleRange();
  }
  var addBtn = document.getElementById('eb-add-btn'); if (addBtn) addBtn.textContent = '\u2713 Update';
  var cancel = document.getElementById('eb-cancel-edit'); if (cancel) cancel.classList.remove('hidden');
}

function ebCancelEdit() {
  _ebEditPath = null;
  var addBtn = document.getElementById('eb-add-btn'); if (addBtn) addBtn.textContent = '+ Add';
  var cancel = document.getElementById('eb-cancel-edit'); if (cancel) cancel.classList.add('hidden');
}

// ── Render staged conditions ────────────────────────────────────────────────
function ebRenderConditions() {
  var list     = document.getElementById('eb-conditions');
  var footer   = document.getElementById('eb-footer');
  var groupBtn = document.getElementById('eb-group-btn');
  if (!list) return;

  var checkedCount = _ebConditions.filter(function(c){ return c.checked; }).length;
  if (groupBtn) groupBtn.classList.toggle('hidden', checkedCount < 2);
  if (footer)   footer.classList.toggle('hidden', _ebConditions.length === 0);

  var JAC = 'inline-flex h-5 px-1.5 rounded-l text-[10px] font-semibold cursor-pointer select-none transition-colors';
  var JOC = 'inline-flex h-5 px-1.5 rounded-r text-[10px] font-semibold cursor-pointer select-none transition-colors';

  function joinPill(item, ri, ii) {
    var isOr  = item.join === 'or';
    var iiArg = ii !== null ? ',' + ii : ',null';
    return '<div class="inline-flex rounded border border-border overflow-hidden shrink-0">'
      + '<button type="button" class="'+JAC+(isOr  ? ' bg-muted text-muted-foreground' : ' bg-primary text-primary-foreground')+'" onclick="ebToggleJoin('+ri+iiArg+',\'and\')">AND</button>'
      + '<button type="button" class="'+JOC+(!isOr ? ' bg-muted text-muted-foreground' : ' bg-primary text-primary-foreground')+'" onclick="ebToggleJoin('+ri+iiArg+',\'or\')">OR</button>'
      + '</div>';
  }

  function condRow(c, ri, ii) {
    var inGroup  = ii !== null;
    var showJoin = inGroup ? ii > 0 : ri > 0;
    var join     = showJoin ? joinPill(c, ri, inGroup ? ii : null) : '';
    var iiArg    = ii !== null ? ii : 'null';
    var lbl      = _escHtml(_ebCondLabel(c));
    return '<li class="eb-cond-row flex items-center gap-1 rounded bg-muted/40 px-1.5 py-0.5'+(inGroup ? ' ml-2' : '')+'">'
      + '<span class="cursor-grab text-muted-foreground shrink-0">\u2807</span>'
      + (!inGroup ? '<input type="checkbox" class="shrink-0 rounded"'+(c.checked ? ' checked' : '')+' onchange="ebToggleCheck('+ri+')" />' : '')
      + join
      + '<code class="flex-1 text-xs font-mono truncate min-w-0 mx-0.5" title="'+lbl+'">'+lbl+'</code>'
      + '<button type="button" onclick="ebEditCond('+ri+','+iiArg+')" class="shrink-0 text-muted-foreground hover:text-foreground transition-colors text-xs" title="Edit">\u270e</button>'
      + '<button type="button" onclick="ebRemoveCond('+ri+','+iiArg+')" class="shrink-0 text-muted-foreground hover:text-destructive transition-colors text-sm leading-none" title="Remove">\u00d7</button>'
      + '</li>';
  }

  list.innerHTML = _ebConditions.map(function(c, i) {
    if (c.kind === 'group') {
      var gJoin  = i > 0 ? joinPill(c, i, null) : '';
      var inner  = c.conditions.map(function(cc, j){ return condRow(cc, i, j); }).join('');
      return '<li class="eb-cond-row list-none rounded border border-border/60 bg-muted/20 p-1" data-root="'+i+'">'
        + '<div class="flex items-center gap-1 mb-0.5">'
        + '<span class="cursor-grab text-muted-foreground shrink-0">\u2807</span>'
        + '<input type="checkbox" class="shrink-0 rounded"'+(c.checked ? ' checked' : '')+' onchange="ebToggleCheck('+i+')" />'
        + gJoin
        + '<span class="text-[10px] text-muted-foreground flex-1 ml-0.5">Group ('+c.conditions.length+')</span>'
        + '<button type="button" onclick="ebUngroupAt('+i+')" class="text-[10px] text-muted-foreground hover:text-foreground transition-colors" title="Ungroup">\u21b1 ungroup</button>'
        + '<button type="button" onclick="ebRemoveCond('+i+',null)" class="shrink-0 text-muted-foreground hover:text-destructive transition-colors text-sm leading-none ml-1">\u00d7</button>'
        + '</div>'
        + '<ol class="eb-group-inner space-y-0.5 list-none" data-gidx="'+i+'">'+inner+'</ol>'
        + '</li>';
    }
    return condRow(c, i, null);
  }).join('');

  // Root Sortable.
  if (_ebSortable) { _ebSortable.destroy(); _ebSortable = null; }
  if (_ebConditions.length > 1 && window.Sortable) {
    _ebSortable = Sortable.create(list, {
      animation: 120, handle: '.eb-cond-row', ghostClass: 'opacity-40',
      onEnd: function(evt) {
        if (evt.oldIndex === evt.newIndex) return;
        var moved = _ebConditions.splice(evt.oldIndex, 1)[0];
        _ebConditions.splice(evt.newIndex, 0, moved);
        ebRenderConditions();
      },
    });
  }
  // Per-group inner Sortables.
  list.querySelectorAll('.eb-group-inner').forEach(function(el) {
    var gIdx = parseInt(el.dataset.gidx, 10);
    if (!window.Sortable || !_ebConditions[gIdx] || _ebConditions[gIdx].conditions.length < 2) return;
    Sortable.create(el, {
      animation: 120, handle: '.eb-cond-row', ghostClass: 'opacity-40',
      onEnd: function(evt) {
        if (evt.oldIndex === evt.newIndex) return;
        var grp   = _ebConditions[gIdx].conditions;
        var moved = grp.splice(evt.oldIndex, 1)[0];
        grp.splice(evt.newIndex, 0, moved);
        ebRenderConditions();
      },
    });
  });
}

// ── Mutation helpers ────────────────────────────────────────────────────────
function ebToggleJoin(rootIdx, innerIdx, j) {
  var t = (innerIdx !== null && _ebConditions[rootIdx])
    ? _ebConditions[rootIdx].conditions[innerIdx]
    : _ebConditions[rootIdx];
  if (t) { t.join = j; ebRenderConditions(); }
}

function ebRemoveCond(rootIdx, innerIdx) {
  if (innerIdx !== null) {
    _ebConditions[rootIdx].conditions.splice(innerIdx, 1);
    if (_ebConditions[rootIdx].conditions.length === 0) _ebConditions.splice(rootIdx, 1);
  } else {
    _ebConditions.splice(rootIdx, 1);
  }
  ebRenderConditions();
}

function ebToggleCheck(rootIdx) {
  if (_ebConditions[rootIdx]) { _ebConditions[rootIdx].checked = !_ebConditions[rootIdx].checked; ebRenderConditions(); }
}

function ebGroupChecked() {
  var idxs = [];
  _ebConditions.forEach(function(c, i){ if (c.checked) idxs.push(i); });
  if (idxs.length < 2) return;
  var kids = idxs.map(function(i){ return Object.assign({}, _ebConditions[i], { checked:false }); });
  var groupJoin = kids[0].join; kids[0].join = 'and';
  var group = { kind:'group', join:groupJoin, checked:false, conditions:kids };
  var at = idxs[0];
  for (var i = idxs.length - 1; i >= 0; i--) _ebConditions.splice(idxs[i], 1);
  _ebConditions.splice(at, 0, group);
  ebRenderConditions();
}

function ebUngroupAt(rootIdx) {
  var g = _ebConditions[rootIdx];
  if (!g || g.kind !== 'group') return;
  var kids = g.conditions.map(function(c){ return Object.assign({}, c, {checked:false}); });
  if (kids.length) kids[0].join = g.join;
  [].splice.apply(_ebConditions, [rootIdx, 1].concat(kids));
  ebRenderConditions();
}

function ebClearAll() {
  _ebConditions = [];
  ebCancelEdit();
  ebRenderConditions();
}

// ebCommit — serialize staged list → #current-expr and fire refresh.
function ebCommit() {
  if (_ebConditions.length === 0) return;
  var built = _ebConditions.map(function(c, i) {
    return (i === 0 ? '' : (c.join === 'or' ? ' || ' : ' && ')) + _ebCondToExpr(c);
  }).join('');
  var exprEl = document.getElementById('current-expr');
  if (!exprEl) return;
  var prev = exprEl.value.trim();
  exprEl.value = (prev && prev !== built) ? '(' + prev + ') && (' + built + ')' : built;
  _ebConditions = []; ebCancelEdit(); ebRenderConditions();
  renderFilterChips(); triggerTableRefresh();
}

// ── Filter chips ────────────────────────────────────────────────────────────
function _escHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function renderFilterChips() {
  var chips = document.getElementById('filter-chips');
  if (!chips) return;
  var status   = (document.getElementById('current-status')   || {value:''}).value || '';
  var category = (document.getElementById('current-category') || {value:''}).value || '';
  var tag      = (document.getElementById('current-tag')      || {value:''}).value || '';
  var tracker  = (document.getElementById('current-tracker')  || {value:''}).value || '';
  var savepath = (document.getElementById('current-savepath') || {value:''}).value || '';
  var search   = (document.getElementById('torrents-search')  || {value:''}).value || '';
  var expr     = (document.getElementById('current-expr')     || {value:''}).value || '';
  var parts = [];
  if (status)   parts.push({ label: 'State == "' + (_stateLabels[status] || status) + '"', rawLabel: 'State == "' + status + '"', clear: 'status' });
  if (category) {
    var cats = category.split(',');
    if (cats.length === 1) {
      parts.push({ label: 'Category == "' + category + '"', clear: 'category' });
    } else {
      parts.push({ label: 'Category in [' + cats.join(', ') + ']', clear: 'category' });
    }
  }
  if (tag) {
    var tags = tag.split(',');
    if (tags.length === 1) {
      parts.push({ label: 'Tags contains "' + tag + '"', clear: 'tag' });
    } else {
      parts.push({ label: 'Tags in [' + tags.join(', ') + ']', clear: 'tag' });
    }
  }
  if (tracker) {
    var trks = tracker.split(',');
    if (trks.length === 1) {
      parts.push({ label: 'Tracker == "' + tracker + '"', clear: 'tracker' });
    } else {
      parts.push({ label: 'Tracker in [' + trks.join(', ') + ']', clear: 'tracker' });
    }
  }
  if (savepath) {
    var sps = savepath.split(',');
    if (sps.length === 1) {
      parts.push({ label: 'SavePath == "' + savepath + '"', clear: 'savepath' });
    } else {
      parts.push({ label: 'SavePath in [' + sps.join(', ') + ']', clear: 'savepath' });
    }
  }
  if (search)   parts.push({ label: 'Name ~ "' + search + '"', clear: 'search' });
  if (expr)     parts.push({ label: expr.length>50 ? expr.substring(0,50)+'…' : expr, title: expr, clear: 'expr' });
  chips.innerHTML = parts.map(function(p) {
    return '<span class="inline-flex items-center gap-1 rounded-full bg-primary/10 text-primary text-xs px-2 py-0.5 font-medium font-mono" title="'+ _escHtml(p.title||p.label) +'">' +
      '<span>'+_escHtml(p.label)+'</span>' +
      '<button type="button" onclick="clearFilter(\''+p.clear+'\')" class="ml-0.5 text-primary/70 hover:text-primary leading-none" aria-label="Remove filter">\xd7</button>' +
      '</span>';
  }).join('');
}

function clearFilter(type) {
  var map = { status:'current-status', category:'current-category', tag:'current-tag', tracker:'current-tracker', savepath:'current-savepath', search:'torrents-search', expr:'current-expr' };
  var el = document.getElementById(map[type]);
  if (el) el.value = '';
  // Invalidate the matching sidebar list so "All" gets re-highlighted
  var sidebarKey = { category:'cats', tag:'tags', tracker:'trackers', savepath:'savepaths' }[type];
  if (sidebarKey && _vtSidebarLists[sidebarKey]) {
    _vtSidebarLists[sidebarKey].invalidate();
    _vtSidebarLists[sidebarKey].render();
  }
  renderFilterChips();
  triggerTableRefresh();
}

function triggerTableRefresh() {
  var btn = document.getElementById('sort-trigger');
  // Dispatch 'tbl-refresh' (custom event) rather than 'click' so it does NOT
  // bubble as a DOM click — that would close Alpine @click.outside popovers
  // like the expression builder while the user is still adding conditions.
  if (btn && window.htmx) htmx.trigger(btn, 'tbl-refresh');
}

// ── Sidebar filter lists ─────────────────────────────────────────────────────
// Sidebar sections are derived entirely from _vtList.rows so they auto-refresh
// on every SSE-driven data swap. Each section supports:
//   - A filter input to narrow the visible items
//   - Multi-select via Ctrl+Click (toggle) or Shift+Click (range)
//   - VirtualList for efficient rendering of large lists

var _vtSidebarLists = {};
var _vtSidebarCounts = {};
var _vtSidebarAllItems = {}; // { cats: ['', 'cat1', ...], tags: [...], ... }

// Sidebar section config: key -> { sectionId, scrollId, ulId, filterInputId, filterType, inputId }
var _sidebarCfg = {
  cats:      { sectionId: 'vt-sidebar-cats-section',      scrollId: 'vt-cat-scroll',      ulId: 'vt-sidebar-cats',      filterInputId: 'vt-cat-filter',      filterType: 'category', inputId: 'current-category' },
  tags:      { sectionId: 'vt-sidebar-tags-section',      scrollId: 'vt-tag-scroll',      ulId: 'vt-sidebar-tags',      filterInputId: 'vt-tag-filter',      filterType: 'tag',      inputId: 'current-tag' },
  trackers:  { sectionId: 'vt-sidebar-trackers-section',  scrollId: 'vt-tracker-scroll',  ulId: 'vt-sidebar-trackers',  filterInputId: 'vt-tracker-filter',  filterType: 'tracker',  inputId: 'current-tracker' },
  savepaths: { sectionId: 'vt-sidebar-savepaths-section', scrollId: 'vt-savepath-scroll', ulId: 'vt-sidebar-savepaths', filterInputId: 'vt-savepath-filter', filterType: 'savepath', inputId: 'current-savepath' },
};

// _lastSidebarClickIdx tracks the last-clicked item index per section for Shift+Click range select.
var _lastSidebarClickIdx = {};

function _computeSidebarCounts() {
  var counts = { category: {}, tag: {}, tracker: {}, savepath: {} };
  if (!_vtList) return counts;
  var rows = _vtList.rows || [];
  for (var i = 0; i < rows.length; i++) {
    var r = rows[i];
    var cat = r.Category || '';
    counts.category[cat] = (counts.category[cat] || 0) + 1;
    if (r.Tags) {
      var tgs = r.Tags.split(',');
      for (var j = 0; j < tgs.length; j++) {
        var tg = tgs[j].trim();
        if (tg) counts.tag[tg] = (counts.tag[tg] || 0) + 1;
      }
    }
    var tr = _extractTrackerDomain(r.Tracker);
    counts.tracker[tr] = (counts.tracker[tr] || 0) + 1;
    var sp = r.SavePath || '';
    counts.savepath[sp] = (counts.savepath[sp] || 0) + 1;
  }
  _vtSidebarCounts = counts;
  return counts;
}

// _extractTrackerDomain extracts the full hostname from a tracker URL,
// matching the server-side ExtractDomainFromURL behaviour (e.g.
// "http://tracker.example.com:8080/announce" → "tracker.example.com").
function _extractTrackerDomain(url) {
  if (!url) return '';
  try { return new URL(url).hostname.toLowerCase(); } catch(e) { return url; }
}

// _extractSidebarItems derives sorted unique items from _vtList.rows for each section.
function _extractSidebarItems() {
  var cats = {}, tags = {}, trackers = {}, savepaths = {};
  if (_vtList) {
    var rows = _vtList.rows || [];
    for (var i = 0; i < rows.length; i++) {
      var r = rows[i];
      if (r.Category) cats[r.Category] = 1;
      if (r.Tags) {
        var tgs = r.Tags.split(',');
        for (var j = 0; j < tgs.length; j++) {
          var tg = tgs[j].trim();
          if (tg) tags[tg] = 1;
        }
      }
      var dom = _extractTrackerDomain(r.Tracker);
      if (dom) trackers[dom] = 1;
      if (r.SavePath) savepaths[r.SavePath] = 1;
    }
  }
  _vtSidebarAllItems.cats      = [''].concat(Object.keys(cats).sort());
  _vtSidebarAllItems.tags      = [''].concat(Object.keys(tags).sort());
  _vtSidebarAllItems.trackers  = [''].concat(Object.keys(trackers).sort());
  _vtSidebarAllItems.savepaths = [''].concat(Object.keys(savepaths).sort());
}

// _getActiveSet returns the Set of currently selected values for a hidden input.
function _getActiveSet(inputId) {
  var el = document.getElementById(inputId);
  var val = el ? el.value : '';
  if (!val) return new Set();
  return new Set(val.split(',').map(function(s){ return s.trim(); }).filter(Boolean));
}

// _setActiveValues writes selected values back to the hidden input as comma-separated.
function _setActiveValues(inputId, values) {
  var el = document.getElementById(inputId);
  if (el) el.value = Array.from(values).join(',');
}

function initSidebars() {
  _computeSidebarCounts();
  _extractSidebarItems();

  for (var key in _sidebarCfg) {
    _initSidebarSection(key);
  }
}

function _initSidebarSection(key) {
  var cfg = _sidebarCfg[key];
  var section = document.getElementById(cfg.sectionId);
  if (!section) return;
  var allItems = _vtSidebarAllItems[key] || [''];
  // Hide if only the "All" placeholder exists
  if (allItems.length <= 1) { section.classList.add('hidden'); return; }
  section.classList.remove('hidden');
  // Apply text filter
  var filterEl = document.getElementById(cfg.filterInputId);
  var q = filterEl ? filterEl.value.toLowerCase() : '';
  var items = q ? allItems.filter(function(v){ return v === '' || v.toLowerCase().indexOf(q) !== -1; }) : allItems;

  var makeItem = function(val) { return _makeSidebarBtn(val, cfg.filterType, cfg.inputId, key, items); };
  if (_vtSidebarLists[key]) {
    _vtSidebarLists[key]._renderRow = makeItem;
    // Avoid full DOM teardown if items haven't changed — just refresh
    // rendered buttons (counts / active state) via invalidate + render.
    var prev = _vtSidebarLists[key].rows;
    var changed = prev.length !== items.length;
    if (!changed) {
      for (var ci = 0; ci < items.length; ci++) {
        if (items[ci] !== prev[ci]) { changed = true; break; }
      }
    }
    if (changed) {
      _vtSidebarLists[key].load(items);
    } else {
      _vtSidebarLists[key].invalidate();
      _vtSidebarLists[key].render();
    }
    return;
  }
  _vtSidebarLists[key] = new VirtualList({
    containerId : cfg.scrollId,
    tbodyId     : cfg.ulId,
    rowTag      : 'li',
    colSpan     : 1,
    renderRow   : makeItem,
    emptyText   : '',
    rowHeight   : 29,
  });
  _vtSidebarLists[key].load(items);
}

// _filterSidebar is called by the filter input's oninput handler.
function _filterSidebar(key) {
  _initSidebarSection(key);
}

function _makeSidebarBtn(val, filterType, inputId, listKey, itemList) {
  var label   = val || 'All';
  var activeSet = _getActiveSet(inputId);
  // "All" is active when nothing is selected
  var isActive = val === '' ? activeSet.size === 0 : activeSet.has(val);
  var li = document.createElement('li');
  li.style.listStyle = 'none';
  var btn = document.createElement('button');
  btn.type = 'button';
  btn.title = label;
  btn.className = 'w-full text-left px-2 py-1 rounded-md transition-colors flex items-center justify-between gap-1 min-w-0 ' +
    (isActive ? 'bg-primary/10 text-primary font-medium' : 'text-muted-foreground hover:bg-accent hover:text-foreground');
  var labelSpan = document.createElement('span');
  labelSpan.className = 'truncate min-w-0';
  labelSpan.textContent = label;
  btn.appendChild(labelSpan);
  // Count badge
  var counts = _vtSidebarCounts[filterType] || {};
  var count = val === '' ? (_vtList ? _vtList.rows.length : 0) : (counts[val] || 0);
  if (count > 0) {
    var badge = document.createElement('span');
    badge.className = 'shrink-0 tabular-nums text-xs ' + (isActive ? 'text-primary/70' : 'text-muted-foreground/60');
    badge.textContent = count;
    btn.appendChild(badge);
  }
  btn.addEventListener('click', function(e) {
    if (val === '') {
      // "All" clears all selections
      _setActiveValues(inputId, new Set());
      _lastSidebarClickIdx[listKey] = -1;
    } else if (e.shiftKey && _lastSidebarClickIdx[listKey] >= 0 && itemList) {
      // Shift+Click: range select from last clicked to current
      var curIdx = itemList.indexOf(val);
      if (curIdx >= 0) {
        var lo = Math.min(_lastSidebarClickIdx[listKey], curIdx);
        var hi = Math.max(_lastSidebarClickIdx[listKey], curIdx);
        var s = _getActiveSet(inputId);
        for (var ri = lo; ri <= hi; ri++) {
          if (itemList[ri] !== '') s.add(itemList[ri]);
        }
        _setActiveValues(inputId, s);
      }
    } else if (e.ctrlKey || e.metaKey) {
      // Ctrl/Cmd+Click: toggle individual item
      var s = _getActiveSet(inputId);
      if (s.has(val)) { s.delete(val); } else { s.add(val); }
      _setActiveValues(inputId, s);
    } else {
      // Plain click: single select (replaces selection)
      _setActiveValues(inputId, new Set([val]));
    }
    _lastSidebarClickIdx[listKey] = itemList ? itemList.indexOf(val) : -1;
    // Re-render sidebar to update highlights
    var list = _vtSidebarLists[listKey];
    if (list) { list.invalidate(); list.render(); }
    triggerTableRefresh();
    renderFilterChips();
  });
  li.appendChild(btn);
  return li;
}

// ── Context menu ─────────────────────────────────────────────────────────────
var _ctxHash = '';
var _ctxName = '';
var _ctxSavePath = '';
var _ctxCategory = '';
var _ctxTags = '';

function showContextMenu(e, t) {
  e.preventDefault();
  _ctxHash     = t.Hash || t.InfohashV1 || t.InfohashV2 || '';
  _ctxName     = t.Name || '';
  _ctxSavePath = t.SavePath || '';
  _ctxCategory = t.Category || '';
  _ctxTags     = t.Tags || '';
  var menu = document.getElementById('ctx-menu');
  if (!menu) return;
  menu.classList.remove('hidden');
  // Position near cursor, clamped to viewport.
  var mx = e.clientX, my = e.clientY;
  menu.style.left = '0'; menu.style.top = '0'; // reset for measurement
  var mw = menu.offsetWidth, mh = menu.offsetHeight;
  var vw = window.innerWidth, vh = window.innerHeight;
  if (mx + mw > vw) mx = vw - mw - 4;
  if (my + mh > vh) my = vh - mh - 4;
  if (mx < 0) mx = 4;
  if (my < 0) my = 4;
  menu.style.left = mx + 'px';
  menu.style.top  = my + 'px';
}

function _hideCtxMenu() {
  var m = document.getElementById('ctx-menu');
  if (m) m.classList.add('hidden');
}

function _ctxHashes() {
  // If multiple selected and the right-clicked torrent is in selection, use all.
  if (_checkedHashes.size > 0 && _checkedHashes.has(_ctxHash)) {
    return Array.from(_checkedHashes);
  }
  return [_ctxHash];
}

function ctxAction(action) {
  _hideCtxMenu();
  var hashes = _ctxHashes();
  if (!hashes.length || !_ctxHash) return;
  var body = new URLSearchParams();
  hashes.forEach(function(h){ body.append('hashes', h); });
  body.append('action', action);
  body.append('instance_id', String(_vtInstanceID));
  fetch(_vtBaseURL + '/ui/partials/torrents/action', { method: 'POST', body: body })
    .then(function(resp) { return resp.text(); })
    .then(function(html) {
      var slot = document.getElementById('vt-data-slot');
      if (slot) { slot.innerHTML = html; initVirtualScroll(); initSidebars(); applySortArrows(); renderFilterChips(); }
    });
}

var _ctxAllCategories = [];
var _ctxCategoryCursor = -1;

function ctxShowCategoryDialog() {
  _hideCtxMenu();
  var dlg = document.getElementById('ctx-category-dialog');
  if (!dlg) return;
  var inp = document.getElementById('ctx-category-input');
  if (inp) { inp.value = _ctxCategory; }
  // Load categories from the sidebar items derived from row data.
  _ctxAllCategories = (_vtSidebarAllItems.cats || []).filter(function(c){ return c !== ''; }).slice().sort();
  _ctxCategoryCursor = -1;
  ctxFilterCategories();
  dlg.classList.remove('hidden');
  if (inp) { inp.focus(); inp.select(); }
}

function ctxFilterCategories() {
  var inp = document.getElementById('ctx-category-input');
  var lb  = document.getElementById('ctx-category-listbox');
  if (!lb) return;
  if (_ctxAllCategories.length === 0) { lb.classList.add('hidden'); return; }
  var q = inp ? inp.value.toLowerCase() : '';
  var matches = q
    ? _ctxAllCategories.filter(function(c){ return c.toLowerCase().indexOf(q) !== -1; })
    : _ctxAllCategories;
  _ctxCategoryCursor = -1;
  var MAX = 200;
  var shown = matches.slice(0, MAX);
  var html = '';
  if (!q) {
    html += '<div class="px-3 py-1.5 cursor-pointer hover:bg-accent text-muted-foreground italic text-xs border-b border-border" data-val="" onclick="ctxPickCategory(this)">— clear category —</div>';
  }
  if (shown.length === 0) {
    html += '<div class="px-3 py-2 text-muted-foreground text-xs">No matches</div>';
  } else {
    shown.forEach(function(c) {
      html += '<div class="px-3 py-1.5 cursor-pointer hover:bg-accent truncate" data-val="' + _escHtml(c) + '" onclick="ctxPickCategory(this)">' + _escHtml(c) + '</div>';
    });
    if (matches.length > MAX) {
      html += '<div class="px-3 py-1.5 text-muted-foreground text-xs border-t border-border select-none">' + (matches.length - MAX) + ' more — keep typing to narrow</div>';
    }
  }
  lb.innerHTML = html;
  lb.classList.remove('hidden');
}

function ctxPickCategory(el) {
  var inp = document.getElementById('ctx-category-input');
  if (inp) inp.value = el.getAttribute('data-val');
  var lb = document.getElementById('ctx-category-listbox');
  if (lb) lb.classList.add('hidden');
}

function ctxCategoryKeydown(e) {
  var lb    = document.getElementById('ctx-category-listbox');
  var items = lb ? Array.from(lb.querySelectorAll('[data-val]')) : [];
  if (e.key === 'Enter') {
    e.preventDefault();
    if (_ctxCategoryCursor >= 0 && items[_ctxCategoryCursor]) {
      ctxPickCategory(items[_ctxCategoryCursor]);
    }
    ctxSubmitCategory();
    return;
  }
  if (e.key === 'Escape') {
    document.getElementById('ctx-category-dialog').classList.add('hidden');
    return;
  }
  if (e.key === 'ArrowDown') {
    e.preventDefault();
    _ctxCategoryCursor = Math.min(_ctxCategoryCursor + 1, items.length - 1);
    items.forEach(function(el, i){ el.classList.toggle('bg-accent', i === _ctxCategoryCursor); });
    if (items[_ctxCategoryCursor]) items[_ctxCategoryCursor].scrollIntoView({ block: 'nearest' });
  } else if (e.key === 'ArrowUp') {
    e.preventDefault();
    _ctxCategoryCursor = Math.max(_ctxCategoryCursor - 1, -1);
    items.forEach(function(el, i){ el.classList.toggle('bg-accent', i === _ctxCategoryCursor); });
    if (_ctxCategoryCursor >= 0 && items[_ctxCategoryCursor]) items[_ctxCategoryCursor].scrollIntoView({ block: 'nearest' });
  }
}

function ctxSubmitCategory() {
  var inp = document.getElementById('ctx-category-input');
  var value = inp ? inp.value : '';
  var hashes = _ctxHashes();
  var body = new URLSearchParams();
  hashes.forEach(function(h){ body.append('hashes', h); });
  body.append('category', value);
  body.append('instance_id', String(_vtInstanceID));
  fetch(_vtBaseURL + '/ui/partials/torrents/set-category', { method: 'POST', body: body })
    .then(function(){ document.getElementById('ctx-category-dialog').classList.add('hidden'); triggerTableRefresh(); });
}

function ctxShowTagDialog() {
  _hideCtxMenu();
  var dlg = document.getElementById('ctx-tags-dialog');
  if (!dlg) return;
  var addInp = document.getElementById('ctx-add-tags-input');
  var rmInp  = document.getElementById('ctx-remove-tags-input');
  if (addInp) addInp.value = '';
  if (rmInp) rmInp.value = '';
  dlg.classList.remove('hidden');
  if (addInp) addInp.focus();
}

function ctxSubmitTags() {
  var addInp = document.getElementById('ctx-add-tags-input');
  var rmInp  = document.getElementById('ctx-remove-tags-input');
  var addVal = addInp ? addInp.value.trim() : '';
  var rmVal  = rmInp  ? rmInp.value.trim()  : '';
  var hashes = _ctxHashes();
  var promises = [];
  if (addVal) {
    var body = new URLSearchParams();
    hashes.forEach(function(h){ body.append('hashes', h); });
    body.append('tags', addVal);
    body.append('instance_id', String(_vtInstanceID));
    promises.push(fetch(_vtBaseURL + '/ui/partials/torrents/add-tags', { method: 'POST', body: body }));
  }
  if (rmVal) {
    var body2 = new URLSearchParams();
    hashes.forEach(function(h){ body2.append('hashes', h); });
    body2.append('tags', rmVal);
    body2.append('instance_id', String(_vtInstanceID));
    promises.push(fetch(_vtBaseURL + '/ui/partials/torrents/remove-tags', { method: 'POST', body: body2 }));
  }
  Promise.all(promises).then(function(){ document.getElementById('ctx-tags-dialog').classList.add('hidden'); triggerTableRefresh(); });
}

function ctxShowLocationDialog() {
  _hideCtxMenu();
  var dlg = document.getElementById('ctx-location-dialog');
  if (!dlg) return;
  var inp = document.getElementById('ctx-location-input');
  if (inp) inp.value = _ctxSavePath;
  dlg.classList.remove('hidden');
  if (inp) inp.focus();
}

function ctxSubmitLocation() {
  var inp = document.getElementById('ctx-location-input');
  var location = inp ? inp.value.trim() : '';
  if (!location) return;
  var hashes = _ctxHashes();
  var body = new URLSearchParams();
  hashes.forEach(function(h){ body.append('hashes', h); });
  body.append('location', location);
  body.append('instance_id', String(_vtInstanceID));
  fetch(_vtBaseURL + '/ui/partials/torrents/set-location', { method: 'POST', body: body })
    .then(function(){ document.getElementById('ctx-location-dialog').classList.add('hidden'); triggerTableRefresh(); });
}

function ctxShowLimitsDialog() {
  _hideCtxMenu();
  var dlg = document.getElementById('ctx-limits-dialog');
  if (!dlg) return;
  dlg.classList.remove('hidden');
  ['ctx-dl-limit','ctx-ul-limit','ctx-ratio-limit','ctx-seed-time-limit'].forEach(function(id){ var e=document.getElementById(id); if(e) e.value=''; });
}

function ctxSubmitLimits() {
  var hashes = _ctxHashes();
  var body = new URLSearchParams();
  hashes.forEach(function(h){ body.append('hashes', h); });
  body.append('instance_id', String(_vtInstanceID));
  var dlL = document.getElementById('ctx-dl-limit');
  var ulL = document.getElementById('ctx-ul-limit');
  var rtL = document.getElementById('ctx-ratio-limit');
  var stL = document.getElementById('ctx-seed-time-limit');
  if (dlL && dlL.value !== '') body.append('dl_limit', dlL.value);
  if (ulL && ulL.value !== '') body.append('up_limit', ulL.value);
  if (rtL && rtL.value !== '') body.append('ratio_limit', rtL.value);
  if (stL && stL.value !== '') body.append('seed_time_limit', stL.value);
  fetch(_vtBaseURL + '/ui/partials/torrents/set-limits', { method: 'POST', body: body })
    .then(function(){ document.getElementById('ctx-limits-dialog').classList.add('hidden'); });
}

function ctxShowRenameDialog() {
  _hideCtxMenu();
  var dlg = document.getElementById('ctx-rename-dialog');
  if (!dlg) return;
  var inp = document.getElementById('ctx-rename-input');
  if (inp) inp.value = _ctxName;
  dlg.classList.remove('hidden');
  if (inp) { inp.focus(); inp.select(); }
}

function ctxSubmitRename() {
  var inp = document.getElementById('ctx-rename-input');
  var name = inp ? inp.value.trim() : '';
  if (!name) return;
  var body = new URLSearchParams();
  body.append('hash', _ctxHash);
  body.append('name', name);
  body.append('instance_id', String(_vtInstanceID));
  fetch(_vtBaseURL + '/ui/partials/torrents/rename', { method: 'POST', body: body })
    .then(function(){ document.getElementById('ctx-rename-dialog').classList.add('hidden'); triggerTableRefresh(); });
}

function ctxCopy(type) {
  _hideCtxMenu();
  var text = '';
  if (type === 'name') text = _ctxName;
  else if (type === 'hash') text = _ctxHash;
  else if (type === 'magnet') text = 'magnet:?xt=urn:btih:' + _ctxHash;
  if (text && navigator.clipboard) navigator.clipboard.writeText(text);
}

function ctxExport() {
  _hideCtxMenu();
  if (!_ctxHash) return;
  window.open(_vtBaseURL + '/ui/partials/torrents/export/' + _ctxHash + '?instance_id=' + _vtInstanceID, '_blank');
}

// Close context menu on scroll or escape.
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    _hideCtxMenu();
    ['ctx-category-dialog','ctx-tags-dialog','ctx-location-dialog','ctx-limits-dialog','ctx-rename-dialog'].forEach(function(id) {
      var d = document.getElementById(id); if (d) d.classList.add('hidden');
    });
  }
});
document.getElementById('torrents-scroll-container')?.addEventListener('scroll', _hideCtxMenu);

// ── Sort arrows ──────────────────────────────────────────────────────────────
function applySortArrows() {
  var sort  = (document.getElementById('current-sort')  || {value:''}).value || '';
  var order = (document.getElementById('current-order') || {value:'desc'}).value || 'desc';
  document.querySelectorAll('[data-sort-col]').forEach(function(btn) {
    btn.querySelectorAll('.sort-arrow').forEach(function(s){ s.parentNode.removeChild(s); });
    if (btn.dataset.sortCol === sort) {
      var sp = document.createElement('span');
      sp.className = 'sort-arrow';
      sp.textContent = order === 'asc' ? ' \u2191' : ' \u2193';
      btn.appendChild(sp);
    }
  });
}

// ── Virtual scroll ──────────────────────────────────────────────────────────
// Uses the generic VirtualList class from virtual-list.js.
// Only visible rows are in the DOM; _vtList.rows holds the full data set.
var _vtList       = null;
var _vtBaseURL    = '';
var _vtInstanceID = 0;

function initVirtualScroll() {
  var dataEl = document.getElementById('vt-rows-json');
  if (!dataEl) return;

  var data;
  try { data = JSON.parse(dataEl.textContent); }
  catch(e) { console.error('vt: JSON parse failed', e); return; }

  _vtBaseURL    = data.baseURL    || '';
  _vtInstanceID = data.instanceID || 0;

  var countEl = document.getElementById('torrent-count');
  if (countEl) countEl.textContent = (data.total || (data.rows||[]).length) + ' torrent(s)';

  // Create the VirtualList instance once; reuse across SSE-driven reloads.
  if (!_vtList) {
    _vtList = new VirtualList({
      containerId : 'torrents-scroll-container',
      tbodyId     : 'torrents-table-body',
      colSpan     : 30,
      renderRow   : _createRow,
      emptyText   : 'No torrents match your filters.',
      afterRender : function() { _restoreCheckboxes(); applyTblCols(); },
    });
  }
  _vtList.load(data.rows || []);
  _updateStatusBar();
  _updateStatusCounts();
}

// ── Status bar ───────────────────────────────────────────────────────────────
function _updateStatusBar() {
  if (!_vtList) return;
  var rows = _vtList.rows || [];
  var dl = 0, up = 0;
  for (var i = 0; i < rows.length; i++) {
    dl += (rows[i].DlSpeed || 0);
    up += (rows[i].UpSpeed || 0);
  }
  var el;
  el = document.getElementById('sb-total');
  if (el) el.textContent = rows.length + ' torrent' + (rows.length !== 1 ? 's' : '');
  el = document.getElementById('sb-dl');
  if (el) el.textContent = dl > 0 ? _vtFmtBytes(dl) + '/s' : '0 B/s';
  el = document.getElementById('sb-up');
  if (el) el.textContent = up > 0 ? _vtFmtBytes(up) + '/s' : '0 B/s';

  var selEl = document.getElementById('sb-selected');
  if (selEl) {
    var cnt = _checkedHashes ? _checkedHashes.size : 0;
    if (cnt > 0) { selEl.textContent = cnt + ' selected'; selEl.classList.remove('hidden'); }
    else { selEl.classList.add('hidden'); }
  }
}

// ── Status counts ────────────────────────────────────────────────────────────
var _statusGroupMap = {
  'downloading': 'downloading', 'metaDL': 'downloading', 'allocating': 'downloading',
  'stalledDL': 'downloading', 'forcedDL': 'downloading', 'queuedDL': 'downloading',
  'uploading': 'uploading', 'stalledUP': 'uploading', 'forcedUP': 'uploading', 'queuedUP': 'uploading',
  'pausedDL': 'paused', 'stoppedDL': 'paused', 'pausedUP': 'completed', 'stoppedUP': 'completed',
  'error': 'errored', 'missingFiles': 'errored',
  'checkingUP': 'downloading', 'checkingDL': 'downloading', 'checkingResumeData': 'downloading',
};

function _updateStatusCounts() {
  if (!_vtList) return;
  var rows = _vtList.rows || [];
  var c = { downloading: 0, uploading: 0, paused: 0, completed: 0, errored: 0 };
  for (var i = 0; i < rows.length; i++) {
    var grp = _statusGroupMap[rows[i].State] || '';
    if (grp) c[grp]++;
  }
  var el;
  el = document.getElementById('sb-status-count-');
  if (el) el.textContent = rows.length || '';
  el = document.getElementById('sb-status-count-downloading');
  if (el) el.textContent = c.downloading || '';
  el = document.getElementById('sb-status-count-uploading');
  if (el) el.textContent = c.uploading || '';
  el = document.getElementById('sb-status-count-paused');
  if (el) el.textContent = c.paused || '';
  el = document.getElementById('sb-status-count-completed');
  if (el) el.textContent = c.completed || '';
  el = document.getElementById('sb-status-count-errored');
  if (el) el.textContent = c.errored || '';
}

// ── Row renderer ─────────────────────────────────────────────────────────────
function _vtStateLabel(state) {
  var m = {
    'downloading':['Downloading','bg-blue-500/15 text-blue-700 dark:text-blue-400'],
    'metaDL':     ['Downloading','bg-blue-500/15 text-blue-700 dark:text-blue-400'],
    'allocating': ['Downloading','bg-blue-500/15 text-blue-700 dark:text-blue-400'],
    'uploading':  ['Seeding','bg-green-500/15 text-green-700 dark:text-green-400'],
    'stalledUP':  ['Seeding','bg-green-500/15 text-green-700 dark:text-green-400'],
    'forcedUP':   ['Seeding','bg-green-500/15 text-green-700 dark:text-green-400'],
    'queuedUP':   ['Seeding','bg-green-500/15 text-green-700 dark:text-green-400'],
    'pausedDL':   ['Paused','bg-muted text-muted-foreground'],
    'stoppedDL':  ['Paused','bg-muted text-muted-foreground'],
    'pausedUP':   ['Completed','bg-muted text-muted-foreground'],
    'stoppedUP':  ['Completed','bg-muted text-muted-foreground'],
    'error':      ['Error','bg-red-500/15 text-red-700 dark:text-red-400'],
    'missingFiles':['Error','bg-red-500/15 text-red-700 dark:text-red-400'],
    'checkingUP': ['Checking','bg-yellow-500/15 text-yellow-700 dark:text-yellow-400'],
    'checkingDL': ['Checking','bg-yellow-500/15 text-yellow-700 dark:text-yellow-400'],
    'checkingResumeData':['Checking','bg-yellow-500/15 text-yellow-700 dark:text-yellow-400'],
  };
  return m[state] || [state||'Unknown','bg-muted text-muted-foreground'];
}
function _vtFmtBytes(n) {
  if (!n || n <= 0) return '\u2014';
  var u = ['B','KiB','MiB','GiB','TiB'], i = 0, v = +n;
  while (v >= 1024 && i < u.length-1) { v /= 1024; i++; }
  return (i > 0 ? v.toFixed(1) : Math.round(v)) + '\u202f' + u[i];
}
function _vtFmtBps(n) { return n > 0 ? _vtFmtBytes(n) + '/s' : '\u2014'; }
function _vtFmtPct(p) { return ((p||0)*100).toFixed(1) + '%'; }
function _vtFmtRatio(r) { return r >= 100 ? '>100' : (r||0).toFixed(2); }
function _vtFmtETA(s) {
  if (!s || s < 0 || s > 8640000) return '\u221e';
  var h = Math.floor(s/3600), m = Math.floor((s%3600)/60), sec = s%60;
  if (h > 0) return h+'h'+String(m).padStart(2,'0')+'m';
  if (m > 0) return m+'m'+String(sec).padStart(2,'0')+'s';
  return sec+'s';
}
function _vtFmtTs(t) {
  if (!t || t <= 0) return '\u2014';
  var d = new Date(t*1000);
  var mo = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  return mo[d.getMonth()]+' '+d.getDate()+', '+d.getFullYear()+' '+
    String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0');
}
function _vtFmtSeedTime(s) {
  if (!s || s <= 0) return '\u2014';
  var d = Math.floor(s/86400), h = Math.floor((s%86400)/3600);
  if (d > 0) return d+'d '+h+'h';
  var m = Math.floor((s%3600)/60);
  return h > 0 ? h+'h '+m+'m' : m+'m';
}
function _vtTrackerHost(url) {
  if (!url) return '';
  try {
    var parts = new URL(url).hostname.split('.');
    return parts.length >= 2 ? parts[parts.length-2]+'.'+parts[parts.length-1] : parts[0];
  } catch(e) { return url; }
}
function _vtEsc(s) {
  return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function _vtIsDownloading(state) {
  return ['downloading','metaDL','allocating','checkingDL','forcedDL'].indexOf(state) >= 0;
}

function _createRow(t) {
  var sl = _vtStateLabel(t.State||''), label = sl[0], badge = sl[1];
  var hash = t.Hash || t.InfohashV1 || t.InfohashV2 || '';
  var h = '';
  h += '<td class="px-2 py-2 w-8" onclick="event.stopPropagation()"><input type="checkbox" name="hashes" value="'+_vtEsc(hash)+'" class="rounded" onclick="event.stopPropagation()"/></td>';
  h += '<td class="px-3 py-2 max-w-xs"><span class="block truncate font-medium" title="'+_vtEsc(t.Name)+'">'+_vtEsc(t.Name)+'</span></td>';
  h += '<td class="px-3 py-2 whitespace-nowrap" data-col="status"><span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium '+badge+'">'+label+'</span></td>';
  h += '<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground" data-col="size">'+_vtFmtBytes(t.SizeB)+'</td>';
  h += '<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground" data-col="total_size">'+(t.TotalSizeB > 0 ? _vtFmtBytes(t.TotalSizeB) : '<span class="text-muted-foreground/50">\u2014</span>')+'</td>';
  h += '<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums" data-col="progress">'+_vtFmtPct(t.Progress)+'</td>';
  h += '<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-blue-600 dark:text-blue-400" data-col="dlspeed">'+(t.DlSpeed > 0 ? _vtFmtBps(t.DlSpeed) : '<span class="text-muted-foreground">\u2014</span>')+'</td>';
  h += '<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-green-600 dark:text-green-400" data-col="upspeed">'+(t.UpSpeed > 0 ? _vtFmtBps(t.UpSpeed) : '<span class="text-muted-foreground">\u2014</span>')+'</td>';
  h += '<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground" data-col="eta">'+(_vtIsDownloading(t.State) ? _vtFmtETA(t.ETA) : '\u2014')+'</td>';
  h += '<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums" data-col="ratio">'+_vtFmtRatio(t.Ratio)+'</td>';
  h += '<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground" data-col="uploaded">'+(t.Uploaded > 0 ? _vtFmtBytes(t.Uploaded) : '<span class="text-muted-foreground/50">\u2014</span>')+'</td>';
  h += '<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground" data-col="downloaded">'+(t.Downloaded > 0 ? _vtFmtBytes(t.Downloaded) : '<span class="text-muted-foreground/50">\u2014</span>')+'</td>';
  h += '<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground" data-col="amount_left">'+(t.AmountLeft > 0 ? _vtFmtBytes(t.AmountLeft) : '<span class="text-muted-foreground/50">\u2014</span>')+'</td>';
  h += '<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground" data-col="seeds">'+(t.NumSeeds||0)+'<span class="text-muted-foreground/60">/'+(t.NumLeechs||0)+'</span></td>';
  h += '<td class="px-3 py-2 max-w-[7rem]" data-col="category"><span class="block truncate text-muted-foreground text-xs" title="'+_vtEsc(t.Category)+'">'+(t.Category ? _vtEsc(t.Category) : '<span class="italic">none</span>')+'</span></td>';
  h += '<td class="px-3 py-2 max-w-[8rem]" data-col="tags">'+(t.Tags ? '<span class="block truncate text-muted-foreground text-xs" title="'+_vtEsc(t.Tags)+'">'+_vtEsc(t.Tags)+'</span>' : '<span class="text-muted-foreground/50 text-xs">\u2014</span>')+'</td>';
  h += '<td class="px-3 py-2 max-w-[6rem]" data-col="tracker"><span class="block truncate text-muted-foreground text-xs" title="'+_vtEsc(t.Tracker)+'">'+_vtEsc(_vtTrackerHost(t.Tracker))+'</span></td>';
  h += '<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground text-xs" data-col="added_on">'+_vtFmtTs(t.AddedOn)+'</td>';
  h += '<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground text-xs" data-col="completion_on">'+_vtFmtTs(t.CompletionOn)+'</td>';
  h += '<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground text-xs" data-col="seeding_time">'+_vtFmtSeedTime(t.SeedingTime)+'</td>';
  h += '<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground text-xs" data-col="time_active">'+_vtFmtSeedTime(t.TimeActive)+'</td>';
  h += '<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground text-xs" data-col="last_activity">'+_vtFmtTs(t.LastActivity)+'</td>';
  h += '<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground text-xs" data-col="priority">'+(t.Priority > 0 ? t.Priority : '\u2014')+'</td>';
  h += '<td class="px-3 py-2" data-col="save_path"><span class="block truncate text-muted-foreground text-xs max-w-[12rem]" title="'+_vtEsc(t.SavePath)+'">'+_vtEsc(t.SavePath)+'</span></td>';
  var ih = t.InfohashV1 || t.InfohashV2 || hash;
  h += '<td class="px-3 py-2" data-col="infohash"><span class="block truncate font-mono text-muted-foreground text-xs max-w-[8rem]" title="'+_vtEsc(ih)+'">'+_vtEsc(ih)+'</span></td>';
  h += '<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground text-xs" data-col="availability">'+(t.Availability > 0 ? (t.Availability*100).toFixed(1)+'%' : '\u2014')+'</td>';

  var tr = document.createElement('tr');
  tr.className = 'hover:bg-muted/50 transition-colors cursor-pointer';
  tr.setAttribute('hx-get', _vtBaseURL + '/ui/partials/torrents/' + hash + '?instance_id=' + _vtInstanceID);
  tr.setAttribute('hx-target', '#torrent-detail-panel');
  tr.setAttribute('hx-swap', 'innerHTML');
  // Bind right-click context menu — pass full torrent object for metadata.
  (function(torrent) {
    tr.addEventListener('contextmenu', function(e) { showContextMenu(e, torrent); });
  })(t);
  tr.innerHTML = h;
  if (window.htmx) htmx.process(tr);
  return tr;
}

// ── Checkbox tracking (virtual-scroll-aware) ────────────────────────────────
var _checkedHashes = new Set();

function _restoreCheckboxes() {
  document.querySelectorAll('[name=hashes]').forEach(function(cb) {
    cb.checked = _checkedHashes.has(cb.value);
  });
}

function _updateBulkBar() {
  var count = _checkedHashes.size;
  var bar = document.getElementById('bulk-action-bar');
  if (bar) { count > 0 ? bar.classList.remove('hidden') : bar.classList.add('hidden'); }
  var cnt = document.getElementById('bulk-count');
  if (cnt) cnt.textContent = count + ' selected';
}

function _updateSelectAll() {
  var total = _vtList ? _vtList.rows.length : 0;
  var count = _checkedHashes.size;
  var sa = document.getElementById('select-all');
  if (!sa) return;
  sa.checked = count > 0 && count === total;
  sa.indeterminate = count > 0 && count < total;
}

function selectAll(checked) {
  _checkedHashes = new Set();
  if (checked && _vtList) {
    _vtList.rows.forEach(function(row) { if (row.Hash) _checkedHashes.add(row.Hash); });
  }
  _restoreCheckboxes();
  _updateBulkBar();
  _updateStatusBar();
  var sa = document.getElementById('select-all');
  if (sa) { sa.checked = checked && _vtList && _vtList.rows.length > 0; sa.indeterminate = false; }
}

// Populate #bulk-hashes-hidden before bulk action submit.
function prepareBulkHashes() {
  var container = document.getElementById('bulk-hashes-hidden');
  if (!container) return;
  container.innerHTML = '';
  _checkedHashes.forEach(function(hash) {
    var inp = document.createElement('input');
    inp.type = 'hidden'; inp.name = 'hashes'; inp.value = hash;
    container.appendChild(inp);
  });
}

document.addEventListener('change', function(e) {
  if (!e.target || e.target.name !== 'hashes') return;
  if (e.target.checked) { _checkedHashes.add(e.target.value); }
  else { _checkedHashes.delete(e.target.value); }
  _updateBulkBar();
  _updateSelectAll();
  _updateStatusBar();
});

// ── Detail panel handlers ────────────────────────────────────────────────────
// Delegated event listener for file priority <select> changes.
document.addEventListener('change', function(e) {
  var sel = e.target;
  if (!sel || !sel.classList.contains('file-prio-select')) return;
  var hash = sel.dataset.hash, inst = sel.dataset.instance, idx = sel.dataset.fileIndex;
  if (!hash || !inst || idx === undefined) return;
  sel.disabled = true;
  sel.classList.add('opacity-50');
  var body = new URLSearchParams();
  body.append('hash', hash);
  body.append('instance_id', inst);
  body.append('indices', idx);
  body.append('priority', sel.value);
  fetch(_vtBaseURL + '/ui/partials/torrents/file-priority', {
    method: 'POST',
    body: body,
    credentials: 'same-origin'
  }).then(function(resp) {
    sel.disabled = false;
    sel.classList.remove('opacity-50');
    if (!resp.ok) {
      console.error('file-priority failed:', resp.status, resp.statusText);
      // Refresh panel to restore server state
      var panel = document.getElementById('torrent-detail-panel');
      if (panel) htmx.ajax('GET', _vtBaseURL + '/ui/partials/torrents/' + hash + '?instance_id=' + inst, {target: panel, swap: 'innerHTML'});
    }
  }).catch(function(err) {
    sel.disabled = false;
    sel.classList.remove('opacity-50');
    console.error('file-priority error:', err);
  });
});

// Delegated click listener for tracker remove buttons.
document.addEventListener('click', function(e) {
  var btn = e.target.closest('.tracker-remove-btn');
  if (!btn) return;
  var hash = btn.dataset.hash, inst = btn.dataset.instance, url = btn.dataset.url;
  if (!hash || !inst || !url) return;
  if (!confirm('Remove tracker: ' + url + '?')) return;
  var body = new URLSearchParams();
  body.append('hash', hash);
  body.append('instance_id', inst);
  body.append('url', url);
  fetch(_vtBaseURL + '/ui/partials/torrents/remove-trackers', { method: 'POST', body: body }).then(function(resp) {
    if (resp.ok) {
      // Refresh detail panel.
      var panel = document.getElementById('torrent-detail-panel');
      if (panel) htmx.ajax('GET', _vtBaseURL + '/ui/partials/torrents/' + hash + '?instance_id=' + inst, {target: panel, swap: 'innerHTML'});
    }
  });
});

// Add trackers from the detail panel (called by Alpine @click).
function handleAddTrackers(hash, instanceID, urls) {
  if (!urls || !urls.trim()) return;
  var body = new URLSearchParams();
  body.append('hash', hash);
  body.append('instance_id', instanceID);
  body.append('urls', urls.trim());
  fetch(_vtBaseURL + '/ui/partials/torrents/add-trackers', { method: 'POST', body: body }).then(function(resp) {
    if (resp.ok) {
      var panel = document.getElementById('torrent-detail-panel');
      if (panel) htmx.ajax('GET', _vtBaseURL + '/ui/partials/torrents/' + hash + '?instance_id=' + instanceID, {target: panel, swap: 'innerHTML'});
    }
  });
}

// Helper: refresh the detail panel after a mutation.
function _refreshDetailPanel(hash, instanceID) {
  var panel = document.getElementById('torrent-detail-panel');
  if (panel) htmx.ajax('GET', _vtBaseURL + '/ui/partials/torrents/' + hash + '?instance_id=' + instanceID, {target: panel, swap: 'innerHTML'});
}

// Edit tracker URL (called from tracker context menu).
function handleDetailEditTracker(hash, instanceID, oldURL, newURL) {
  if (!oldURL || !newURL || oldURL === newURL) return;
  var body = new URLSearchParams();
  body.append('hash', hash);
  body.append('instance_id', instanceID);
  body.append('old_url', oldURL);
  body.append('new_url', newURL);
  fetch(_vtBaseURL + '/ui/partials/torrents/edit-tracker', { method: 'POST', body: body, credentials: 'same-origin' }).then(function(resp) {
    if (resp.ok) _refreshDetailPanel(hash, instanceID);
  });
}

// Remove tracker (called from tracker context menu).
function handleDetailRemoveTracker(hash, instanceID, url) {
  if (!url || !confirm('Remove tracker: ' + url + '?')) return;
  var body = new URLSearchParams();
  body.append('hash', hash);
  body.append('instance_id', instanceID);
  body.append('url', url);
  fetch(_vtBaseURL + '/ui/partials/torrents/remove-trackers', { method: 'POST', body: body, credentials: 'same-origin' }).then(function(resp) {
    if (resp.ok) _refreshDetailPanel(hash, instanceID);
  });
}

// Set file priority from context menu.
function handleDetailFilePriority(hash, instanceID, fileIndex, priority) {
  var body = new URLSearchParams();
  body.append('hash', hash);
  body.append('instance_id', instanceID);
  body.append('indices', String(fileIndex));
  body.append('priority', String(priority));
  fetch(_vtBaseURL + '/ui/partials/torrents/file-priority', { method: 'POST', body: body, credentials: 'same-origin' }).then(function(resp) {
    if (resp.ok) _refreshDetailPanel(hash, instanceID);
  });
}

// Rename file (called from file context menu).
function handleDetailRenameFile(hash, instanceID, oldPath, newPath) {
  if (!oldPath || !newPath || oldPath === newPath) return;
  var body = new URLSearchParams();
  body.append('hash', hash);
  body.append('instance_id', instanceID);
  body.append('old_path', oldPath);
  body.append('new_path', newPath);
  fetch(_vtBaseURL + '/ui/partials/torrents/rename-file', { method: 'POST', body: body, credentials: 'same-origin' }).then(function(resp) {
    if (resp.ok) _refreshDetailPanel(hash, instanceID);
  });
}

// Ban peer (called from peer context menu).
function handleDetailBanPeer(instanceID, peerAddr) {
  if (!peerAddr || !confirm('Ban peer: ' + peerAddr + '?')) return;
  var body = new URLSearchParams();
  body.append('instance_id', instanceID);
  body.append('peers', peerAddr);
  fetch(_vtBaseURL + '/ui/partials/torrents/ban-peers', { method: 'POST', body: body, credentials: 'same-origin' }).then(function(resp) {
    // No panel refresh needed — peer will disappear on next SSE update.
  });
}

// Add peers to a torrent (called from peer tab).
function handleDetailAddPeers(hash, instanceID, peers) {
  if (!peers || !peers.trim()) return;
  var body = new URLSearchParams();
  body.append('hash', hash);
  body.append('instance_id', instanceID);
  body.append('peers', peers.trim());
  fetch(_vtBaseURL + '/ui/partials/torrents/add-peers', { method: 'POST', body: body, credentials: 'same-origin' }).then(function(resp) {
    if (resp.ok) _refreshDetailPanel(hash, instanceID);
  });
}

// ── Column visibility ────────────────────────────────────────────────────────
var _tblColDefaults = JSON.parse(document.getElementById('col-defaults-json').textContent);
var _tblCols = (function() {
  try { var s = JSON.parse(localStorage.getItem('qui_tbl_cols')||'{}'); return Object.assign({},_tblColDefaults,s); }
  catch(e) { return Object.assign({},_tblColDefaults); }
})();
function applyTblCols() {
  Object.keys(_tblCols).forEach(function(col) {
    document.querySelectorAll('[data-col="'+col+'"]').forEach(function(el) {
      if (_tblCols[col]) el.classList.remove('hidden'); else el.classList.add('hidden');
    });
  });
  Object.keys(_tblCols).forEach(function(col) {
    var cb = document.getElementById('col-toggle-'+col); if (cb) cb.checked = !!_tblCols[col];
  });
}
function toggleTblCol(col) {
  _tblCols[col] = !_tblCols[col];
  localStorage.setItem('qui_tbl_cols', JSON.stringify(_tblCols));
  applyTblCols();
}
function resetTblCols() {
  _tblCols = Object.assign({},_tblColDefaults);
  localStorage.removeItem('qui_tbl_cols');
  applyTblCols();
}

// ── sortBy ───────────────────────────────────────────────────────────────────
function sortBy(col) {
  var si = document.getElementById('current-sort');
  var oi = document.getElementById('current-order');
  if (!si || !oi) return;
  var descDefault = ['added_on','completion_on','last_activity','seeding_time','ratio','uploaded','downloaded','size','total_size','time_active'];
  if (si.value === col) { oi.value = oi.value === 'asc' ? 'desc' : 'asc'; }
  else { si.value = col; oi.value = descDefault.indexOf(col) >= 0 ? 'desc' : 'asc'; }
  applySortArrows();
  var btn = document.getElementById('sort-trigger');
  if (btn && window.htmx) htmx.trigger(btn, 'tbl-refresh');
}

// ── HTMX lifecycle ───────────────────────────────────────────────────────────
// Sync sidebar hx-vals params (status/category/tag) back to hidden inputs so
// renderFilterChips() always reflects the active filter state.
document.body.addEventListener('htmx:configRequest', function(e) {
  if (!e.detail || !e.detail.parameters) return;
  var p = e.detail.parameters;
  var map = { status: 'current-status', category: 'current-category', tag: 'current-tag', tracker: 'current-tracker', savepath: 'current-savepath' };
  Object.keys(map).forEach(function(k) {
    if (Object.prototype.hasOwnProperty.call(p, k)) {
      var el = document.getElementById(map[k]);
      if (el) el.value = p[k];
    }
  });
});

document.body.addEventListener('htmx:afterSwap', function(e) {
  if (!e.detail || !e.detail.target) return;
  var id = e.detail.target.id;
  if (id === 'torrent-detail-panel') {
    var outer = document.getElementById('torrent-detail-outer');
    if (outer) outer.style.display = 'flex';
  }
  if (id === 'vt-data-slot') {
    _checkedHashes = new Set();
    _updateBulkBar();
    var sa = document.getElementById('select-all');
    if (sa) { sa.checked = false; sa.indeterminate = false; }
    initVirtualScroll();
    initSidebars();
    applySortArrows();
    renderFilterChips();
  }
});
document.body.addEventListener('torrent-detail-close', function() {
  var outer = document.getElementById('torrent-detail-outer');
  if (outer) outer.style.display = 'none';
});

// ── SSE indicators ───────────────────────────────────────────────────────────
document.body.addEventListener('htmx:sseOpen',  function() { var i=document.getElementById('sse-indicator'); if(i) i.classList.remove('hidden'); });
document.body.addEventListener('htmx:sseClose', function() { var i=document.getElementById('sse-indicator'); if(i) i.classList.add('hidden');    });

// ── Init ─────────────────────────────────────────────────────────────────────
// Wrap in DOMContentLoaded so defer'd scripts (htmx, alpine) are fully
// executed before we call initVirtualScroll → _createRow → htmx.process.
document.addEventListener('DOMContentLoaded', function() {
  applyTblCols();
  applySortArrows();
  renderFilterChips();
  initExprBuilder();
  initVirtualScroll();
  initSidebars();
});
</script>
}
}


// TorrentsTableBody is implemented as a plain Go ComponentFunc in
// torrents_data.go so the JSON can be written directly without templ escaping.

package pages

import (
"fmt"
"net/url"
"strconv"
"strings"
"time"

"github.com/autogrr/rui/internal/ui/layouts"
)

// TorrentRow is a view of one torrent for the list table.
type TorrentRow struct {
	Hash         string
	Name         string
	State        string  // qbt state string
	SizeB        int64   // selected-file size, bytes
	TotalSizeB   int64   // total_size including skipped files, bytes
	Progress     float64 // 0–1
	DlSpeed      int64   // bytes/s
	UpSpeed      int64   // bytes/s
	Ratio        float64
	Category     string
	Tags         string  // comma-separated
	ETA          int64   // seconds; -1 / large = ∞
	AddedOn      int64   // unix timestamp
	CompletionOn int64   // unix timestamp (0 = not yet completed)
	SavePath     string
	Tracker      string  // primary tracker URL
	Uploaded     int64   // total bytes uploaded ever
	Downloaded   int64   // total bytes downloaded
	NumSeeds     int64   // connected seeds
	NumLeechs    int64   // connected leechers
	NumComplete  int64   // total seeds (tracker)
	NumIncomplete int64  // total peers (tracker)
	SeedingTime  int64   // seconds seeding
	TimeActive   int64   // seconds total active
	AmountLeft   int64   // bytes remaining
	LastActivity int64   // unix timestamp of last bandwidth activity
	Availability float64 // 0–1 piece availability
	InfohashV1   string
	InfohashV2   string
	Priority     int64   // queue position (0 = not queued)
}

// TorrentsProps holds data for the torrents list page.
type TorrentsProps struct {
BaseURL    string
Username   string
Version    string
Instances  []layouts.Instance
InstanceID int // currently selected instance (0 = all)
Rows       []TorrentRow
Total      int
Page       int // 1-based
PageSize   int
Search     string
Status     string // active status filter, e.g. "downloading"
Category   string // active category filter
Tag        string // active tag filter
Sort       string // sort column, e.g. "added_on", "name", "size"
Order      string // "asc" or "desc"
Expr       string // optional expr-lang filter expression

// Sidebar data (populated for full page renders only)
Categories []string
Tags       []string
}

// totalPages computes how many pages are needed.
func totalPages(total, pageSize int) int {
if pageSize <= 0 {
return 1
}
pages := total / pageSize
if total%pageSize != 0 {
pages++
}
if pages == 0 {
return 1
}
return pages
}

// stateLabel maps a qBittorrent torrent state to a human-readable badge label + CSS class.
func stateLabel(state string) (label string, class string) {
switch state {
case "downloading", "metaDL", "allocating":
return "Downloading", "bg-blue-500/15 text-blue-700 dark:text-blue-400"
case "uploading", "stalledUP", "forcedUP", "queuedUP":
return "Seeding", "bg-green-500/15 text-green-700 dark:text-green-400"
case "pausedDL", "stoppedDL":
return "Paused", "bg-muted text-muted-foreground"
case "pausedUP", "stoppedUP":
return "Completed", "bg-muted text-muted-foreground"
case "error", "missingFiles":
return "Error", "bg-red-500/15 text-red-700 dark:text-red-400"
case "checkingUP", "checkingDL", "checkingResumeData":
return "Checking", "bg-yellow-500/15 text-yellow-700 dark:text-yellow-400"
default:
return state, "bg-muted text-muted-foreground"
}
}

// formatETA returns a human-readable ETA string.
func formatETA(seconds int64) string {
if seconds < 0 || seconds > 8640000 {
return "∞"
}
h := seconds / 3600
m := (seconds % 3600) / 60
s := seconds % 60
if h > 0 {
return fmt.Sprintf("%dh%02dm", h, m)
}
if m > 0 {
return fmt.Sprintf("%dm%02ds", m, s)
}
return fmt.Sprintf("%ds", s)
}

// formatRatio returns ratio as a short string.
func formatRatio(r float64) string {
if r >= 100 {
return ">100"
}
return strconv.FormatFloat(r, 'f', 2, 64)
}

// formatPercent renders progress as "XX.X%".
func formatPercent(p float64) string {
return fmt.Sprintf("%.1f%%", p*100)
}

// formatTimestamp converts a Unix timestamp to a human-readable date+time string.
func formatTimestamp(t int64) string {
if t <= 0 {
return "—"
}
return time.Unix(t, 0).Format("Jan 2, 2006 15:04")
}

// formatSeedingTime formats seeding duration from seconds.
func formatSeedingTime(seconds int64) string {
if seconds <= 0 {
return "—"
}
d := seconds / 86400
h := (seconds % 86400) / 3600
if d > 0 {
return fmt.Sprintf("%dd %dh", d, h)
}
m := (seconds % 3600) / 60
if h > 0 {
return fmt.Sprintf("%dh %dm", h, m)
}
return fmt.Sprintf("%dm", m)
}

// trackerHost extracts just the hostname from a tracker URL for display.
func trackerHost(rawURL string) string {
if rawURL == "" {
return ""
}
if u, err := url.Parse(rawURL); err == nil && u.Host != "" {
host := u.Host
if i := strings.LastIndex(host, ":"); i != -1 {
host = host[:i]
}
parts := strings.Split(host, ".")
if len(parts) >= 2 {
return parts[len(parts)-2] + "." + parts[len(parts)-1]
}
return host
}
return rawURL
}

// sortArrow returns the sort-direction indicator arrow for a column header.
func sortArrow(currentSort, col, order string) string {
if currentSort != col {
return ""
}
if order == "asc" {
return " ↑"
}
return " ↓"
}

// isDownloading reports whether the torrent state is an active-download state.
func isDownloading(state string) bool {
	switch state {
	case "downloading", "metaDL", "allocating", "checkingDL", "forcedDL":
		return true
	}
	return false
}

// torrentColDef describes one column in the toggle dropdown.
type torrentColDef struct {
	ID      string
	Label   string
	Default bool
}

// torrentColumnDefs is the canonical ordered list of togglable columns.
var torrentColumnDefs = []torrentColDef{
	// Visible by default
	{ID: "status", Label: "Status", Default: true},
	{ID: "size", Label: "Size", Default: true},
	{ID: "progress", Label: "Progress", Default: true},
	{ID: "dlspeed", Label: "Down ↓", Default: true},
	{ID: "upspeed", Label: "Up ↑", Default: true},
	{ID: "eta", Label: "ETA", Default: true},
	{ID: "ratio", Label: "Ratio", Default: true},
	{ID: "seeds", Label: "Seeds", Default: true},
	{ID: "category", Label: "Category", Default: true},
	{ID: "tags", Label: "Tags", Default: true},
	{ID: "tracker", Label: "Tracker", Default: true},
	{ID: "added_on", Label: "Added", Default: true},
	// Hidden by default
	{ID: "total_size", Label: "Total Size", Default: false},
	{ID: "uploaded", Label: "Uploaded", Default: false},
	{ID: "downloaded", Label: "Downloaded", Default: false},
	{ID: "amount_left", Label: "Remaining", Default: false},
	{ID: "completion_on", Label: "Completed On", Default: false},
	{ID: "time_active", Label: "Time Active", Default: false},
	{ID: "seeding_time", Label: "Seeding Time", Default: false},
	{ID: "last_activity", Label: "Last Activity", Default: false},
	{ID: "priority", Label: "Priority", Default: false},
	{ID: "save_path", Label: "Save Path", Default: false},
	{ID: "infohash", Label: "Info Hash", Default: false},
	{ID: "availability", Label: "Avail.", Default: false},
}

// colDefaultsJSON returns an inline JS object literal like {status:true,size:true,...}
// for bootstrapping client-side column visibility state.
func colDefaultsJSON() string {
	var b strings.Builder
	b.WriteString("{")
	for i, c := range torrentColumnDefs {
		if i > 0 {
			b.WriteString(",")
		}
		b.WriteString(c.ID)
		b.WriteString(":")
		if c.Default {
			b.WriteString("true")
		} else {
			b.WriteString("false")
		}
	}
	b.WriteString("}")
	return b.String()
}

// torrentsActiveInstance returns the layouts.Instance matching p.InstanceID, or
// nil if no instance is selected (e.g. when there are no active instances).
func torrentsActiveInstance(p TorrentsProps) *layouts.Instance {
	for _, inst := range p.Instances {
		if inst.ID == p.InstanceID {
			return &layouts.Instance{ID: inst.ID, Name: inst.Name, IsActive: inst.IsActive}
		}
	}
	return nil
}

// Torrents renders the torrents list page.
templ Torrents(p TorrentsProps) {
@layouts.Authenticated(layouts.AuthProps{
BaseURL:        p.BaseURL,
Title:          "Torrents",
CurrentPath:    "/ui/torrents",
Username:       p.Username,
AppVersion:     p.Version,
Instances:      p.Instances,
ActiveInstance: torrentsActiveInstance(p),
}) {
<div
class="flex h-full min-h-0 gap-0"
x-data="{ addOpen: false, sidebarOpen: true, addTab: 'file', addAdv: false, useTmpPath: false }"
>
<!-- Left filter sidebar -->
<div
x-show="sidebarOpen"
x-cloak
class="w-48 shrink-0 flex flex-col border-r border-border bg-background overflow-y-auto text-sm"
>
<div class="px-3 py-2 space-y-4">
<!-- Status section -->
<div>
<p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1">Status</p>
<ul class="space-y-0.5">
for _, sf := range []struct{ val, label string }{
{"", "All"},
{"downloading", "Downloading"},
{"uploading", "Seeding"},
{"pausedDL", "Paused"},
{"pausedUP", "Completed"},
{"error", "Error"},
} {
<li>
<button
hx-get={ p.BaseURL + "/ui/partials/torrents" }
hx-target="#torrents-table-body"
hx-swap="innerHTML"
hx-push-url="false"
hx-vals={ `{"status":"` + sf.val + `","page":"1"}` }
hx-include="#current-category,#current-tag,#current-instance,#current-sort,#current-order,#current-expr,#torrents-search"
class={
"w-full text-left px-2 py-1 rounded-md transition-colors",
templ.KV("bg-primary/10 text-primary font-medium", p.Status == sf.val),
templ.KV("text-muted-foreground hover:bg-accent hover:text-foreground", p.Status != sf.val),
}
>
{ sf.label }
</button>
</li>
}
</ul>
</div>
<!-- Categories section -->
if len(p.Categories) > 0 {
<div>
<p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1">Categories</p>
<ul class="space-y-0.5">
<li>
<button
hx-get={ p.BaseURL + "/ui/partials/torrents" }
hx-target="#torrents-table-body"
hx-swap="innerHTML"
hx-push-url="false"
hx-vals={ `{"category":"","page":"1"}` }
hx-include="#current-status,#current-tag,#current-instance,#current-sort,#current-order,#current-expr,#torrents-search"
class={
"w-full text-left px-2 py-1 rounded-md transition-colors",
templ.KV("bg-primary/10 text-primary font-medium", p.Category == ""),
templ.KV("text-muted-foreground hover:bg-accent hover:text-foreground", p.Category != ""),
}
>
All
</button>
</li>
for _, cat := range p.Categories {
<li>
<button
hx-get={ p.BaseURL + "/ui/partials/torrents" }
hx-target="#torrents-table-body"
hx-swap="innerHTML"
hx-push-url="false"
hx-vals={ `{"category":"` + cat + `","page":"1"}` }
hx-include="#current-status,#current-tag,#current-instance,#current-sort,#current-order,#current-expr,#torrents-search"
class={
"w-full text-left px-2 py-1 rounded-md truncate transition-colors",
templ.KV("bg-primary/10 text-primary font-medium", p.Category == cat),
templ.KV("text-muted-foreground hover:bg-accent hover:text-foreground", p.Category != cat),
}
title={ cat }
>
{ cat }
</button>
</li>
}
</ul>
</div>
}
<!-- Tags section -->
if len(p.Tags) > 0 {
<div>
<p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1">Tags</p>
<ul class="space-y-0.5">
<li>
<button
hx-get={ p.BaseURL + "/ui/partials/torrents" }
hx-target="#torrents-table-body"
hx-swap="innerHTML"
hx-push-url="false"
hx-vals={ `{"tag":"","page":"1"}` }
hx-include="#current-status,#current-category,#current-instance,#current-sort,#current-order,#current-expr,#torrents-search"
class={
"w-full text-left px-2 py-1 rounded-md transition-colors",
templ.KV("bg-primary/10 text-primary font-medium", p.Tag == ""),
templ.KV("text-muted-foreground hover:bg-accent hover:text-foreground", p.Tag != ""),
}
>
All
</button>
</li>
for _, tag := range p.Tags {
<li>
<button
hx-get={ p.BaseURL + "/ui/partials/torrents" }
hx-target="#torrents-table-body"
hx-swap="innerHTML"
hx-push-url="false"
hx-vals={ `{"tag":"` + tag + `","page":"1"}` }
hx-include="#current-status,#current-category,#current-instance,#current-sort,#current-order,#current-expr,#torrents-search"
class={
"w-full text-left px-2 py-1 rounded-md truncate transition-colors",
templ.KV("bg-primary/10 text-primary font-medium", p.Tag == tag),
templ.KV("text-muted-foreground hover:bg-accent hover:text-foreground", p.Tag != tag),
}
title={ tag }
>
{ tag }
</button>
</li>
}
</ul>
</div>
}
</div>
</div>

<!-- Main content (toolbar + table + pagination) -->
<div class="flex flex-col flex-1 min-w-0 gap-2 p-2 overflow-hidden">
<!-- Toolbar -->
<div class="flex flex-wrap items-center gap-2 shrink-0">
<!-- Sidebar toggle -->
<button
@click="sidebarOpen = !sidebarOpen"
class="p-1.5 rounded-md text-muted-foreground hover:bg-accent hover:text-foreground transition-colors"
title="Toggle filter sidebar"
>
<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
</button>
<h1 class="text-lg font-bold tracking-tight">Torrents</h1>
<!-- Search -->
<input
id="torrents-search"
type="search"
name="search"
value={ p.Search }
placeholder="Search torrents…"
class="h-8 rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring w-48 md:w-64"
hx-trigger="keyup changed delay:400ms, search"
hx-get={ p.BaseURL + "/ui/partials/torrents" }
hx-target="#torrents-table-body"
hx-swap="innerHTML"
hx-push-url="false"
hx-include="#current-status,#current-category,#current-tag,#current-page,#current-instance,#current-sort,#current-order,#current-expr"
/>
<!-- Expr filter -->
<input
id="current-expr"
type="text"
name="expr"
value={ p.Expr }
placeholder='Filter expr… e.g. Ratio &lt; 1'
title="expr-lang expression evaluated against torrent fields. Example: Ratio < 1 && State == &#34;downloading&#34;"
class="h-8 rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring w-40 md:w-56"
hx-trigger="keyup changed delay:600ms, search"
hx-get={ p.BaseURL + "/ui/partials/torrents" }
hx-target="#torrents-table-body"
hx-swap="innerHTML"
hx-push-url="false"
hx-include="#current-status,#current-category,#current-tag,#current-page,#current-instance,#current-sort,#current-order,#torrents-search"
/>
<!-- Hidden filter state inputs -->
<input type="hidden" id="current-status" name="status" value={ p.Status }/>
<input type="hidden" id="current-category" name="category" value={ p.Category }/>
<input type="hidden" id="current-tag" name="tag" value={ p.Tag }/>
<input type="hidden" id="current-page" name="page" value={ itoa(p.Page) }/>
<input type="hidden" id="current-instance" name="instance_id" value={ itoa(p.InstanceID) }/>
<input type="hidden" id="current-sort" name="sort" value={ p.Sort }/>
<input type="hidden" id="current-order" name="order" value={ p.Order }/>
<!-- Hidden sort trigger button (invoked by sortBy() JavaScript) -->
<button
id="sort-trigger"
style="display:none"
hx-get={ p.BaseURL + "/ui/partials/torrents" }
hx-target="#torrents-table-body"
hx-swap="innerHTML"
hx-push-url="false"
hx-include="#current-status,#current-category,#current-tag,#current-page,#current-instance,#current-sort,#current-order,#current-expr,#torrents-search"
></button>
<!-- Active filter chips -->
if p.Category != "" {
<span class="inline-flex items-center gap-1 rounded-full bg-primary/10 text-primary text-xs px-2 py-0.5 font-medium">
{ p.Category }
<button
hx-get={ p.BaseURL + "/ui/partials/torrents" }
hx-target="#torrents-table-body"
hx-swap="innerHTML"
hx-push-url="false"
hx-vals={ `{"category":"","page":"1"}` }
hx-include="#current-status,#current-tag,#current-instance,#current-sort,#current-order,#current-expr,#torrents-search"
class="ml-0.5 text-primary/70 hover:text-primary"
>×</button>
</span>
}
if p.Tag != "" {
<span class="inline-flex items-center gap-1 rounded-full bg-primary/10 text-primary text-xs px-2 py-0.5 font-medium">
#{ p.Tag }
<button
hx-get={ p.BaseURL + "/ui/partials/torrents" }
hx-target="#torrents-table-body"
hx-swap="innerHTML"
hx-push-url="false"
hx-vals={ `{"tag":"","page":"1"}` }
hx-include="#current-status,#current-category,#current-instance,#current-sort,#current-order,#current-expr,#torrents-search"
class="ml-0.5 text-primary/70 hover:text-primary"
>×</button>
</span>
}
<!-- Spacer -->
<div class="flex-1"></div>
<span class="text-xs text-muted-foreground tabular-nums">{ itoa(p.Total) } torrent(s)</span>
<!-- SSE live indicator -->
<span
id="sse-indicator"
class="hidden w-2 h-2 rounded-full bg-green-500 flex-shrink-0"
title="Live updates active"
></span>
<!-- Columns toggle dropdown -->
<div class="relative" x-data="{ colsOpen: false }">
<button
@click="colsOpen = !colsOpen"
class="inline-flex items-center gap-1 rounded-md border border-input bg-background px-2.5 py-1.5 text-xs font-medium text-muted-foreground hover:bg-accent hover:text-foreground transition-colors"
title="Toggle column visibility"
>
<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
Columns
</button>
<div
x-show="colsOpen"
x-cloak
@click.outside="colsOpen = false"
class="absolute right-0 top-full mt-1 z-30 w-52 rounded-lg border border-border bg-background shadow-lg py-2 max-h-80 overflow-y-auto"
>
<div class="px-3 pb-1.5 border-b border-border mb-1.5 flex justify-between items-center">
<span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Columns</span>
<button onclick="resetTblCols()" class="text-xs text-muted-foreground hover:text-foreground">Reset</button>
</div>
for _, col := range torrentColumnDefs {
<label class="flex items-center gap-2 px-3 py-1 hover:bg-accent cursor-pointer text-sm select-none">
<input
type="checkbox"
id={ "col-toggle-" + col.ID }
class="rounded"
data-col-toggle={ col.ID }
onchange="toggleTblCol(this.dataset.colToggle)"
/>
{ col.Label }
</label>
}
</div>
</div>
<button
@click="addOpen = true"
class="inline-flex items-center gap-1.5 rounded-md bg-primary px-3 py-1.5 text-xs font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
>
<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
Add
</button>
</div>

<!-- Table + detail panel row -->
<div class="flex flex-1 min-h-0 gap-2">
<!-- Table + bulk bar wrapper (hx-ext="sse" so tbody can listen for live updates) -->
<div
class="flex flex-col flex-1 min-w-0"
hx-ext="sse"
sse-connect={ p.BaseURL + "/ui/sse/torrents?instance_id=" + itoa(p.InstanceID) }
>
<div class="flex-1 overflow-auto rounded-lg border border-border">
<table class="w-full text-sm">
<thead class="sticky top-0 z-10 bg-muted/80 backdrop-blur border-b border-border">
<tr>
<th class="px-2 py-2 w-8">
<input
type="checkbox"
id="select-all"
class="rounded"
onchange="
const checked = this.checked;
document.querySelectorAll('[name=hashes]').forEach(cb => cb.checked = checked);
const count = document.querySelectorAll('[name=hashes]:checked').length;
const bar = document.getElementById('bulk-action-bar');
if (bar) { count > 0 ? bar.classList.remove('hidden') : bar.classList.add('hidden'); }
const cnt = document.getElementById('bulk-count');
if (cnt) cnt.textContent = count + ' selected';
"
/>
</th>
<th class="px-3 py-2 text-left font-medium text-muted-foreground"><button class="hover:text-foreground" onclick="sortBy('name')">Name{ sortArrow(p.Sort, "name", p.Order) }</button></th>
<th class="px-3 py-2 text-left font-medium text-muted-foreground w-24" data-col="status"><button class="hover:text-foreground" onclick="sortBy('state')">Status{ sortArrow(p.Sort, "state", p.Order) }</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-20" data-col="size"><button class="hover:text-foreground" onclick="sortBy('size')">Size{ sortArrow(p.Sort, "size", p.Order) }</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-20" data-col="total_size"><button class="hover:text-foreground" onclick="sortBy('total_size')">Total{ sortArrow(p.Sort, "total_size", p.Order) }</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-16" data-col="progress"><button class="hover:text-foreground" onclick="sortBy('progress')">Done{ sortArrow(p.Sort, "progress", p.Order) }</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-20" data-col="dlspeed"><button class="hover:text-foreground" onclick="sortBy('dlspeed')">&#x2193;{ sortArrow(p.Sort, "dlspeed", p.Order) }</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-20" data-col="upspeed"><button class="hover:text-foreground" onclick="sortBy('upspeed')">&#x2191;{ sortArrow(p.Sort, "upspeed", p.Order) }</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-16" data-col="eta">ETA</th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-16" data-col="ratio"><button class="hover:text-foreground" onclick="sortBy('ratio')">Ratio{ sortArrow(p.Sort, "ratio", p.Order) }</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-20" data-col="uploaded"><button class="hover:text-foreground" onclick="sortBy('uploaded')">Uploaded{ sortArrow(p.Sort, "uploaded", p.Order) }</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-20" data-col="downloaded"><button class="hover:text-foreground" onclick="sortBy('downloaded')">Downloaded{ sortArrow(p.Sort, "downloaded", p.Order) }</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-20" data-col="amount_left">Remaining</th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-14" data-col="seeds"><button class="hover:text-foreground" onclick="sortBy('num_seeds')">Seeds{ sortArrow(p.Sort, "num_seeds", p.Order) }</button></th>
<th class="px-3 py-2 text-left font-medium text-muted-foreground w-28" data-col="category"><button class="hover:text-foreground" onclick="sortBy('category')">Category{ sortArrow(p.Sort, "category", p.Order) }</button></th>
<th class="px-3 py-2 text-left font-medium text-muted-foreground w-32" data-col="tags">Tags</th>
<th class="px-3 py-2 text-left font-medium text-muted-foreground w-24" data-col="tracker">Tracker</th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-28" data-col="added_on"><button class="hover:text-foreground" onclick="sortBy('added_on')">Added{ sortArrow(p.Sort, "added_on", p.Order) }</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-28" data-col="completion_on"><button class="hover:text-foreground" onclick="sortBy('completion_on')">Completed{ sortArrow(p.Sort, "completion_on", p.Order) }</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-24" data-col="seeding_time"><button class="hover:text-foreground" onclick="sortBy('seeding_time')">Seeding{ sortArrow(p.Sort, "seeding_time", p.Order) }</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-24" data-col="time_active">Time Active</th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-28" data-col="last_activity"><button class="hover:text-foreground" onclick="sortBy('last_activity')">Last Activity{ sortArrow(p.Sort, "last_activity", p.Order) }</button></th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-16" data-col="priority"><button class="hover:text-foreground" onclick="sortBy('priority')">Queue{ sortArrow(p.Sort, "priority", p.Order) }</button></th>
<th class="px-3 py-2 text-left font-medium text-muted-foreground" data-col="save_path">Save Path</th>
<th class="px-3 py-2 text-left font-medium text-muted-foreground w-32" data-col="infohash">Info Hash</th>
<th class="px-3 py-2 text-right font-medium text-muted-foreground w-14" data-col="availability">Avail.</th>
</tr>
</thead>
<tbody
id="torrents-table-body"
class="divide-y divide-border"
hx-trigger="sse:torrent-update"
hx-get={ p.BaseURL + "/ui/partials/torrents" }
hx-target="#torrents-table-body"
hx-swap="innerHTML"
hx-push-url="false"
hx-include="#current-status,#current-category,#current-tag,#current-page,#current-instance,#current-sort,#current-order,#current-expr,#torrents-search"
>
@TorrentsTableBody(p)
</tbody>
</table>
</div>

@TorrentsPagination(p)

<!-- Bulk action bar (hidden until rows are selected) -->
<div
id="bulk-action-bar"
class="hidden mt-2 flex items-center gap-2 rounded-lg border border-border bg-background px-3 py-2 shadow-md"
>
<span id="bulk-count" class="text-xs text-muted-foreground mr-2">0 selected</span>
for _, act := range []struct{ action, label, cls string }{
{"pause", "Pause", "bg-muted text-muted-foreground hover:bg-accent hover:text-foreground"},
{"resume", "Resume", "bg-muted text-muted-foreground hover:bg-accent hover:text-foreground"},
{"recheck", "Recheck", "bg-muted text-muted-foreground hover:bg-accent hover:text-foreground"},
{"reannounce", "Reannounce", "bg-muted text-muted-foreground hover:bg-accent hover:text-foreground"},
{"deleteWithFiles", "Delete+Files", "text-destructive border border-destructive/30 hover:bg-destructive hover:text-destructive-foreground"},
{"delete", "Delete", "text-destructive border border-destructive/30 hover:bg-destructive hover:text-destructive-foreground"},
} {
<button
hx-post={ p.BaseURL + "/ui/partials/torrents/action" }
hx-include="[name='hashes']:checked,[name='instance_id']"
hx-vals={ `{"action":"` + act.action + `"}` }
hx-target="#torrents-table-body"
hx-swap="innerHTML"
hx-on::after-request="document.getElementById('select-all').checked=false; document.querySelectorAll('[name=hashes]').forEach(cb=>cb.checked=false); document.getElementById('bulk-action-bar').classList.add('hidden');"
class={ "rounded-md px-2.5 py-1 text-xs font-medium transition-colors", act.cls }
>
{ act.label }
</button>
}
<button
onclick="document.getElementById('select-all').checked=false; document.querySelectorAll('[name=hashes]').forEach(cb=>cb.checked=false); document.getElementById('bulk-action-bar').classList.add('hidden');"
class="ml-auto rounded-md px-2 py-1 text-xs text-muted-foreground hover:text-foreground transition-colors"
>
✕ Clear
</button>
</div>
</div>

<!-- Right detail panel (shown when a torrent row is clicked) -->
<div
id="torrent-detail-outer"
style="display:none"
class="w-96 shrink-0 rounded-lg border border-border bg-background overflow-hidden flex flex-col"
>
<div id="torrent-detail-panel" class="h-full overflow-hidden flex flex-col">
<!-- Loaded via HTMX when a row is clicked -->
</div>
</div>
</div>
</div>

<!-- Add Torrent dialog (Alpine.js modal) -->
<div
x-show="addOpen"
x-cloak
class="fixed inset-0 z-50 flex items-center justify-center bg-background/80 backdrop-blur-sm"
@keydown.escape.window="addOpen = false; addTab = 'file'; addAdv = false; useTmpPath = false;"
>
<div
class="w-full max-w-lg rounded-xl border border-border bg-background shadow-xl flex flex-col max-h-[90vh]"
@click.outside="addOpen = false; addTab = 'file'; addAdv = false; useTmpPath = false;"
>
<!-- Header -->
<div class="flex items-center justify-between px-5 py-4 border-b border-border shrink-0">
<h2 class="text-base font-semibold">Add Torrent</h2>
<button
@click="addOpen = false; addTab = 'file'; addAdv = false; useTmpPath = false;"
class="rounded-md p-1 text-muted-foreground hover:bg-accent transition-colors"
>
<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
</button>
</div>
<!-- Scrollable form body -->
<form
id="add-torrent-form"
hx-post={ p.BaseURL + "/ui/partials/torrents/add" }
hx-target="#torrents-table-body"
hx-swap="innerHTML"
hx-on::after-request="if(event.detail.successful){ addOpen = false; addTab = 'file'; addAdv = false; useTmpPath = false; document.getElementById('add-torrent-form').reset(); document.getElementById('add-file-lbl').textContent = 'No files selected'; }"
class="flex-1 overflow-y-auto px-5 py-4 space-y-4 min-h-0"
enctype="multipart/form-data"
>
<input type="hidden" name="instance_id" value={ itoa(p.InstanceID) }/>
<!-- Source tabs: File / URL -->
<div class="flex rounded-md bg-muted p-1 gap-1">
<button
type="button"
@click="addTab = 'file'"
:class="addTab === 'file' ? 'bg-background shadow-sm text-foreground font-medium' : 'text-muted-foreground hover:text-foreground'"
class="flex-1 rounded-sm px-3 py-1.5 text-sm transition-colors flex items-center justify-center gap-1.5"
>
<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
Upload File
</button>
<button
type="button"
@click="addTab = 'url'"
:class="addTab === 'url' ? 'bg-background shadow-sm text-foreground font-medium' : 'text-muted-foreground hover:text-foreground'"
class="flex-1 rounded-sm px-3 py-1.5 text-sm transition-colors flex items-center justify-center gap-1.5"
>
<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
URL / Magnet
</button>
</div>
<!-- File drop zone (visible when addTab === 'file') -->
<div x-show="addTab === 'file'">
<div
class="border-2 border-dashed border-border rounded-md p-6 text-center cursor-pointer transition-colors hover:border-primary/40 hover:bg-accent/30"
@click="document.getElementById('add-torrent-file-input').click()"
@dragover.prevent="$el.classList.add('border-primary','bg-accent/20')"
@dragleave.self="$el.classList.remove('border-primary','bg-accent/20')"
@drop.prevent="
const dt = new DataTransfer();
const inp = document.getElementById('add-torrent-file-input');
Array.from(inp.files || []).forEach(f => dt.items.add(f));
Array.from($event.dataTransfer.files).filter(f => f.name.endsWith('.torrent')).forEach(f => dt.items.add(f));
inp.files = dt.files;
$el.classList.remove('border-primary','bg-accent/20');
document.getElementById('add-file-lbl').textContent = dt.files.length + ' file(s) selected';
"
>
<svg class="h-8 w-8 mx-auto mb-2 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
<p class="text-sm font-medium">Drag &amp; drop .torrent files here</p>
<p class="text-xs text-muted-foreground mt-0.5">or click to browse · multiple files supported</p>
</div>
<input
id="add-torrent-file-input"
type="file"
name="torrentfile"
accept=".torrent"
multiple
class="hidden"
@change="document.getElementById('add-file-lbl').textContent = $event.target.files.length + ' file(s) selected'"
/>
<span id="add-file-lbl" class="text-xs text-muted-foreground mt-1 block">No files selected</span>
</div>
<!-- URL / magnet textarea (visible when addTab === 'url') -->
<div x-show="addTab === 'url'" x-cloak>
<label class="block text-xs font-medium text-muted-foreground mb-1">URLs / Magnet links (one per line)</label>
<textarea
name="urls"
rows="4"
placeholder="magnet:?xt=urn:btih:…&#10;https://example.com/file.torrent"
class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-ring resize-none"
></textarea>
</div>
<!-- Category + Tags -->
<div class="grid grid-cols-2 gap-3">
<div>
<label class="block text-xs font-medium text-muted-foreground mb-1">Category</label>
<input
type="text"
name="category"
list="add-dialog-categories"
class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
placeholder="none"
/>
if len(p.Categories) > 0 {
<datalist id="add-dialog-categories">
for _, cat := range p.Categories {
<option value={ cat }></option>
}
</datalist>
}
</div>
<div>
<label class="block text-xs font-medium text-muted-foreground mb-1">Tags (comma-separated)</label>
<input
type="text"
name="tags"
list="add-dialog-tags"
class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
placeholder="e.g. hd, seedbox"
/>
if len(p.Tags) > 0 {
<datalist id="add-dialog-tags">
for _, tag := range p.Tags {
<option value={ tag }></option>
}
</datalist>
}
</div>
</div>
<!-- Basic toggles -->
<div class="flex flex-wrap items-center gap-x-5 gap-y-2">
<label class="flex items-center gap-2 text-sm cursor-pointer select-none">
<input type="checkbox" name="paused" value="true" class="rounded"/> Start paused
</label>
<label class="flex items-center gap-2 text-sm cursor-pointer select-none">
<input type="checkbox" name="skip_hash_check" value="true" class="rounded"/> Skip hash check
</label>
</div>
<!-- Advanced options collapsible -->
<div>
<button
type="button"
@click="addAdv = !addAdv"
class="flex items-center gap-1.5 text-xs font-medium text-muted-foreground hover:text-foreground transition-colors w-full text-left"
>
<svg
class="h-3.5 w-3.5 transition-transform duration-150"
:class="addAdv ? 'rotate-90' : ''"
viewBox="0 0 24 24"
fill="none"
stroke="currentColor"
stroke-width="2.5"
><path d="M9 18l6-6-6-6"/></svg>
Advanced options
</button>
<div x-show="addAdv" x-cloak class="mt-3 space-y-3 pl-3 border-l border-border">
<!-- Auto TMM -->
<label class="flex items-center gap-2 text-sm cursor-pointer select-none">
<input type="checkbox" name="auto_tmm" value="true" class="rounded"/> Automatic Torrent Management
</label>
<!-- Save path -->
<div>
<label class="block text-xs font-medium text-muted-foreground mb-1">Save path</label>
<input
type="text"
name="savepath"
class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
placeholder="Leave empty for default"
/>
</div>
<!-- Temporary download path -->
<div class="space-y-2">
<label class="flex items-center gap-2 text-sm cursor-pointer select-none">
<input
type="checkbox"
name="use_download_path"
value="true"
class="rounded"
x-model="useTmpPath"
/> Use temporary download path
</label>
<input
type="text"
name="download_path"
:disabled="!useTmpPath"
class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring disabled:opacity-40 disabled:cursor-not-allowed"
placeholder="Temporary download path"
/>
</div>
<!-- Content layout + rename -->
<div class="grid grid-cols-2 gap-3">
<div>
<label class="block text-xs font-medium text-muted-foreground mb-1">Content layout</label>
<select
name="content_layout"
class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
>
<option value="">Use global setting</option>
<option value="Original">Original</option>
<option value="Subfolder">Create subfolder</option>
<option value="NoSubfolder">No subfolder</option>
</select>
</div>
<div>
<label class="block text-xs font-medium text-muted-foreground mb-1">Rename torrent</label>
<input
type="text"
name="rename"
class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
placeholder="Leave empty for original name"
/>
</div>
</div>
<!-- Sequential + first/last piece -->
<div class="flex flex-wrap items-center gap-x-5 gap-y-2">
<label class="flex items-center gap-2 text-sm cursor-pointer select-none">
<input type="checkbox" name="sequential_download" value="true" class="rounded"/> Sequential download
</label>
<label class="flex items-center gap-2 text-sm cursor-pointer select-none">
<input type="checkbox" name="first_last_piece_prio" value="true" class="rounded"/> First/last piece priority
</label>
</div>
<!-- Speed limits -->
<div class="grid grid-cols-2 gap-3">
<div>
<label class="block text-xs font-medium text-muted-foreground mb-1">Download limit (KiB/s)</label>
<input
type="number"
name="dl_limit"
min="0"
class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
placeholder="0 = unlimited"
/>
</div>
<div>
<label class="block text-xs font-medium text-muted-foreground mb-1">Upload limit (KiB/s)</label>
<input
type="number"
name="up_limit"
min="0"
class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
placeholder="0 = unlimited"
/>
</div>
</div>
<!-- Seeding limits -->
<div class="grid grid-cols-2 gap-3">
<div>
<label class="block text-xs font-medium text-muted-foreground mb-1">Ratio limit</label>
<input
type="number"
name="ratio_limit"
min="0"
step="0.1"
class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
placeholder="0 = use global"
/>
</div>
<div>
<label class="block text-xs font-medium text-muted-foreground mb-1">Seed time limit (min)</label>
<input
type="number"
name="seed_time_limit"
min="0"
class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
placeholder="0 = use global"
/>
</div>
</div>
</div>
</div>
</form>
<!-- Footer -->
<div class="flex justify-end gap-2 px-5 py-3 border-t border-border shrink-0">
<button
type="button"
@click="addOpen = false; addTab = 'file'; addAdv = false; useTmpPath = false;"
class="rounded-md border border-input px-4 py-2 text-sm hover:bg-accent transition-colors"
>Cancel</button>
<button
type="submit"
form="add-torrent-form"
class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
>Add Torrent</button>
</div>
</div>
</div>
</div>

<!-- Checkbox selection + detail panel JS helpers -->
<script>
document.addEventListener('change', function(e) {
if (e.target && e.target.name === 'hashes') {
const count = document.querySelectorAll('[name=hashes]:checked').length;
const total = document.querySelectorAll('[name=hashes]').length;
const bar = document.getElementById('bulk-action-bar');
if (bar) { count > 0 ? bar.classList.remove('hidden') : bar.classList.add('hidden'); }
const cnt = document.getElementById('bulk-count');
if (cnt) cnt.textContent = count + ' selected';
const sa = document.getElementById('select-all');
if (sa) {
sa.checked = count === total && total > 0;
sa.indeterminate = count > 0 && count < total;
}
}
});
document.body.addEventListener('htmx:afterSwap', function(e) {
if (e.detail.target && e.detail.target.id === 'torrent-detail-panel') {
const outer = document.getElementById('torrent-detail-outer');
if (outer) outer.style.display = 'flex';
}
});
document.body.addEventListener('torrent-detail-close', function() {
const outer = document.getElementById('torrent-detail-outer');
if (outer) outer.style.display = 'none';
});
// sortBy: update hidden sort inputs then fire the hidden sort-trigger button.
function sortBy(col) {
const sortInput = document.getElementById('current-sort');
const orderInput = document.getElementById('current-order');
if (!sortInput || !orderInput) return;
const descDefault = ['added_on','completion_on','last_activity','seeding_time','ratio','uploaded','downloaded','size','total_size','time_active'];
if (sortInput.value === col) {
orderInput.value = orderInput.value === 'asc' ? 'desc' : 'asc';
} else {
sortInput.value = col;
orderInput.value = descDefault.includes(col) ? 'desc' : 'asc';
}
document.getElementById('current-page').value = '1';
document.getElementById('sort-trigger').click();
}
// ── Column visibility ─────────────────────────────────────────────────────
var _tblColDefaults = { colDefaultsJSON() };
var _tblCols = (function() {
try {
var saved = JSON.parse(localStorage.getItem('qui_tbl_cols') || '{}');
return Object.assign({}, _tblColDefaults, saved);
} catch(e) { return Object.assign({}, _tblColDefaults); }
})();
function applyTblCols() {
Object.keys(_tblCols).forEach(function(col) {
document.querySelectorAll('[data-col="' + col + '"]').forEach(function(el) {
if (_tblCols[col]) el.classList.remove('hidden');
else el.classList.add('hidden');
});
});
Object.keys(_tblCols).forEach(function(col) {
var cb = document.getElementById('col-toggle-' + col);
if (cb) cb.checked = !!_tblCols[col];
});
}
function toggleTblCol(col) {
_tblCols[col] = !_tblCols[col];
localStorage.setItem('qui_tbl_cols', JSON.stringify(_tblCols));
applyTblCols();
}
function resetTblCols() {
_tblCols = Object.assign({}, _tblColDefaults);
localStorage.removeItem('qui_tbl_cols');
applyTblCols();
}
applyTblCols();
document.body.addEventListener('htmx:afterSwap', function(e) {
if (e.detail.target && e.detail.target.id === 'torrents-table-body') { applyTblCols(); }
});
// ── SSE live indicator ──────────────────────────────────────────────────────
document.body.addEventListener('htmx:sseOpen', function() {
var ind = document.getElementById('sse-indicator'); if (ind) ind.classList.remove('hidden');
});
document.body.addEventListener('htmx:sseClose', function() {
var ind = document.getElementById('sse-indicator'); if (ind) ind.classList.add('hidden');
});
</script>
}
}

// TorrentsTableBody renders only the <tr> rows — used for HTMX partial swap.
templ TorrentsTableBody(p TorrentsProps) {
if len(p.Rows) == 0 {
<tr>
<td colspan="30" class="px-3 py-12 text-center text-sm text-muted-foreground">
No torrents match your filters.
</td>
</tr>
} else {
for _, t := range p.Rows {
{{ label, cls := stateLabel(t.State) }}
<tr
class="hover:bg-muted/50 transition-colors cursor-pointer"
hx-get={ p.BaseURL + "/ui/partials/torrents/" + t.Hash + "?instance_id=" + itoa(p.InstanceID) }
hx-target="#torrent-detail-panel"
hx-swap="innerHTML"
>
<!-- Checkbox -->
<td class="px-2 py-2 w-8" onclick="event.stopPropagation()">
<input type="checkbox" name="hashes" value={ t.Hash } class="rounded" onclick="event.stopPropagation()"/>
</td>
<!-- Name (always visible) -->
<td class="px-3 py-2 max-w-xs">
<span class="block truncate font-medium" title={ t.Name }>{ t.Name }</span>
</td>
<!-- Status -->
<td class="px-3 py-2 whitespace-nowrap" data-col="status">
<span class={ "inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium", cls }>
{ label }
</span>
</td>
<!-- Size -->
<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground" data-col="size">
{ formatBytes(uint64(t.SizeB)) }
</td>
<!-- Total Size -->
<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground" data-col="total_size">
if t.TotalSizeB > 0 {
{ formatBytes(uint64(t.TotalSizeB)) }
} else {
<span class="text-muted-foreground/50">—</span>
}
</td>
<!-- Progress -->
<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums" data-col="progress">
{ formatPercent(t.Progress) }
</td>
<!-- Down speed -->
<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-blue-600 dark:text-blue-400" data-col="dlspeed">
if t.DlSpeed > 0 {
{ formatBytesPerSec(uint64(t.DlSpeed)) }
} else {
<span class="text-muted-foreground">—</span>
}
</td>
<!-- Up speed -->
<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-green-600 dark:text-green-400" data-col="upspeed">
if t.UpSpeed > 0 {
{ formatBytesPerSec(uint64(t.UpSpeed)) }
} else {
<span class="text-muted-foreground">—</span>
}
</td>
<!-- ETA -->
<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground" data-col="eta">
if isDownloading(t.State) {
{ formatETA(t.ETA) }
} else {
<span>—</span>
}
</td>
<!-- Ratio -->
<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums" data-col="ratio">
{ formatRatio(t.Ratio) }
</td>
<!-- Uploaded -->
<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground" data-col="uploaded">
if t.Uploaded > 0 {
{ formatBytes(uint64(t.Uploaded)) }
} else {
<span class="text-muted-foreground/50">—</span>
}
</td>
<!-- Downloaded -->
<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground" data-col="downloaded">
if t.Downloaded > 0 {
{ formatBytes(uint64(t.Downloaded)) }
} else {
<span class="text-muted-foreground/50">—</span>
}
</td>
<!-- Remaining -->
<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground" data-col="amount_left">
if t.AmountLeft > 0 {
{ formatBytes(uint64(t.AmountLeft)) }
} else {
<span class="text-muted-foreground/50">—</span>
}
</td>
<!-- Seeds / Leeches -->
<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground" data-col="seeds">
{ itoa(int(t.NumSeeds)) }<span class="text-muted-foreground/60">/{ itoa(int(t.NumLeechs)) }</span>
</td>
<!-- Category -->
<td class="px-3 py-2 max-w-[7rem]" data-col="category">
<span class="block truncate text-muted-foreground text-xs" title={ t.Category }>
if t.Category == "" {
<span class="italic">none</span>
} else {
{ t.Category }
}
</span>
</td>
<!-- Tags -->
<td class="px-3 py-2 max-w-[8rem]" data-col="tags">
if t.Tags != "" {
<span class="block truncate text-muted-foreground text-xs" title={ t.Tags }>{ t.Tags }</span>
} else {
<span class="text-muted-foreground/50 text-xs">—</span>
}
</td>
<!-- Tracker -->
<td class="px-3 py-2 max-w-[6rem]" data-col="tracker">
<span class="block truncate text-muted-foreground text-xs" title={ t.Tracker }>
{ trackerHost(t.Tracker) }
</span>
</td>
<!-- Added On -->
<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground text-xs" data-col="added_on">
{ formatTimestamp(t.AddedOn) }
</td>
<!-- Completed On -->
<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground text-xs" data-col="completion_on">
{ formatTimestamp(t.CompletionOn) }
</td>
<!-- Seeding Time -->
<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground text-xs" data-col="seeding_time">
{ formatSeedingTime(t.SeedingTime) }
</td>
<!-- Time Active -->
<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground text-xs" data-col="time_active">
{ formatSeedingTime(t.TimeActive) }
</td>
<!-- Last Activity -->
<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground text-xs" data-col="last_activity">
{ formatTimestamp(t.LastActivity) }
</td>
<!-- Queue Priority -->
<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground text-xs" data-col="priority">
if t.Priority > 0 {
{ itoa(int(t.Priority)) }
} else {
<span>—</span>
}
</td>
<!-- Save Path -->
<td class="px-3 py-2" data-col="save_path">
<span class="block truncate text-muted-foreground text-xs max-w-[12rem]" title={ t.SavePath }>
{ t.SavePath }
</span>
</td>
<!-- Info Hash -->
<td class="px-3 py-2" data-col="infohash">
if t.InfohashV1 != "" {
<span class="block truncate font-mono text-muted-foreground text-xs max-w-[8rem]" title={ t.InfohashV1 }>{ t.InfohashV1 }</span>
} else if t.InfohashV2 != "" {
<span class="block truncate font-mono text-muted-foreground text-xs max-w-[8rem]" title={ t.InfohashV2 }>{ t.InfohashV2 }</span>
} else {
<span class="block truncate font-mono text-muted-foreground text-xs max-w-[8rem]" title={ t.Hash }>{ t.Hash }</span>
}
</td>
<!-- Availability -->
<td class="px-3 py-2 text-right whitespace-nowrap tabular-nums text-muted-foreground text-xs" data-col="availability">
if t.Availability > 0 {
{ fmt.Sprintf("%.1f%%", t.Availability*100) }
} else {
<span>—</span>
}
</td>
</tr>
}
}
}

// TorrentsPagination renders prev/next page controls.
templ TorrentsPagination(p TorrentsProps) {
{{ pages := totalPages(p.Total, p.PageSize) }}
if pages > 1 {
<div class="flex items-center justify-between py-2 px-1 text-sm shrink-0">
<span class="text-muted-foreground">
Page { itoa(p.Page) } of { itoa(pages) }
</span>
<div class="flex items-center gap-1">
if p.Page > 1 {
<button
hx-get={ p.BaseURL + "/ui/partials/torrents" }
hx-target="#torrents-table-body"
hx-swap="innerHTML"
hx-push-url="false"
hx-vals={ `{"page":"` + itoa(p.Page-1) + `"}` }
hx-include="#current-status,#current-category,#current-tag,#current-instance,#current-sort,#current-order,#current-expr,#torrents-search"class="rounded-md border border-input bg-background px-3 py-1.5 text-xs hover:bg-accent hover:text-accent-foreground transition-colors"
>
← Prev
</button>
}
if p.Page < pages {
<button
hx-get={ p.BaseURL + "/ui/partials/torrents" }
hx-target="#torrents-table-body"
hx-swap="innerHTML"
hx-push-url="false"
hx-vals={ `{"page":"` + itoa(p.Page+1) + `"}` }
hx-include="#current-status,#current-category,#current-tag,#current-instance,#current-sort,#current-order,#current-expr,#torrents-search"class="rounded-md border border-input bg-background px-3 py-1.5 text-xs hover:bg-accent hover:text-accent-foreground transition-colors"
>
Next →
</button>
}
</div>
</div>
}
}

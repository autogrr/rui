// stub_pages.templ contains placeholder templ pages for routes that are not yet
// fully implemented. They render the authenticated shell with a "coming soon"
// notice so the routing layer compiles and is navigable immediately.

package pages

import "github.com/autogrr/rui/internal/ui/layouts"

// StubProps is shared by all stub pages.
type StubProps struct {
	BaseURL     string
	Username    string
	Version     string
	Title       string
	CurrentPath string
	Instances   []layouts.Instance
}

templ Stub(p StubProps) {
	@layouts.Authenticated(layouts.AuthProps{
		BaseURL:     p.BaseURL,
		Title:       p.Title,
		CurrentPath: p.CurrentPath,
		Username:    p.Username,
		AppVersion:  p.Version,
		Instances:   p.Instances,
	}) {
		<div class="flex flex-col items-center justify-center min-h-[60vh] gap-4 text-center">
			<svg class="h-16 w-16 text-muted-foreground/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
				<rect x="3" y="3" width="18" height="18" rx="2"/>
				<line x1="3" x2="21" y1="9" y2="9"/>
				<line x1="9" x2="9" y1="9" y2="21"/>
			</svg>
			<div>
				<h2 class="text-xl font-semibold">{ p.Title }</h2>
				<p class="text-muted-foreground mt-1 text-sm">
					This page is being migrated to the new server-rendered UI.
				</p>
			</div>
		</div>
	}
}

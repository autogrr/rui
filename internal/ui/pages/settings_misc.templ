package pages

import (
	"github.com/autogrr/rui/internal/config"
	"github.com/autogrr/rui/internal/ui/components/button"
	"github.com/autogrr/rui/internal/ui/components/card"
	"github.com/autogrr/rui/internal/ui/components/separator"
)

// ──────────────────────────────────────────────────────────────────
// Date & Time section (client-side only, stored in localStorage)
// ──────────────────────────────────────────────────────────────────

// SettingsDatetimeSection renders the date & time preferences section.
templ SettingsDatetimeSection(p SettingsProps) {
	@card.Card(card.Props{}) {
		@card.Header(card.HeaderProps{}) {
			@card.Title(card.TitleProps{}) {
				Date & Time
			}
			@card.Description(card.DescriptionProps{}) {
				Preferences are stored in your browser and do not affect other users.
			}
		}
		@card.Content(card.ContentProps{}) {
			<div x-data="datetimePrefs()" x-init="init()" class="space-y-6">
				<!-- Timezone -->
				<div class="space-y-2">
					<label class="text-sm font-medium" for="tz-select">Timezone</label>
					<select
						id="tz-select"
						x-model="timezone"
						@change="save()"
						class="flex h-9 w-full max-w-sm rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
					>
						@timezoneOptions()
					</select>
					<p class="text-xs text-muted-foreground">Override the timezone used when displaying dates and times. "Browser" uses your system timezone.</p>
				</div>
				@separator.Separator(separator.Props{})
				<!-- Date format -->
				<div class="space-y-2">
					<label class="text-sm font-medium">Date Format</label>
					<div class="flex flex-wrap gap-3">
						@dateFormatOption("MMM D, YYYY", "Apr 10, 2025")
						@dateFormatOption("YYYY-MM-DD", "2025-04-10")
						@dateFormatOption("DD/MM/YYYY", "10/04/2025")
						@dateFormatOption("MM/DD/YYYY", "04/10/2025")
					</div>
				</div>
				@separator.Separator(separator.Props{})
				<!-- Time format -->
				<div class="space-y-2">
					<label class="text-sm font-medium">Time Format</label>
					<div class="flex flex-wrap gap-3">
						<label class="flex items-center gap-2 cursor-pointer rounded-lg border px-3 py-2 text-sm" :class="{'border-primary bg-primary/5': timeFormat === '24h', 'border-input': timeFormat !== '24h'}">
							<input type="radio" name="time-format" value="24h" x-model="timeFormat" @change="save()" class="sr-only"/>
							24-hour (14:30)
						</label>
						<label class="flex items-center gap-2 cursor-pointer rounded-lg border px-3 py-2 text-sm" :class="{'border-primary bg-primary/5': timeFormat === '12h', 'border-input': timeFormat !== '12h'}">
							<input type="radio" name="time-format" value="12h" x-model="timeFormat" @change="save()" class="sr-only"/>
							12-hour (2:30 PM)
						</label>
					</div>
				</div>
				<p class="text-xs text-muted-foreground">Saved automatically. Refresh the page to see the effect on existing values.</p>
			</div>
		}
	}
	<script>
		function datetimePrefs() {
			return {
				timezone: 'browser',
				dateFormat: 'MMM D, YYYY',
				timeFormat: '24h',
				init() {
					this.timezone   = localStorage.getItem('rui:tz')         || 'browser';
					this.dateFormat = localStorage.getItem('rui:dateFormat') || 'MMM D, YYYY';
					this.timeFormat = localStorage.getItem('rui:timeFormat') || '24h';
				},
				save() {
					localStorage.setItem('rui:tz',         this.timezone);
					localStorage.setItem('rui:dateFormat', this.dateFormat);
					localStorage.setItem('rui:timeFormat', this.timeFormat);
				},
			};
		}
	</script>
}

// timezoneOptions renders a hard-coded subset of common zone options.
templ timezoneOptions() {
	<option value="browser">Browser timezone</option>
	<optgroup label="UTC">
		<option value="UTC">UTC</option>
	</optgroup>
	<optgroup label="Americas">
		<option value="America/New_York">Eastern Time (New York)</option>
		<option value="America/Chicago">Central Time (Chicago)</option>
		<option value="America/Denver">Mountain Time (Denver)</option>
		<option value="America/Los_Angeles">Pacific Time (Los Angeles)</option>
		<option value="America/Anchorage">Alaska (Anchorage)</option>
		<option value="America/Honolulu">Hawaii (Honolulu)</option>
		<option value="America/Toronto">Toronto</option>
		<option value="America/Vancouver">Vancouver</option>
		<option value="America/Sao_Paulo">São Paulo</option>
		<option value="America/Argentina/Buenos_Aires">Buenos Aires</option>
	</optgroup>
	<optgroup label="Europe">
		<option value="Europe/London">London</option>
		<option value="Europe/Dublin">Dublin</option>
		<option value="Europe/Paris">Paris / Berlin / Madrid</option>
		<option value="Europe/Amsterdam">Amsterdam</option>
		<option value="Europe/Helsinki">Helsinki / Kyiv / Tallinn</option>
		<option value="Europe/Istanbul">Istanbul</option>
		<option value="Europe/Moscow">Moscow</option>
	</optgroup>
	<optgroup label="Asia &amp; Pacific">
		<option value="Asia/Dubai">Dubai</option>
		<option value="Asia/Kolkata">India (Kolkata)</option>
		<option value="Asia/Dhaka">Dhaka</option>
		<option value="Asia/Bangkok">Bangkok / Jakarta</option>
		<option value="Asia/Singapore">Singapore</option>
		<option value="Asia/Shanghai">China (Shanghai)</option>
		<option value="Asia/Tokyo">Japan (Tokyo)</option>
		<option value="Asia/Seoul">Korea (Seoul)</option>
		<option value="Australia/Sydney">Australia (Sydney)</option>
		<option value="Pacific/Auckland">New Zealand (Auckland)</option>
	</optgroup>
	<optgroup label="Africa">
		<option value="Africa/Johannesburg">Johannesburg</option>
		<option value="Africa/Cairo">Cairo</option>
		<option value="Africa/Lagos">Lagos</option>
	</optgroup>
}

// ──────────────────────────────────────────────────────────────────
// Themes section (client-side only)
// ──────────────────────────────────────────────────────────────────

// SettingsThemesSection renders the theme / appearance section.
templ SettingsThemesSection(p SettingsProps) {
	@card.Card(card.Props{}) {
		@card.Header(card.HeaderProps{}) {
			@card.Title(card.TitleProps{}) {
				Appearance
			}
			@card.Description(card.DescriptionProps{}) {
				Choose appearance settings. Stored in your browser.
			}
		}
		@card.Content(card.ContentProps{}) {
			<div x-data="themePrefs()" x-init="init()" class="space-y-8">
				<!-- Color scheme -->
				<div class="space-y-3">
					<label class="text-sm font-medium">Color Scheme</label>
					<div class="flex flex-wrap gap-3">
						@schemeCard("system", "System", `<svg class="h-5 w-5 mx-auto mb-1 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`)
						@schemeCard("light", "Light", `<svg class="h-5 w-5 mx-auto mb-1 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>`)
						@schemeCard("dark", "Dark", `<svg class="h-5 w-5 mx-auto mb-1 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>`)
					</div>
				</div>
				@separator.Separator(separator.Props{})
				<!-- rui default -->
				<div class="space-y-3">
					<div>
						<label class="text-sm font-medium">rui Default</label>
						<p class="text-xs text-muted-foreground mt-0.5">Magenta — the signature rui accent</p>
					</div>
					<div class="flex flex-wrap gap-3">
						@themeCard("", "rui Magenta", "oklch(0.575 0.198 349)")
					</div>
				</div>
				@separator.Separator(separator.Props{})
				<!-- Colors of the Year -->
				<div class="space-y-3">
					<div>
						<label class="text-sm font-medium">Colors of the Year</label>
						<p class="text-xs text-muted-foreground mt-0.5">Curated themes inspired by the annual Color of the Year</p>
					</div>
					<div class="flex flex-wrap gap-3">
						@cotyCard("mocha_mousse", "Mocha Mousse", "2025", "oklch(0.550 0.060 55)")
						@cotyCard("peach_fuzz", "Peach Fuzz", "2024", "oklch(0.750 0.100 55)")
						@cotyCard("viva_magenta", "Viva Magenta", "2023", "oklch(0.500 0.200 10)")
						@cotyCard("very_peri", "Very Peri", "2022", "oklch(0.560 0.150 285)")
						@cotyCard("illuminating", "Illuminating", "2021", "oklch(0.850 0.160 95)")
						@cotyCard("classic_blue", "Classic Blue", "2020", "oklch(0.430 0.130 260)")
						@cotyCard("living_coral", "Living Coral", "2019", "oklch(0.650 0.180 25)")
						@cotyCard("ultra_violet", "Ultra Violet", "2018", "oklch(0.430 0.130 300)")
						@cotyCard("greenery", "Greenery", "2017", "oklch(0.650 0.130 130)")
						@cotyCard("rose_quartz", "Rose Quartz", "2016", "oklch(0.680 0.095 10)")
						@cotyCard("marsala", "Marsala", "2015", "oklch(0.475 0.080 20)")
						@cotyCard("radiant_orchid", "Radiant Orchid", "2014", "oklch(0.550 0.140 325)")
						@cotyCard("emerald", "Emerald", "2013", "oklch(0.570 0.130 168)")
						@cotyCard("tangerine_tango", "Tangerine Tango", "2012", "oklch(0.550 0.200 28)")
						@cotyCard("honeysuckle", "Honeysuckle", "2011", "oklch(0.560 0.170 7)")
						@cotyCard("turquoise", "Turquoise", "2010", "oklch(0.620 0.100 185)")
						@cotyCard("mimosa", "Mimosa", "2009", "oklch(0.780 0.150 85)")
						@cotyCard("blue_iris", "Blue Iris", "2008", "oklch(0.475 0.130 280)")
						@cotyCard("chili_pepper", "Chili Pepper", "2007", "oklch(0.420 0.170 15)")
						@cotyCard("sand_dollar", "Sand Dollar", "2006", "oklch(0.600 0.065 60)")
						@cotyCard("blue_turquoise", "Blue Turquoise", "2005", "oklch(0.620 0.095 190)")
						@cotyCard("tigerlily", "Tigerlily", "2004", "oklch(0.580 0.190 30)")
						@cotyCard("aqua_sky", "Aqua Sky", "2003", "oklch(0.600 0.095 190)")
						@cotyCard("true_red", "True Red", "2002", "oklch(0.460 0.200 22)")
						@cotyCard("fuchsia_rose", "Fuchsia Rose", "2001", "oklch(0.520 0.170 350)")
						@cotyCard("cerulean", "Cerulean", "2000", "oklch(0.580 0.110 235)")
					</div>
				</div>
				@separator.Separator(separator.Props{})
				<!-- Community Themes (from qui) -->
				<div class="space-y-3">
					<div>
						<label class="text-sm font-medium">Community Themes</label>
						<p class="text-xs text-muted-foreground mt-0.5">
							Ported from
							<a href="https://github.com/autobrr/qui" target="_blank" rel="noopener" class="underline decoration-muted-foreground/40 hover:text-primary hover:decoration-primary transition-colors">qui</a>
						</p>
					</div>
					<div class="flex flex-wrap gap-3">
						@themeCard("autobrr", "Autobrr", "oklch(0.546 0.215 262.9)")
						@themeCard("amber_minimal", "Amber Minimal", "oklch(0.769 0.165 70.1)")
						@themeCard("amethyst_haze", "Amethyst Haze", "oklch(0.610 0.077 299.7)")
						@themeCard("bubblegum", "Bubblegum", "oklch(0.621 0.180 348.1)")
						@themeCard("catppuccin", "Catppuccin", "oklch(0.555 0.250 297.0)")
						@themeCard("claude", "Claude", "oklch(0.617 0.138 39.0)")
						@themeCard("cyberpunk", "Cyberpunk", "oklch(0.673 0.290 341.4)")
						@themeCard("kitsune", "Kitsune", "oklch(0.650 0.150 350)")
						@themeCard("kyle", "The Kyle", "oklch(0.543 0.225 351.6)")
						@themeCard("matrix", "The Matrix", "oklch(0.627 0.170 149.2)")
						@themeCard("minimal", "Minimal", "oklch(0.205 0 0)")
						@themeCard("napster", "Napster", "oklch(0.300 0.140 265)")
						@themeCard("nightwalker", "Nightwalker", "oklch(0.623 0.188 259.8)")
						@themeCard("nord", "Nord", "oklch(0.775 0.062 217.5)")
						@themeCard("perpetuity", "Perpetuity", "oklch(0.562 0.095 203.3)")
						@themeCard("swizzin", "Swizzin", "oklch(0.458 0.073 250.9)")
						@themeCard("synthwave", "Synthwave", "oklch(0.694 0.226 354.1)")
						@themeCard("tangerine", "Tangerine", "oklch(0.640 0.172 36.4)")
					</div>
				</div>
				@separator.Separator(separator.Props{})
				<!-- Custom Theme Creator -->
				<div class="space-y-3">
					<div>
						<label class="text-sm font-medium">Custom Theme Creator</label>
						<p class="text-xs text-muted-foreground mt-0.5">Pick an accent color to generate a bespoke theme</p>
					</div>
					<div class="flex flex-wrap gap-2">
						<template x-for="color in colorSwatches" :key="color.name">
							<button
								type="button"
								class="group relative w-10 h-10 rounded-full ring-1 ring-border cursor-pointer transition-all hover:scale-110 hover:ring-2 hover:ring-primary"
								:class="{'ring-2 ring-primary ring-offset-2 ring-offset-background scale-110': colorTheme === 'custom' && customHue === color.h}"
								:style="'background-color: oklch(' + color.l + ' ' + color.c + ' ' + color.h + ')'"
								:title="color.name"
								@click="applyCustomColor(color)"
							></button>
						</template>
					</div>
					<template x-if="colorTheme === 'custom' && customName">
						<p class="text-xs text-primary font-medium" x-text="'Active: ' + customName"></p>
					</template>
				</div>
				<p class="text-xs text-muted-foreground">Selection is applied immediately. No page reload required.</p>
			</div>
		}
	}
	<script>
		function themePrefs() {
			return {
				scheme: 'system',
				colorTheme: '',
				customHue: null,
				customName: '',
				colorSwatches: [
					{name:'Red',     l:0.55, c:0.22, h:25},
					{name:'Orange',  l:0.68, c:0.19, h:50},
					{name:'Yellow',  l:0.87, c:0.17, h:90},
					{name:'Green',   l:0.58, c:0.17, h:148},
					{name:'Teal',    l:0.56, c:0.12, h:195},
					{name:'Cyan',    l:0.56, c:0.12, h:225},
					{name:'Blue',    l:0.48, c:0.20, h:264},
					{name:'Violet',  l:0.46, c:0.23, h:300},
					{name:'Fuchsia', l:0.55, c:0.20, h:330},
					{name:'Magenta', l:0.575,c:0.198,h:349},
					{name:'Rose',    l:0.70, c:0.14, h:10},
					{name:'Cocoa',   l:0.48, c:0.06, h:55},
					{name:'Gray',    l:0.58, c:0.005,h:260},
					{name:'Slate',   l:0.38, c:0.02, h:260},
				],
				init() {
					this.scheme = localStorage.getItem('rui:theme') || 'system';
					this.colorTheme = localStorage.getItem('rui:color-theme') || '';
					if (this.colorTheme === 'custom') {
						var s = localStorage.getItem('rui:custom-theme');
						if (s) {
							try {
								var d = JSON.parse(s);
								this.customHue = d.h;
								this.customName = d.name || '';
								this._injectCSS(d);
							} catch(e) {}
						}
					}
				},
				select(v) {
					this.scheme = v;
					localStorage.setItem('rui:theme', v);
					_applyScheme(v);
				},
				selectColor(v) {
					this.colorTheme = v;
					this._clearCustom();
					this._cancelPendingSwitch();
					if (v) {
						localStorage.setItem('rui:color-theme', v);
						// Preload new theme CSS, then flip data-theme atomically
						this._switchTheme('/ui/static/themes/' + v + '.css', v);
					} else {
						// Revert to default — output.css `:root` fallback takes over immediately
						localStorage.removeItem('rui:color-theme');
						document.documentElement.removeAttribute('data-theme');
						var link = document.getElementById('theme-css');
						if (link) link.href = 'data:text/css,';
					}
				},
				applyCustomColor(c) {
					this.colorTheme = 'custom';
					this.customHue = c.h;
					this.customName = c.name;
					localStorage.setItem('rui:color-theme', 'custom');
					localStorage.setItem('rui:custom-theme', JSON.stringify(c));
					this._cancelPendingSwitch();
					// Custom theme uses injected <style>, reset theme link to no-op
					var link = document.getElementById('theme-css');
					if (link) link.href = 'data:text/css,';
					document.documentElement.setAttribute('data-theme', 'custom');
					this._injectCSS(c);
				},
				_clearCustom() {
					var el = document.getElementById('custom-theme-css');
					if (el) el.remove();
					this.customHue = null;
					this.customName = '';
					localStorage.removeItem('rui:custom-theme');
				},
				_injectCSS(c) {
					var el = document.getElementById('custom-theme-css');
					if (el) el.remove();
					var L=c.l, C=c.c, h=c.h;
					var dL=Math.min(L+0.15,0.80), dC=C*0.88;
					function v(lightness,chroma){return 'oklch('+lightness+' '+chroma.toFixed(4)+' '+h+')';}
					var lt=':root[data-theme="custom"]{'+
						'--background:'+v(0.995,C*0.015)+';--foreground:'+v(0.21,C*0.06)+';'+
						'--card:oklch(1 0 0);--card-foreground:'+v(0.21,C*0.06)+';'+
						'--popover:oklch(1 0 0);--popover-foreground:'+v(0.21,C*0.06)+';'+
						'--primary:oklch('+L+' '+C+' '+h+');--primary-foreground:oklch(1 0 0);'+
						'--secondary:'+v(0.96,C*0.04)+';--secondary-foreground:'+v(0.21,C*0.06)+';'+
						'--muted:'+v(0.96,C*0.04)+';--muted-foreground:'+v(0.55,C*0.09)+';'+
						'--accent:'+v(0.958,C*0.07)+';--accent-foreground:'+v(0.21,C*0.06)+';'+
						'--destructive:oklch(0.577 0.215 27.3);--destructive-foreground:oklch(1 0 0);'+
						'--border:'+v(0.92,C*0.05)+';--input:'+v(0.96,C*0.03)+';'+
						'--ring:oklch('+L+' '+C+' '+h+');'+
						'--sidebar:'+v(0.98,C*0.02)+';--sidebar-foreground:'+v(0.37,C*0.08)+';'+
						'--sidebar-primary:oklch('+L+' '+C+' '+h+');--sidebar-primary-foreground:oklch(1 0 0);'+
						'--sidebar-accent:oklch('+L+' '+C+' '+h+');--sidebar-accent-foreground:oklch(1 0 0);'+
						'--sidebar-border:'+v(0.92,C*0.05)+';--sidebar-ring:oklch('+L+' '+C+' '+h+');}';
					var dk='.dark[data-theme="custom"]{'+
						'--background:'+v(0.18,C*0.07)+';--foreground:'+v(0.92,C*0.04)+';'+
						'--card:'+v(0.24,C*0.08)+';--card-foreground:'+v(0.92,C*0.04)+';'+
						'--popover:'+v(0.24,C*0.08)+';--popover-foreground:'+v(0.92,C*0.04)+';'+
						'--primary:oklch('+dL.toFixed(3)+' '+dC.toFixed(4)+' '+h+');--primary-foreground:oklch(1 0 0);'+
						'--secondary:'+v(0.34,C*0.09)+';--secondary-foreground:'+v(0.92,C*0.04)+';'+
						'--muted:'+v(0.26,C*0.07)+';--muted-foreground:'+v(0.70,C*0.07)+';'+
						'--accent:'+v(0.35,C*0.16)+';--accent-foreground:'+v(0.98,C*0.02)+';'+
						'--destructive:oklch(0.637 0.208 25.3);--destructive-foreground:oklch(0.98 0 0);'+
						'--border:'+v(0.30,C*0.07)+';--input:'+v(0.34,C*0.09)+';'+
						'--ring:oklch('+dL.toFixed(3)+' '+dC.toFixed(4)+' '+h+');'+
						'--sidebar:'+v(0.16,C*0.06)+';--sidebar-foreground:'+v(0.70,C*0.07)+';'+
						'--sidebar-primary:oklch('+dL.toFixed(3)+' '+dC.toFixed(4)+' '+h+');--sidebar-primary-foreground:oklch(1 0 0);'+
						'--sidebar-accent:oklch('+dL.toFixed(3)+' '+dC.toFixed(4)+' '+h+');--sidebar-accent-foreground:oklch(1 0 0);'+
						'--sidebar-border:'+v(0.30,C*0.07)+';--sidebar-ring:oklch('+dL.toFixed(3)+' '+dC.toFixed(4)+' '+h+');}';
					var s=document.createElement('style');
					s.id='custom-theme-css';
					s.textContent=lt+dk;
					document.head.appendChild(s);
				},
				// Cancel any in-flight theme preload to prevent race conditions
				// from rapid theme switching (leaked links, duplicate ids).
				_cancelPendingSwitch() {
					var pending = document.head.querySelectorAll('link[data-theme-pending]');
					for (var i = 0; i < pending.length; i++) pending[i].remove();
				},
				// Load a theme CSS file into the CSSOM, then flip data-theme
				// atomically so the old theme → new theme transition has no gap.
				// The old #theme-css link stays in place (keeping the current theme
				// visible) until the new CSS is fully loaded.
				_switchTheme(href, dataTheme) {
					var themeLink = document.getElementById('theme-css');
					// Create a new link with a marker attribute so _cancelPendingSwitch
					// can find it. Its [data-theme] scoped rules won't match yet.
					var newLink = document.createElement('link');
					newLink.rel = 'stylesheet';
					newLink.href = href;
					newLink.setAttribute('data-theme-pending', dataTheme);
					var finish = function() {
						// If this link was cancelled while loading, bail out.
						if (!newLink.hasAttribute('data-theme-pending')) return;
						newLink.removeAttribute('data-theme-pending');
						// Atomic swap: set data-theme so new rules match, then
						// update #theme-css href to keep a single link element.
						document.documentElement.setAttribute('data-theme', dataTheme);
						if (themeLink) themeLink.href = href;
						// Remove the preload link (its job is done; #theme-css
						// now points to the same href and serves the rules).
						newLink.remove();
					};
					newLink.onload = finish;
					newLink.onerror = finish;
					document.head.appendChild(newLink);
				},
			};
		}

		function _applyScheme(scheme) {
			var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			var dark = scheme === 'dark' || (scheme === 'system' && prefersDark);
			document.documentElement.classList.toggle('dark', dark);
		}

		(function() {
			_applyScheme(localStorage.getItem('rui:theme') || 'system');
		})();
	</script>
}

templ dateFormatOption(value, example string) {
	<label
		class="flex items-center gap-2 cursor-pointer rounded-lg border px-3 py-2 text-sm"
		:class={ "{'border-primary bg-primary/5': dateFormat === '" + value + "', 'border-input': dateFormat !== '" + value + "'}" }
	>
		<input type="radio" name="date-format" value={ value } x-model="dateFormat" @change="save()" class="sr-only"/>
		{ example }
	</label>
}

templ schemeCard(value, label, iconSVG string) {
	<button
		type="button"
		class="rounded-lg border p-4 w-28 text-center text-sm transition-colors hover:border-primary cursor-pointer"
		:class={ "{'border-primary bg-primary/5 font-medium': scheme === '" + value + "', 'border-input': scheme !== '" + value + "'}" }
		@click={ "select('" + value + "')" }
	>
		@templ.Raw(iconSVG)
		{ label }
	</button>
}

templ themeCard(value, label, primaryColor string) {
	<button
		type="button"
		class="rounded-lg border p-3 w-28 text-center text-xs transition-colors hover:border-primary cursor-pointer"
		:class={ "{'border-primary bg-primary/5 font-medium': colorTheme === '" + value + "', 'border-input': colorTheme !== '" + value + "'}" }
		@click={ "selectColor('" + value + "')" }
	>
		<span class="block w-8 h-8 rounded-full mx-auto mb-2 ring-1 ring-border" style={ "background-color: " + primaryColor + ";" }></span>
		{ label }
	</button>
}

templ cotyCard(value, label, year, primaryColor string) {
	<button
		type="button"
		class="rounded-lg border p-3 w-32 text-center text-xs transition-colors hover:border-primary cursor-pointer"
		:class={ "{'border-primary bg-primary/5 font-medium': colorTheme === '" + value + "', 'border-input': colorTheme !== '" + value + "'}" }
		@click={ "selectColor('" + value + "')" }
	>
		<span class="block w-8 h-8 rounded-full mx-auto mb-2 ring-1 ring-border" style={ "background-color: " + primaryColor + ";" }></span>
		<span class="block font-medium">{ label }</span>
		<span class="block text-muted-foreground mt-0.5">{ year }</span>
	</button>
}

// ──────────────────────────────────────────────────────────────────
// Logs section
// ──────────────────────────────────────────────────────────────────

// LogsProps carries log state into the section.
type LogsProps struct {
	Settings *config.LogSettingsResponse
}

// SettingsLogsSection renders the log settings + live stream section.
templ SettingsLogsSection(p SettingsProps) {
	@settingsLogsContent(p)
}

templ settingsLogsContent(p SettingsProps) {
	<div class="space-y-6">
		@card.Card(card.Props{}) {
			@card.Header(card.HeaderProps{}) {
				@card.Title(card.TitleProps{}) {
					Log Settings
				}
				@card.Description(card.DescriptionProps{}) {
					Configure log level and file rotation. Changes take effect immediately.
				}
			}
			@card.Content(card.ContentProps{}) {
				<div id="log-settings-result" class="mb-4"></div>
				<form
					hx-post={ p.BaseURL + "/ui/partials/settings/logs" }
					hx-target="#log-settings-result"
					hx-swap="innerHTML"
					class="space-y-4"
				>
					<div class="grid gap-4 sm:grid-cols-2">
						<div class="space-y-1.5">
							<label class="text-sm font-medium" for="log-level">Log Level</label>
							<select id="log-level" name="level"
								class="flex h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring">
								for _, lvl := range []string{"trace", "debug", "info", "warn", "error"} {
									<option value={ lvl }>{ lvl }</option>
								}
							</select>
						</div>
						<div class="space-y-1.5">
							<label class="text-sm font-medium" for="log-max-size">Max File Size (MB)</label>
							<input id="log-max-size" name="max_size" type="number" min="1"
								class="flex h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
								placeholder="50"/>
						</div>
					</div>
					<div class="grid gap-4 sm:grid-cols-2">
						<div class="space-y-1.5">
							<label class="text-sm font-medium" for="log-max-backups">Max Backups</label>
							<input id="log-max-backups" name="max_backups" type="number" min="0"
								class="flex h-9 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
								placeholder="3"/>
						</div>
						<div class="space-y-1.5">
							<label class="text-sm font-medium" for="log-path">Log File Path (optional)</label>
							<input id="log-path" name="path" type="text"
								class="flex h-9 w-full rounded-md border border-input bg-background px-3 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-ring"
								placeholder="/var/log/rui/rui.log"/>
						</div>
					</div>
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Save Log Settings
					}
				</form>
			}
		}
		@card.Card(card.Props{}) {
			@card.Header(card.HeaderProps{}) {
				<div class="flex items-center justify-between">
					@card.Title(card.TitleProps{}) {
						Live Log Stream
					}
					<button
						type="button"
						id="log-stream-toggle"
						class="inline-flex items-center gap-1.5 rounded-md bg-primary px-3 py-1.5 text-xs font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
						onclick="toggleLogStream(this)"
					>
						<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
						Start Stream
					</button>
				</div>
			}
			@card.Content(card.ContentProps{}) {
				<div
					id="log-stream-container"
					data-stream-url={ p.BaseURL + "/ui/partials/settings/logs/stream" }
					class="rounded-md bg-black/90 text-green-400 font-mono text-xs p-4 h-96 overflow-y-auto space-y-0.5 hidden"
					role="log"
					aria-live="polite"
					aria-label="Live log stream"
				>
					<p class="text-muted-foreground">Connecting to log stream...</p>
				</div>
			}
		}
	</div>
	<script>
		(function() {
			let es = null;

			window.toggleLogStream = function(btn) {
				const container = document.getElementById('log-stream-container');
				if (es) {
					es.close();
					es = null;
					btn.innerHTML = '<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg> Start Stream';
					container.classList.add('hidden');
					return;
				}

				container.classList.remove('hidden');
				container.innerHTML = '<p class="text-muted-foreground">Connecting...</p>';
				btn.innerHTML = '<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg> Stop Stream';

				const streamURL = container.dataset.streamUrl;
				es = new EventSource(streamURL);
				es.onopen = function() {
					container.innerHTML = '';
				};
				es.onmessage = function(e) {
					const line = document.createElement('p');
					line.textContent = e.data;
					container.appendChild(line);
					container.scrollTop = container.scrollHeight;
					while (container.children.length > 2000) {
						container.removeChild(container.firstChild);
					}
				};
				es.onerror = function() {
					const line = document.createElement('p');
					line.className = 'text-red-400';
					line.textContent = '[stream error — reconnecting…]';
					container.appendChild(line);
				};
			};
		})();
	</script>
}

// LogSettingsResultPartial is returned after saving log settings.
templ LogSettingsResultPartial(ok bool, msg string) {
	if ok {
		<p class="text-sm text-green-700 dark:text-green-400">{ msg }</p>
	} else {
		<p class="text-sm text-destructive">{ msg }</p>
	}
}

package pages

import (
	"github.com/autogrr/rui/internal/ui/components/badge"
	"github.com/autogrr/rui/internal/ui/components/card"
	"github.com/autogrr/rui/internal/ui/components/skeleton"
	"github.com/autogrr/rui/internal/ui/layouts"
)

// DashboardInstance represents a single qBittorrent instance for display.
type DashboardInstance struct {
	ID          int
	Name        string
	Host        string
	IsActive    bool
	IsConnected bool

	// Transfer speeds (bytes/s)
	DlSpeed uint64
	UpSpeed uint64

	// Space
	FreeSpaceBytes int64

	// Torrent counts
	Downloading int
	Seeding     int
	Completed   int
	Paused      int
	Errored     int
	TrackerDown int
	Total       int

	// Speed limit state
	UseAltSpeedLimits bool

	// All-time transfer totals (bytes)
	AlltimeDl int64
	AlltimeUl int64
}

// DashboardProps holds all data for the dashboard page.
type DashboardProps struct {
	BaseURL   string
	Username  string
	Version   string
	Instances []DashboardInstance

	// ActiveInstanceID is which instance the sidebar is showing.
	ActiveInstanceID int
}

// Dashboard renders the main dashboard page.
templ Dashboard(p DashboardProps) {
	@layouts.Authenticated(layouts.AuthProps{
		BaseURL:         p.BaseURL,
		Title:           "Dashboard",
		CurrentPath:     "/ui/dashboard",
		Username:        p.Username,
		AppVersion:      p.Version,
		ActiveInstance:  dashboardActiveInstance(p),
		Instances:       dashboardNavInstances(p),
	}) {
		<div class="space-y-6">
			<!-- Page heading -->
			<div class="flex items-center justify-between">
				<h1 class="text-2xl font-bold tracking-tight">Dashboard</h1>
			</div>

			if len(p.Instances) == 0 {
				<!-- No instances -->
				@card.Card(card.Props{Class: "text-center py-12"}) {
					@card.Content(card.ContentProps{}) {
						<div class="mx-auto flex max-w-sm flex-col items-center gap-4">
							<svg class="h-12 w-12 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
								<rect x="2" y="3" width="20" height="14" rx="2"/>
								<path d="M8 21h8M12 17v4"/>
							</svg>
							<div>
								<p class="font-semibold">No instances configured</p>
								<p class="text-sm text-muted-foreground mt-1">Add a qBittorrent instance to get started.</p>
							</div>
							<a
								href={ templ.SafeURL(p.BaseURL + "/ui/instances") }
								class="inline-flex items-center gap-1.5 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90"
							>
								Add instance
							</a>
						</div>
					}
				}
			} else {
				<!-- SSE wrapper: pushes dashboard-update events; falls back to polling -->
				<div
					hx-ext="sse"
					sse-connect={ p.BaseURL + "/ui/sse/dashboard" }
				>
					<div
						id="dashboard-stats"
						hx-get={ p.BaseURL + "/ui/partials/dashboard" }
						hx-trigger="load, sse:dashboard-update, every 5s"
						hx-swap="innerHTML"
						class="space-y-4"
					>
						<!-- Skeletons shown until first HTMX response -->
						@DashboardGlobalSkeleton()
						<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
							@DashboardSkeleton()
						</div>
					</div>
					<!-- Tracker breakdown — SSE-driven with 60 s polling fallback -->
					<div
						id="tracker-breakdown"
						hx-get={ p.BaseURL + "/ui/partials/dashboard/tracker-breakdown" }
						hx-trigger="load, sse:dashboard-update, every 15s"
						hx-swap="innerHTML"
						class="mt-6"
					>
						@DashboardTrackerBreakdownSkeleton()
					</div>
				</div>
			}
		</div>
	}
}

// DashboardStatsPartial renders the global summary bar + instance cards for HTMX partial updates.
templ DashboardStatsPartial(instances []DashboardInstance, baseURL string) {
	@dashboardGlobalStats(instances, baseURL)
	<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
		for _, inst := range instances {
			@instanceCard(inst, baseURL)
		}
	</div>
}

// dashboardGlobalStats renders the aggregate stats row across all connected instances.
templ dashboardGlobalStats(instances []DashboardInstance, baseURL string) {
	{{ gs := globalStats(instances) }}
	if gs.Total > 0 {
		@card.Card(card.Props{Class: "bg-muted/40"}) {
			@card.Content(card.ContentProps{Class: "py-4"}) {
				<div class="flex flex-wrap items-center gap-x-8 gap-y-3">
					<!-- Instances online/total -->
					<div class="flex items-center gap-2">
						<span class="text-sm text-muted-foreground">Instances</span>
						<span class="text-sm font-semibold tabular-nums">{ itoa(gs.Connected) }/{ itoa(gs.Total) }</span>
					</div>
					<!-- Global download speed -->
					<div class="flex items-center gap-2">
						<svg class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="8 17 12 21 16 17"/><line x1="12" x2="12" y1="3" y2="21"/></svg>
						<span class="text-sm font-semibold tabular-nums">{ formatBytesPerSec(gs.DlSpeed) }</span>
					</div>
					<!-- Global upload speed -->
					<div class="flex items-center gap-2">
						<svg class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="8 7 12 3 16 7"/><line x1="12" x2="12" y1="21" y2="3"/></svg>
						<span class="text-sm font-semibold tabular-nums">{ formatBytesPerSec(gs.UpSpeed) }</span>
					</div>
					<!-- Torrent counts -->
					<div class="flex items-center gap-3 text-sm">
						<span class="text-muted-foreground">Downloading</span>
						<span class="font-semibold tabular-nums">{ itoa(gs.Downloading) }</span>
						<span class="text-muted-foreground">Seeding</span>
						<span class="font-semibold tabular-nums">{ itoa(gs.Seeding) }</span>
						<span class="text-muted-foreground">Total</span>
						<span class="font-semibold tabular-nums">{ itoa(gs.Total_t) }</span>
					</div>
					<!-- All-time stats if available -->
					if gs.AlltimeDl > 0 || gs.AlltimeUl > 0 {
						<div class="flex items-center gap-3 text-sm border-l pl-4">
							<span class="text-muted-foreground text-xs">All-time ↓</span>
							<span class="tabular-nums text-xs font-medium">{ formatBytes(uint64(gs.AlltimeDl)) }</span>
							<span class="text-muted-foreground text-xs">All-time ↑</span>
							<span class="tabular-nums text-xs font-medium">{ formatBytes(uint64(gs.AlltimeUl)) }</span>
						</div>
					}
				</div>
			}
		}
	}
}

// globalStatsSummary holds aggregated values across all instances.
type globalStatsSummary struct {
	Connected   int
	Total       int
	DlSpeed     uint64
	UpSpeed     uint64
	Downloading int
	Seeding     int
	Total_t     int
	AlltimeDl   int64
	AlltimeUl   int64
}

// globalStats computes aggregate stats across all connected instances.
func globalStats(instances []DashboardInstance) globalStatsSummary {
	var gs globalStatsSummary
	gs.Total = len(instances)
	for _, inst := range instances {
		if inst.IsConnected {
			gs.Connected++
			gs.DlSpeed += inst.DlSpeed
			gs.UpSpeed += inst.UpSpeed
			gs.Downloading += inst.Downloading
			gs.Seeding += inst.Seeding
			gs.Total_t += inst.Total
			gs.AlltimeDl += inst.AlltimeDl
			gs.AlltimeUl += inst.AlltimeUl
		}
	}
	return gs
}



// dashboardActiveInstance picks the active instance for the layout nav.
func dashboardActiveInstance(p DashboardProps) *layouts.Instance {
	for _, inst := range p.Instances {
		if inst.ID == p.ActiveInstanceID {
			return &layouts.Instance{
				ID:       inst.ID,
				Name:     inst.Name,
				IsActive: inst.IsActive,
			}
		}
	}
	return nil
}

// dashboardNavInstances converts DashboardInstance slice to layouts.Instance.
func dashboardNavInstances(p DashboardProps) []layouts.Instance {
	out := make([]layouts.Instance, len(p.Instances))
	for i, inst := range p.Instances {
		out[i] = layouts.Instance{
			ID:       inst.ID,
			Name:     inst.Name,
			IsActive: inst.IsActive,
		}
	}
	return out
}

// instanceCard renders a single qBittorrent instance summary card.
// The entire card is a navigation target for the torrent list; the alt-speed
// toggle button stops click propagation so it doesn't also trigger navigation.
templ instanceCard(inst DashboardInstance, baseURL string) {
	@card.Card(card.Props{
		Class: "overflow-hidden cursor-pointer transition-shadow hover:shadow-md hover:border-primary/40",
		Attributes: templ.Attributes{
			"onclick": "window.location='" + baseURL + "/ui/torrents?instance_id=" + itoa(inst.ID) + "'",
			"role":    "link",
		},
	}) {
		@card.Header(card.HeaderProps{Class: "pb-3"}) {
			<div class="flex items-center justify-between gap-2">
				@card.Title(card.TitleProps{Class: "text-base font-semibold truncate"}) {
					{ inst.Name }
				}
				<div class="flex items-center gap-1.5 shrink-0">
					if inst.IsConnected {
						@badge.Badge(badge.Props{Variant: badge.VariantDefault}) {
							Online
						}
					} else {
						@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
							Offline
						}
					}
					if inst.IsConnected {
						<!-- Alt speed toggle: stopPropagation prevents the card onclick from firing -->
						<button
							onclick="event.stopPropagation()"
							hx-post={ baseURL + "/ui/partials/dashboard/" + itoa(inst.ID) + "/alt-speed" }
							hx-target="#dashboard-stats"
							hx-swap="innerHTML"
							title={ altSpeedTitle(inst.UseAltSpeedLimits) }
							class={
								"inline-flex items-center justify-center rounded-md p-1 text-xs transition-colors focus:outline-none focus:ring-2 focus:ring-ring",
								templ.KV("bg-yellow-500/15 text-yellow-700 dark:text-yellow-400 hover:bg-yellow-500/25", inst.UseAltSpeedLimits),
								templ.KV("bg-muted text-muted-foreground hover:bg-accent hover:text-accent-foreground", !inst.UseAltSpeedLimits),
							}
						>
							<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
							</svg>
						</button>
					}
				</div>
			</div>
			@card.Description(card.DescriptionProps{Class: "text-xs truncate"}) {
				{ inst.Host }
			}
		}
		@card.Content(card.ContentProps{}) {
			if !inst.IsConnected {
				<p class="text-sm text-muted-foreground">Unable to reach instance.</p>
			} else {
				<!-- Speed stats -->
				<div class="grid grid-cols-2 gap-4 mb-4">
					<div class="space-y-1">
						<p class="text-xs text-muted-foreground flex items-center gap-1">
							<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="8 17 12 21 16 17"/><line x1="12" x2="12" y1="3" y2="21"/></svg>
							Download
						</p>
						<p class="text-sm font-medium">{ formatBytesPerSec(inst.DlSpeed) }</p>
					</div>
					<div class="space-y-1">
						<p class="text-xs text-muted-foreground flex items-center gap-1">
							<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="8 7 12 3 16 7"/><line x1="12" x2="12" y1="21" y2="3"/></svg>
							Upload
						</p>
						<p class="text-sm font-medium">{ formatBytesPerSec(inst.UpSpeed) }</p>
					</div>
				</div>
				<!-- Torrent counts -->
				<div class={ "grid gap-2 text-center", templ.KV("grid-cols-4", inst.TrackerDown > 0), templ.KV("grid-cols-3", inst.TrackerDown == 0) }>
					<div class="rounded-lg bg-muted/50 px-2 py-1.5">
						<p class="text-xs text-muted-foreground">Downloading</p>
						<p class="text-lg font-semibold tabular-nums">{ itoa(inst.Downloading) }</p>
					</div>
					<div class="rounded-lg bg-muted/50 px-2 py-1.5">
						<p class="text-xs text-muted-foreground">Seeding</p>
						<p class="text-lg font-semibold tabular-nums">{ itoa(inst.Seeding) }</p>
					</div>
					<div class="rounded-lg bg-muted/50 px-2 py-1.5">
						<p class="text-xs text-muted-foreground">Total</p>
						<p class="text-lg font-semibold tabular-nums">{ itoa(inst.Total) }</p>
					</div>
					if inst.TrackerDown > 0 {
						<div class="rounded-lg bg-yellow-500/10 px-2 py-1.5">
							<p class="text-xs text-yellow-600 dark:text-yellow-400">Trk ↓</p>
							<p class="text-lg font-semibold tabular-nums text-yellow-600 dark:text-yellow-400">{ itoa(inst.TrackerDown) }</p>
						</div>
					}
				</div>
				<!-- All-time stats -->
				if inst.AlltimeDl > 0 || inst.AlltimeUl > 0 {
					<div class="mt-3 grid grid-cols-2 gap-2 border-t pt-3">
						<div class="text-xs text-muted-foreground space-y-0.5">
							<p class="font-medium text-foreground/70">All-time ↓</p>
							<p class="tabular-nums">{ formatBytes(uint64(inst.AlltimeDl)) }</p>
						</div>
						<div class="text-xs text-muted-foreground space-y-0.5">
							<p class="font-medium text-foreground/70">All-time ↑</p>
							<p class="tabular-nums">{ formatBytes(uint64(inst.AlltimeUl)) }</p>
						</div>
					</div>
				}
				if inst.FreeSpaceBytes > 0 {
					<div class="mt-3 text-xs text-muted-foreground">
						Free: { formatBytes(uint64(inst.FreeSpaceBytes)) }
					</div>
				}
			}
		}
	}
}

// altSpeedTitle returns the tooltip text for the alt-speed toggle button.
func altSpeedTitle(enabled bool) string {
	if enabled {
		return "Alt speed limits ON — click to disable"
	}
	return "Alt speed limits OFF — click to enable"
}

// DashboardSkeleton renders loading placeholders for the dashboard.
// It renders bare cards without an outer grid wrapper so callers can place it
// inside their own grid container.
templ DashboardSkeleton() {
	for range 3 {
		@card.Card(card.Props{}) {
			@card.Header(card.HeaderProps{}) {
				@skeleton.Skeleton(skeleton.Props{Class: "h-5 w-32"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-24 mt-1"})
			}
			@card.Content(card.ContentProps{}) {
				<div class="grid grid-cols-2 gap-4 mb-4">
					@skeleton.Skeleton(skeleton.Props{Class: "h-8 w-full"})
					@skeleton.Skeleton(skeleton.Props{Class: "h-8 w-full"})
				</div>
				<div class="grid grid-cols-3 gap-2">
					for range 3 {
						@skeleton.Skeleton(skeleton.Props{Class: "h-12 w-full"})
					}
				</div>
			}
		}
	}
}

// DashboardGlobalSkeleton renders a skeleton for the global aggregate stats bar.
templ DashboardGlobalSkeleton() {
	@card.Card(card.Props{Class: "bg-muted/40"}) {
		@card.Content(card.ContentProps{Class: "py-4"}) {
			<div class="flex flex-wrap items-center gap-x-8 gap-y-3">
				@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-24"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-20"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-20"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-48"})
			</div>
		}
	}
}
// TrackerBreakdownRow holds per-tracker aggregated statistics across all instances.
type TrackerBreakdownRow struct {
	DisplayName  string
	Domain       string
	TorrentCount int
	Seeding      int
	Downloading  int
	UpSpeed      uint64
	DlSpeed      uint64
	TotalSize    int64
}

// DashboardTrackerBreakdownSkeleton renders a loading placeholder for the tracker breakdown card.
templ DashboardTrackerBreakdownSkeleton() {
	@card.Card(card.Props{}) {
		@card.Header(card.HeaderProps{}) {
			@skeleton.Skeleton(skeleton.Props{Class: "h-5 w-40"})
			@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-64 mt-1"})
		}
		@card.Content(card.ContentProps{}) {
			<div class="space-y-2">
				for range 4 {
					@skeleton.Skeleton(skeleton.Props{Class: "h-8 w-full"})
				}
			</div>
		}
	}
}

// DashboardTrackerBreakdown renders per-tracker aggregated stats.
templ DashboardTrackerBreakdown(rows []TrackerBreakdownRow, baseURL string) {
	@card.Card(card.Props{}) {
		@card.Header(card.HeaderProps{}) {
			@card.Title(card.TitleProps{}) {
				Tracker Breakdown
			}
			@card.Description(card.DescriptionProps{}) {
				Torrent distribution across trackers
			}
		}
		@card.Content(card.ContentProps{}) {
			if len(rows) == 0 {
				<p class="text-sm text-muted-foreground text-center py-4">No tracker data available.</p>
			} else {
				<div class="overflow-x-auto">
					<table class="w-full text-sm">
						<thead>
							<tr class="border-b text-muted-foreground text-xs">
								<th class="pb-2 text-left font-medium">Tracker</th>
								<th class="pb-2 text-right font-medium">Total</th>
								<th class="pb-2 text-right font-medium">Seeding</th>
								<th class="pb-2 text-right font-medium">Downloading</th>
								<th class="pb-2 text-right font-medium">↑ Speed</th>
								<th class="pb-2 text-right font-medium">↓ Speed</th>
								<th class="pb-2 text-right font-medium">Size</th>
							</tr>
						</thead>
						<tbody>
							for _, row := range rows {
								<tr class="border-b last:border-0 hover:bg-muted/40 transition-colors">
									<td class="py-2 pr-4 font-medium">
										{ row.DisplayName }
										if row.DisplayName != row.Domain && row.Domain != "" {
											<span class="ml-1 text-xs text-muted-foreground">({ row.Domain })</span>
										}
									</td>
									<td class="py-2 text-right tabular-nums">{ itoa(row.TorrentCount) }</td>
									<td class="py-2 text-right tabular-nums text-emerald-600 dark:text-emerald-400">{ itoa(row.Seeding) }</td>
									<td class="py-2 text-right tabular-nums text-blue-600 dark:text-blue-400">{ itoa(row.Downloading) }</td>
									<td class="py-2 text-right tabular-nums">{ formatBytesPerSec(row.UpSpeed) }</td>
									<td class="py-2 text-right tabular-nums">{ formatBytesPerSec(row.DlSpeed) }</td>
									<td class="py-2 text-right tabular-nums">{ formatBytes(uint64(row.TotalSize)) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
	}
}